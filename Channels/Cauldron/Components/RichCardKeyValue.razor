@namespace Cauldron.Components
@inject IMarkdownRendererService MarkdownRenderer

@* Renders a key_value: one labelled field, optionally emphasized. *@

<div class="rich-card-key-value @(Component.Emphasize ? "rich-card-key-value-emphasized" : "")">
    <span class="rich-card-key">@MarkdownRenderer.ToInlineHtml(Component.Key):</span>
    <span class="rich-card-value">@MarkdownRenderer.ToInlineHtml(Component.Value)</span>
</div>

@code {
    [Parameter]
    public required KeyValueComponent Component { get; set; }
}