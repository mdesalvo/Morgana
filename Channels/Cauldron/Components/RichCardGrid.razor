@namespace Cauldron.Components

@* Renders a grid: key/value pairs laid out in a fixed number of columns. *@

<div class="rich-card-grid" style="grid-template-columns: repeat(@Component.Columns, 1fr);">
    @foreach (GridItem item in Component.Items)
    {
        <div class="rich-card-grid-item">
            <div class="rich-card-grid-key">@MarkdownRendererService.ToInlineHtml(item.Key)</div>
            <div class="rich-card-grid-value">@MarkdownRendererService.ToInlineHtml(item.Value)</div>
        </div>
    }
</div>

@code {
    [Parameter]
    public required GridComponent Component { get; set; }
}
