@namespace Cauldron.Components
@inject IMarkdownRendererService MarkdownRenderer

@* Renders a rich card: header, then each component in declared order. *@

<div class="rich-card">
    @* Card header *@
    <div class="rich-card-header">
        <h3 class="rich-card-title">@MarkdownRenderer.ToInlineHtml(Card!.Title)</h3>
        @if (!string.IsNullOrWhiteSpace(Card.Subtitle))
        {
            <p class="rich-card-subtitle">@MarkdownRenderer.ToInlineHtml(Card.Subtitle)</p>
        }
    </div>

    @* Card body with components *@
    <div class="rich-card-body">
        @foreach (CardComponent component in Card.Components)
        {
            <RichCardComponent Component="@component" Depth="1" />
        }
    </div>
</div>

@code {
    /// <summary>
    /// The rich card data to render. Leaf components render inline Markdown in their text
    /// fields via <see cref="IMarkdownRendererService.ToInlineHtml"/>, so the card is passed
    /// through untouched — no pre-sanitization step that would strip that Markdown away.
    /// </summary>
    [Parameter]
    public Morgana.Contracts.RichCard? Card { get; set; }

    /// <summary>
    /// The card currently on screen. A card is an immutable contract, so the same instance means
    /// the same content and every field can skip its Markdown and sanitizer pass.
    /// </summary>
    private Morgana.Contracts.RichCard? displayedCard;

    protected override void OnAfterRender(bool firstRender)
    {
        // The first paint skips the comparison, so its card is recorded once it is on screen
        if (firstRender)
            displayedCard = Card;
    }

    protected override bool ShouldRender()
    {
        if (ReferenceEquals(Card, displayedCard))
            return false;

        displayedCard = Card;
        return true;
    }
}