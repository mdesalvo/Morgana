@namespace Cauldron.Components

@* Confirmation modal. Purely presentational: both outcomes are reported to the parent,
   which decides what they mean. *@

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="HandleBackdropClick">
        @* Stops the click here, or every click inside the dialog would bubble up to the
           overlay and be read as "clicked outside". *@
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="magical-icon">✨</div>
                <h3>@Title</h3>
            </div>

            <div class="modal-body">
                <p>@Message</p>
            </div>

            <div class="modal-actions">
                <button class="modal-btn cancel" @onclick="OnCancel">
                    <span class="btn-icon">✕</span>
                    <span>@CancelText</span>
                </button>
                <button class="modal-btn confirm" @onclick="OnConfirm">
                    <span class="btn-icon">✓</span>
                    <span>@ConfirmText</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// True while the dialog is on screen.
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; }

    /// <summary>
    /// Heading of the dialog.
    /// </summary>
    [Parameter]
    public required string Title { get; set; }

    /// <summary>
    /// Question that the visitor is asked to confirm.
    /// </summary>
    [Parameter]
    public required string Message { get; set; }

    /// <summary>
    /// Label of the button that confirms.
    /// </summary>
    [Parameter]
    public required string ConfirmText { get; set; }

    /// <summary>
    /// Label of the button that cancels.
    /// </summary>
    [Parameter]
    public required string CancelText { get; set; }

    /// <summary>
    /// Raised when the visitor confirms.
    /// </summary>
    [Parameter]
    public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Raised when the visitor cancels or clicks outside the dialog.
    /// </summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Reports a click on the overlay as a cancellation.
    /// </summary>
    private async Task HandleBackdropClick()
    {
        // Clicking away is treated as cancelling, never as confirming: a destructive action
        // must not be triggered by a stray click on the overlay.
        await OnCancel.InvokeAsync();
    }
}
