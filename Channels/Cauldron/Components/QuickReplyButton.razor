@namespace Cauldron.Components

@*
    Quick reply buttons attached to an agent message.

    Presentational only: it owns no state, reports clicks upward and renders whatever selection
    the parent hands back. The parent is what actually sends the reply and disables the row.
*@
<div class="quick-replies @(IsDisabled ? "disabled" : "")">
    @if (Replies != null)
    {
        @foreach ((int position, QuickReply reply) in Replies.Index())
        {
            @* animation-delay is derived from the index, so the buttons cascade in rather
               than appearing all at once. *@
            <button class="quick-reply-btn @(reply.Termination == true ? "termination" : "") @(IsReplySelected(reply.Id) ? "selected" : "") @(IsDisabled ? "disabled" : "")"
                    style="animation-delay: @(position * 0.1)s"
                    disabled="@IsDisabled"
                    @onclick="() => OnReplyClick(reply)">
                <span class="label">@reply.Label</span>
                @if (IsReplySelected(reply.Id))
                {
                    @* Marks the chosen reply once the row is frozen, so the transcript still
                       shows what was picked. *@
                    <span class="checkmark">✓</span>
                }
            </button>
        }
    }
</div>

@code {
    /// <summary>
    /// Quick replies to show: the label is what the visitor reads and the value is what gets sent.
    /// </summary>
    [Parameter]
    public List<QuickReply>? Replies { get; set; }

    /// <summary>
    /// Raised with the reply that was clicked.
    /// </summary>
    [Parameter]
    public EventCallback<QuickReply> OnSelect { get; set; }

    /// <summary>
    /// True once the row is frozen: a reply was picked or the message is no longer the latest.
    /// </summary>
    [Parameter]
    public bool IsDisabled { get; set; }

    /// <summary>
    /// Id of the reply that was picked; null while none was.
    /// </summary>
    [Parameter]
    public string? SelectedReplyId { get; set; }

    /// <summary>
    /// True when the visitor already picked this reply, so its button shows the checkmark.
    /// </summary>
    private bool IsReplySelected(string replyId)
    {
        return SelectedReplyId == replyId;
    }

    /// <summary>
    /// Reports the clicked reply to the parent, which records the selection and sends the message.
    /// </summary>
    private async Task OnReplyClick(QuickReply reply)
    {
        // Re-checked despite the disabled attribute: the markup guard is client-side, this one
        // is what actually keeps a second reply from being reported on an already-answered row.
        if (IsDisabled)
            return;

        await OnSelect.InvokeAsync(reply);
    }
}
