@namespace Cauldron.Components
@inject IMarkdownRendererService MarkdownRenderer
@inject ITrustedImageDomainService TrustedImageDomains

@* Renders an image with optional caption. Lazy-loaded: cards may sit far up the history. An image outside the listed domains is not emitted and the caption stays. *@

<div class="rich-card-image rich-card-image-@Component.Size.ToString().ToLower()">
    @if (TrustedImageDomains.IsServedFromTrustedDomain(Component.Src))
    {
        <img src="@Component.Src"
             alt="@(Component.Alt ?? "Image")"
             class="rich-card-image-content"
             loading="lazy" />
    }

    @if (!string.IsNullOrEmpty(Component.Caption))
    {
        <p class="rich-card-image-caption">@MarkdownRenderer.ToInlineHtml(Component.Caption)</p>
    }
</div>

@code {
    /// <summary>The image component to render.</summary>
    [Parameter]
    public required ImageComponent Component { get; set; }
}