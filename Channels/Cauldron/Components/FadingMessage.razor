@implements IDisposable

@*
    FadingMessage - system warning / error banner.

    Transient notices (rate limit, generic warnings) fade out and dismiss themselves after
    DurationSeconds. Terminal notices (dust budget exhausted) never dismiss and carry their own
    styling: the conversation is over, so "wait and retry" would be the wrong thing to imply.
*@

@if (isVisible)
{
    <div class="temporary-message-banner @(isFading ? "fading" : "") @GetBannerClass()">
        <span class="banner-icon">
            @GetIcon()
        </span>
        <span class="banner-text">@Message.Text</span>
    </div>
}

@code {
    /// <summary>
    /// The channel message to display in the banner.
    /// </summary>
    [Parameter]
    public ChannelMessage Message { get; set; } = null!;

    /// <summary>
    /// Callback invoked when the message is auto-dismissed after duration expires.
    /// Parent component should remove message from its list.
    /// Passes the dismissed message as parameter.
    /// </summary>
    [Parameter]
    public EventCallback<ChannelMessage> OnDismissed { get; set; }

    /// <summary>
    /// Total duration in seconds before auto-dismiss.
    /// Default: 10 seconds (8s visible + 2s fade-out).
    /// </summary>
    [Parameter]
    public int DurationSeconds { get; set; } = 10;

    /// <summary>
    /// Controls banner visibility (for smooth mount/unmount).
    /// </summary>
    private bool isVisible = true;

    /// <summary>
    /// Tracks if banner is in fading state (last 2 seconds before removal).
    /// </summary>
    private bool isFading = false;

    /// <summary>
    /// Cancellation token for cleanup on component disposal.
    /// </summary>
    private CancellationTokenSource? cancellationTokenSource;

    /// <summary>
    /// True for a notice that ends the conversation (dust budget spent). There is nothing to wait
    /// for, so it must persist: this drives both the no-auto-dismiss behaviour and the distinct
    /// styling that keeps it from reading as a transient warning.
    /// </summary>
    private bool IsTerminal =>
        string.Equals(Message.ErrorReason, "dust_budget_exhausted", StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        // Transient notices fade away; a terminal notice stays put until the user acts.
        if (!IsTerminal)
            StartAutoDismissTimer();
    }

    /// <summary>
    /// Starts the auto-dismiss timer with fade-out animation.
    /// Timeline: (duration-2)s visible → 2s fading → dismiss
    /// </summary>
    private void StartAutoDismissTimer()
    {
        // Cancelled on disposal, so a banner removed early does not keep a timer running
        cancellationTokenSource = new CancellationTokenSource();

        // The fade is the tail of the total duration, not an extra: a 10s banner sits still for 8s
        // and fades for 2. Floored at 1s so a very short DurationSeconds still shows something.
        int visibleDuration = Math.Max(1, DurationSeconds - 2) * 1000;
        const int fadeDuration = 2000;

        // Detached on purpose: the caller renders the banner now and must not await its lifetime
        _ = Task.Run(async () =>
        {
            try
            {
                // Phase 1: fully visible, no styling change
                await Task.Delay(visibleDuration, cancellationTokenSource.Token);

                // Phase 2: the "fading" class hands the fade-out over to CSS
                isFading = true;
                await InvokeAsync(StateHasChanged);

                await Task.Delay(fadeDuration, cancellationTokenSource.Token);

                // Phase 3: hide the markup once the animation has actually finished
                isVisible = false;
                await InvokeAsync(StateHasChanged);

                // Hand the message back so the parent drops it from its list: the component alone
                // cannot remove itself from a collection it does not own.
                await OnDismissed.InvokeAsync(Message);
            }
            catch (TaskCanceledException)
            {
                // Disposed mid-wait: nothing to clean up here, Dispose owns the token source
            }
        }, cancellationTokenSource.Token);
    }

    /// <summary>
    /// Gets the appropriate icon based on error reason.
    /// </summary>
    /// <returns>Emoji icon string</returns>
    private string GetIcon()
    {
        return Message.ErrorReason switch
        {
            "rate_limit_exceeded" => "✋",
            "dust_budget_exhausted" => "🪄",
            _ => "⚠️"
        };
    }

    /// <summary>
    /// Gets the CSS class for banner styling.
    /// </summary>
    /// <returns>"dust-exhausted" for the terminal notice, "error" for errors, empty for warnings.</returns>
    private string GetBannerClass()
    {
        // Checked first: the terminal notice gets a calm purple of its own, never the alarming
        // red of an error, which would misread as something the user could retry past.
        if (IsTerminal)
            return "dust-exhausted";

        return string.Equals(Message.MessageType, "error", StringComparison.OrdinalIgnoreCase) ? "error" : "";
    }

    /// <summary>
    /// Cancels the auto-dismiss timer when the banner is removed before it expires.
    /// </summary>
    public void Dispose()
    {
        // Cancelling first unblocks the detached task, which then exits through its
        // TaskCanceledException arm instead of firing OnDismissed on a dead component.
        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();
    }
}