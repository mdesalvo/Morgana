@implements IDisposable

@*
    FadingMessage - system warning / error banner.

    Transient notices (rate limit, generic warnings) fade out and dismiss themselves after
    DurationSeconds. Terminal notices (dust budget exhausted) never dismiss and carry their own
    styling: the conversation is over, so "wait and retry" would be the wrong thing to imply.
*@

@if (isVisible)
{
    <div class="temporary-message-banner @(isFading ? "fading" : "") @GetBannerClass()">
        <span class="banner-icon">
            @GetIcon()
        </span>
        <span class="banner-text">@Message.Text</span>
    </div>
}

@code {
    /// <summary>Seconds that a notice stays up when its message does not say.</summary>
    private const int DefaultDurationSeconds = 10;

    /// <summary>The channel message to display in the banner.</summary>
    [Parameter, EditorRequired]
    public required ChannelMessage Message { get; set; }

    /// <summary>
    /// Raised with the notice once it has faded away, so the parent drops it from its list.
    /// The component cannot remove itself from a collection it does not own.
    /// </summary>
    [Parameter]
    public EventCallback<ChannelMessage> OnDismissed { get; set; }

    /// <summary>
    /// The seconds a notice stays up in all, its last two fading out; null means the default of ten.
    /// </summary>
    [Parameter]
    public int? DurationSeconds { get; set; }

    /// <summary>Whether the banner is still drawn, false once its fade has finished.</summary>
    private bool isVisible = true;

    /// <summary>Whether the banner is in its last two seconds, fading out.</summary>
    private bool isFading;

    /// <summary>Stops the countdown of a banner removed before it expires.</summary>
    private CancellationTokenSource? cancellationTokenSource;

    /// <summary>
    /// True for a notice that ends the conversation, the dust budget being spent.
    /// There is nothing to wait for, so it must persist: this drives both the no-auto-dismiss behaviour and the distinct
    /// styling that keeps it from reading as a transient warning.
    /// </summary>
    private bool IsTerminal =>
        string.Equals(Message.ErrorReason, ChannelErrorReasons.DustBudgetExhausted, StringComparison.Ordinal);

    /// <summary>True for a notice that reports an error rather than a warning.</summary>
    private bool IsError =>
        string.Equals(Message.MessageType, ChannelMessageTypes.Error, StringComparison.OrdinalIgnoreCase);

    /// <summary>Starts the countdown of a transient notice.</summary>
    protected override void OnInitialized()
    {
        // Transient notices fade away; a terminal notice stays put until the user acts.
        if (IsTerminal)
            return;

        // Cancelled on disposal, so a banner removed early does not keep a timer running.
        cancellationTokenSource = new CancellationTokenSource();

        // Detached on purpose: the caller renders the banner now and must not await its lifetime.
        _ = DismissAfterDurationAsync(cancellationTokenSource.Token);
    }

    /// <summary>
    /// Keeps the banner visible, fades it out and hands it back to the parent.
    /// The banner sits still for all but the last two seconds of its duration, which the fade takes.
    /// </summary>
    private async Task DismissAfterDurationAsync(CancellationToken cancellationToken)
    {
        // The fade is the tail of the total duration, not an extra: a 10s banner sits still for 8s
        // and fades for 2. Floored at 1s so a very short DurationSeconds still shows something.
        int visibleDuration = Math.Max(1, (DurationSeconds ?? DefaultDurationSeconds) - 2) * 1000;
        const int fadeDuration = 2000;

        try
        {
            // Phase 1: fully visible, no styling change.
            await Task.Delay(visibleDuration, cancellationToken);

            // Phase 2: the "fading" class hands the fade-out over to CSS.
            isFading = true;
            await InvokeAsync(StateHasChanged);

            // The fade runs its course before anything else changes.
            await Task.Delay(fadeDuration, cancellationToken);

            // Phase 3: hide the markup once the animation has actually finished.
            isVisible = false;
            await InvokeAsync(StateHasChanged);

            // Hand the message back so the parent drops it from its list: the component alone
            // cannot remove itself from a collection it does not own. Dispatched through
            // InvokeAsync so the parent's repaint always runs on the circuit: an exception thrown
            // off it would die inside this detached task and the emptied container would never
            // leave the DOM.
            await InvokeAsync(() => OnDismissed.InvokeAsync(Message));
        }
        catch (TaskCanceledException)
        {
            // Disposed mid-wait: nothing to clean up here, Dispose owns the token source.
        }
    }

    /// <summary>Returns the icon of the notice's reason.</summary>
    private string GetIcon()
    {
        // A refusal for calling too often and a spent budget have icons of their own; any other notice wears the warning sign.
        return Message.ErrorReason switch
        {
            ChannelErrorReasons.RateLimitExceeded => "✋",
            ChannelErrorReasons.DustBudgetExhausted => "🪄",
            _ => "⚠️"
        };
    }

    /// <summary>Returns the CSS class that colours the banner after the kind of notice.</summary>
    private string GetBannerClass()
    {
        // The terminal notice is matched first: it gets a calm purple of its own, never the
        // alarming red of an error, which would misread as something the user could retry past.
        return (IsTerminal, IsError) switch
        {
            (true, _) => "dust-exhausted",
            (_, true) => "error",
            _ => ""
        };
    }

    /// <summary>Cancels the auto-dismiss timer when the banner is removed before it expires.</summary>
    public void Dispose()
    {
        // Cancelling first unblocks the delayed task, which then exits through its
        // TaskCanceledException arm instead of firing OnDismissed on a dead component.
        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();
    }
}