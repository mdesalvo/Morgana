@*
    The gauge of the conversation's magic-dust budget, in the chat header.

    A battery-style bar showing the budget that remains: it empties as the conversation burns tokens,
    shifting purple to amber to red. A null DustLevel means Morgana limits no dust and the gauge renders nothing.
*@

@if (DustLevel is { } remaining)
{
    @* Truncated toward zero, never rounded: a residual under 1% reads as 0%, the level at which the next turn is refused. *@
    int percent = (int)(Math.Clamp(remaining, 0.0, 1.0) * 100);
    // Thresholds drive colour only; the backend owns the real lockout boundary.
    string state = remaining > 0.30 ? "ok" : remaining > 0.10 ? "low" : "critical";

    <div class="dust-meter @state"
         role="meter"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@percent"
         aria-label="Magic dust remaining"
         title="Magic dust remaining: @percent%">
        <span class="dust-meter-spark" aria-hidden="true">✨</span>
        <div class="dust-meter-cell">
            <div class="dust-meter-fill" style="width: @percent%;"></div>
        </div>
        <span class="dust-meter-label">@percent%</span>
    </div>
}

@code {
    /// <summary>
    /// The remaining dust as a fraction of the budget, from 1.0 when full to 0.0 when empty, as Morgana reports it.
    /// Null when Morgana limits no dust, in which case the gauge renders nothing.
    /// </summary>
    [Parameter]
    public double? DustLevel { get; set; }
}