@namespace Cauldron.Components
@inject IMarkdownRendererService MarkdownRenderer

@* Renders a list as bulleted, numbered or plain, per the component's declared Style. *@

@switch (Component.Style)
{
    case ListStyle.Bullet:
    {
        <ul class="rich-card-list rich-card-list-bullet">
            @foreach (string item in Component.Items)
            {
                <li>@MarkdownRenderer.ToInlineHtml(item)</li>
            }
        </ul>
        break;
    }
    case ListStyle.Numbered:
    {
        <ol class="rich-card-list rich-card-list-numbered">
            @foreach (string item in Component.Items)
            {
                <li>@MarkdownRenderer.ToInlineHtml(item)</li>
            }
        </ol>
        break;
    }
    // Plain shares the default arm: an unrecognised style degrades to unadorned lines
    // rather than dropping the list from the card entirely.
    case ListStyle.Plain:
    default:
    {
        <div class="rich-card-list rich-card-list-plain">
            @foreach (string item in Component.Items)
            {
                <div class="rich-card-list-item">@MarkdownRenderer.ToInlineHtml(item)</div>
            }
        </div>
        break;
    }
}

@code {
    [Parameter]
    public required ListComponent Component { get; set; }
}