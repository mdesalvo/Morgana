@page "/"
@inject IChatStateService ChatStateService
@inject IConversationLifecycleService ConversationLifecycleService
@inject IStreamingService StreamingService
@inject SignalRService SignalRService
@inject ILandingMessageService LandingMessageService
@inject ITrustedImageDomainService TrustedImageDomains
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>Morgana - Magical AI Assistant</PageTitle>

<div class="chat-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="header-content">

            <div class="header-avatar-wrapper @(ChatStateService.IsSending ? "sending" : "") @ChatStateService.GetAgentClass(ChatStateService.CurrentAgentName)">
                <div class="magic-glow"></div>
                <div class="magic-ring"></div>
                <span class="sparkle s1"></span>
                <span class="sparkle s2"></span>
                <span class="sparkle s3"></span>
                <span class="sparkle s4"></span>
                <span class="sparkle s5"></span>
                <span class="sparkle s6"></span>
                <img src="images/morgana-animated.webp"
                     alt="Morgana"
                     class="header-avatar" />
            </div>

            <div class="header-info">
                <h1 class="@ChatStateService.GetAgentClass(ChatStateService.CurrentAgentName)">@ChatStateService.CurrentAgentName</h1>
                <span class="status @(ChatStateService.IsConnected ? "online" : "offline")"
                      role="status">
                    @(ChatStateService.IsConnected ? "Online" : "Offline")
                </span>
                <DustMeter DustLevel="ChatStateService.DustLevel" />
            </div>

            <button class="new-conversation-btn @(IsNewConversationButtonVisible ? "visible" : "hidden")"
                    @onclick="ShowConfirmModal"
                    aria-label="Start a new conversation"
                    title="Start a new conversation with Morgana">
                <span class="btn-icon" aria-hidden="true">✨</span>
                <span class="btn-text">New Conversation</span>
            </button>

        </div>
    </div>

    <!-- Messages Area -->
    <div class="messages-container" aria-live="polite" aria-relevant="additions">

        @* Single child of the scrolling container, which is column-reverse so the view stays
           pinned to the newest message. Everything inside here renders in normal order. *@
        <div class="messages-inner">

        @if (ChatStateService.TemporaryMessages.Any())
        {
            <div class="temporary-messages-container" aria-live="assertive" aria-relevant="additions">
                @foreach (ChannelMessage temporaryMessage in ChatStateService.TemporaryMessages)
                {
                    <FadingMessage @key="temporaryMessage"
                                   Message="@temporaryMessage"
                                   DurationSeconds="@temporaryMessage.FadingMessageDurationSeconds"
                                   OnDismissed="@HandleMessageDismissed"/>
                }
            </div>
        }

        @* Empty list is the loading state: it holds until the first backend message lands,
           whether that is the presentation on a new conversation or the rehydrated history
           on a resume. Also what gates the input, via IsAwaitingFirstBackendMessage. *@
        @if (ChatStateService.ChatMessages.Count == 0)
        {
            <div class="magical-loader">
                <div class="magic-sparkle-core">
                    <div class="glow-core"></div>
                    <div class="glow-ring ring-1"></div>
                    <div class="glow-ring ring-2"></div>
                    <div class="glow-ring ring-3"></div>
                </div>
                <div class="sparkles-container">
                    <div class="sparkle sp1"></div>
                    <div class="sparkle sp2"></div>
                    <div class="sparkle sp3"></div>
                    <div class="sparkle sp4"></div>
                    <div class="sparkle sp5"></div>
                    <div class="sparkle sp6"></div>
                    <div class="sparkle sp7"></div>
                    <div class="sparkle sp8"></div>
                    <div class="sparkle sp9"></div>
                    <div class="sparkle sp10"></div>
                    <div class="sparkle sp11"></div>
                    <div class="sparkle sp12"></div>
                </div>
                <p class="loading-text">@(landingMessage)</p>
            </div>
        }
        else
        {
            <!-- Message list -->
            @* Keyed by instance, so a row keeps its cached HTML when the typing placeholder is swapped out *@
            @foreach (ChatMessage chatMessage in ChatStateService.ChatMessages)
            {
                <ChatMessageView @key="chatMessage"
                                 Message="@chatMessage"
                                 OnQuickReplySelected="@((reply) => SelectQuickReplyAsync(reply, chatMessage))" />
            }
        }

        </div>
    </div>

    <!-- Input Area -->
    <div class="input-container">
        <textarea
            @bind="ChatStateService.ComposerText"
            @bind:event="oninput"
            @onkeyup="HandleKeyPressAsync"
            aria-label="Message input"
            placeholder="Consult @(ChatStateService.CurrentAgentName)..."
            rows="1"
            disabled="@IsTextareaDisabled"
            class="message-input @(ChatStateService.IsSpecializedAgent(ChatStateService.CurrentAgentName) ? "agent" : "morgana")"></textarea>
        <SendButton
            AgentClass="@ChatStateService.GetAgentClass(ChatStateService.CurrentAgentName)"
            IsSending="@ChatStateService.IsSending"
            IsDisabled="@IsSendButtonDisabled"
            OnClick="SendMessageAsync" />
    </div>
</div>

<!-- Confirmation Modal for New Conversation -->
<ConfirmModal IsVisible="@showConfirmModal"
              Title="Start New Conversation?"
              Message="This will start a new conversation with Morgana. Your chat history will be lost. Are you sure you want to continue?"
              ConfirmText="Yes, start new"
              CancelText="No, stay here"
              OnConfirm="@ConfirmNewConversationAsync"
              OnCancel="@HideConfirmModal" />

@code {
    // =========================================================================
    // LOCAL UI STATE (not shared across components)
    // =========================================================================

    /// <summary>The line shown under the loader until Morgana's first message arrives.</summary>
    private string landingMessage = string.Empty;

    /// <summary>Whether the dialog that confirms a new conversation is on screen.</summary>
    private bool showConfirmModal;

    /// <summary>
    /// The repaint subscribed to the typewriter, kept so the page can unsubscribe it when it goes.
    /// An unsubscription matches the very instance that was subscribed: a lambda written again would remove nothing.
    /// </summary>
    private Action? onStreamingStateChanged;

    /// <summary>The handler subscribed to the hub's connection state, kept so the page can unsubscribe it when it goes.</summary>
    private Action<bool>? onConnectionStateChanged;

    /// <summary>The handler subscribed to the reply deadline, kept so the page can unsubscribe it when it goes.</summary>
    private Action? onReplyDeadlineExpired;

    // =========================================================================
    // LIFECYCLE
    // =========================================================================

    /// <summary>Connects to Morgana's hub, subscribes the page to it and starts or resumes the visitor's conversation.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The loader's line, shown until Morgana's first message.
            landingMessage = LandingMessageService.GetLandingMessage();

            // Every typewriter tick repaints the page.
            onStreamingStateChanged = () => InvokeAsync(StateHasChanged);
            StreamingService.OnStateChanged += onStreamingStateChanged;

            // Completes only once Morgana's hub answers, retrying while it is down.
            await SignalRService.StartAsync();
            ChatStateService.IsConnected = SignalRService.IsConnected;

            // Morgana's messages, the chunks of a streamed reply and the connection's ups and downs reach the page from here.
            SignalRService.OnMessageReceived += HandleMessageReceivedAsync;
            SignalRService.OnStreamChunkReceived += HandleStreamChunkReceivedAsync;
            onConnectionStateChanged = (connected) =>
            {
                ChatStateService.IsConnected = connected;

                // Back online: a reply pushed while this client was out of its group is gone for
                // good unless it is asked for. Without it the composer would stay shut on a turn
                // that Morgana has in fact already answered.
                if (connected)
                    _ = InvokeAsync(DeliverMissedRepliesAsync);

                // The header shows Online or Offline.
                InvokeAsync(StateHasChanged);
            };
            SignalRService.OnConnectionStateChanged += onConnectionStateChanged;

            // The deadline expires on a timer thread: the turn is settled on the circuit, which alone
            // may touch what is on screen.
            onReplyDeadlineExpired = () => _ = InvokeAsync(SettleSilentTurnAsync);
            ConversationLifecycleService.OnReplyDeadlineExpired += onReplyDeadlineExpired;

            // Guards against re-running the whole bootstrap when the component re-initialises
            // on a circuit that already has its conversation.
            if (!ChatStateService.HasCheckedStorage)
            {
                // Set before the attempt, not after: a failure below must not cause a retry loop.
                ChatStateService.HasCheckedStorage = true;

                try
                {
                    // The conversation this browser left behind, if any.
                    string? savedConversationId = await ConversationLifecycleService.GetSavedConversationIdAsync();

                    // A saved id means a returning visitor. Resume falls back to a fresh
                    // conversation on its own if the id turns out to be stale.
                    if (!string.IsNullOrEmpty(savedConversationId))
                        await ConversationLifecycleService.ResumeConversationAsync(savedConversationId);
                    // A first visit starts a conversation of its own.
                    else
                        await ConversationLifecycleService.StartConversationAsync();

                    // The page may now accept the visitor's messages, the banners of a failed start cleared.
                    ChatStateService.IsInitialized = true;
                    ChatStateService.ClearErrorMessages();
                }
                catch (Exception ex)
                {
                    // A start or a resume that threw is shown as a banner.
                    ChatStateService.AddErrorBanner($"Initialization error: {ex.Message}", "initialization_failed", 20);
                }
                finally
                {
                    // The loader gives way to the conversation or to the banner.
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The circuit went away while Morgana was still unreachable: nobody is left to tell.
        }
        catch (Exception ex)
        {
            // A failure outside the conversation's start, such as the hub's own, is shown as a banner too.
            ChatStateService.AddErrorBanner($"Critical initialization error: {ex.Message}", "critical_initialization_failed", 30);
            await InvokeAsync(StateHasChanged);
        }
    }

    // =========================================================================
    // MESSAGE HANDLING
    // =========================================================================

    /// <summary>Sends the composer's words as a typed turn.</summary>
    private async Task SendMessageAsync()
    {
        // A typed turn presses no quick reply.
        await SendTurnAsync(null);
    }

    /// <summary>Sends the composer's words as a turn, pressing the quick reply of <paramref name="pressedOffering"/> when it is not null.</summary>
    private async Task SendTurnAsync(ChatMessage? pressedOffering)
    {
        // Nothing to send, a turn already in flight or no connection to carry it: the press does nothing.
        if (string.IsNullOrWhiteSpace(ChatStateService.ComposerText) || ChatStateService.IsSending || !ChatStateService.IsConnected)
            return;

        // Captured and cleared up front, so the box is empty the moment the user hits send
        // rather than after the round-trip completes.
        string messageText = ChatStateService.ComposerText.Trim();
        ChatStateService.ComposerText = string.Empty;

        // The screen takes the turn at once: the send flag, the visitor's own message echoed
        // and the typing indicator shown while the answer comes over SignalR.
        ChatStateService.BeginTurn(messageText, pressedOffering);
        StateHasChanged();

        // Only a failure needs a re-render here: the success path is repainted by the
        // SignalR handlers when the response actually arrives.
        if (!await ConversationLifecycleService.SendMessageAsync(messageText))
            await InvokeAsync(StateHasChanged);
    }

    /// <summary>Puts a message of Morgana's on screen: a banner for a notice, the close of a streamed reply or a whole new reply.</summary>
    private async Task HandleMessageReceivedAsync(ChannelMessage message)
    {
        // The whole handler runs on the circuit, so its changes to the message lists cannot interleave with a render
        // enumerating them: on the hub's own thread a concurrent render would tear the circuit down.
        await InvokeAsync(async () =>
        {
            try
            {
                // The gauge is refreshed before any early return: warnings, the lockout and ordinary replies all carry
                // the level, and the low moments are when the visitor wants to see it move. A message without one leaves it as it was.
                if (message.ConversationMetadata?.DustLevel is { } dustLevel)
                    ChatStateService.DustLevel = dustLevel;

                // Every message carries the wait Morgana allows, so the next turn waits as long as she does.
                if (message.ConversationMetadata?.ReplyTimeoutSeconds is { } replyTimeoutSeconds)
                    ChatStateService.ReplyTimeout = TimeSpan.FromSeconds(replyTimeoutSeconds);

                // A warning or an error is a notice: it shows as a banner, never in the transcript.
                if (string.Equals(message.MessageType, ChannelMessageTypes.SystemWarning, StringComparison.OrdinalIgnoreCase)
                    || string.Equals(message.MessageType, ChannelMessageTypes.Error, StringComparison.OrdinalIgnoreCase))
                {
                    // The lockout notice never fades, so further refused sends must not stack it again:
                    // one is enough. A transient notice such as the rate limit fades on its own.
                    bool isDustExhausted = string.Equals(
                        message.ErrorReason, ChannelErrorReasons.DustBudgetExhausted, StringComparison.Ordinal);
                    if (isDustExhausted
                        && ChatStateService.TemporaryMessages.Any(notice => string.Equals(
                            notice.ErrorReason, ChannelErrorReasons.DustBudgetExhausted, StringComparison.Ordinal)))
                        return;

                    // The banner goes up.
                    ChatStateService.TemporaryMessages.Add(message);
                    StateHasChanged();
                    return;
                }

                // Late arrival from a conversation this circuit has moved on from.
                if (ChatStateService.ConversationId != message.ConversationId)
                    return;

                // A reply this client already has, pushed and then read back from the history by a
                // catch-up that overlapped the push: it is on screen once.
                if (message.Timestamp <= ChatStateService.LatestDeliveredTimestamp)
                    return;

                // From here this reply is on screen, so a later catch-up starts past it.
                ChatStateService.NoteDelivered(message.Timestamp);

                // Every reply passes here exactly once, pushed or recovered, while its rendering repeats at each
                // typewriter tick: the images it carries from undeclared domains are counted here and nowhere else.
                TrustedImageDomains.ReportImagesFromUntrustedDomains(message);

                // PATH 1: this message closes a response already typing itself out on screen.
                if (StreamingService.IsStreaming)
                {
                    // The streamed text gives way to the final one, with its widgets, and the composer reopens.
                    StreamingService.FinalizeStreaming(message);
                    ChatStateService.UpdateAgentFromMessage(message);
                    ChatStateService.IsSending = false;
                    StateHasChanged();
                    return;
                }

                // PATH 2: the response arrived whole, with no chunks preceding it: it takes the typing indicator's place.
                ChatStateService.RemoveTypingIndicator();
                ChatStateService.UpdateAgentFromMessage(message);

                // The reply as the page draws it.
                ChatStateService.ChatMessages.Add(new ChatMessage
                {
                    ConversationId = message.ConversationId,
                    Text = message.Text,
                    Type = MessageType.Assistant,
                    Timestamp = message.Timestamp,
                    QuickReplies = message.QuickReplies,
                    AgentName = message.AgentName ?? Cauldron.Services.ChatStateService.BaseAgentName,
                    RichCard = message.RichCard
                });

                // The turn is answered, so the composer reopens.
                ChatStateService.IsSending = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // A message that cannot be drawn costs itself, never the circuit.
                Console.WriteLine($"Error in HandleMessageReceived: {ex.Message}");
            }
            await Task.CompletedTask;
        });
    }

    /// <summary>
    /// Puts on screen what Morgana pushed while this client could not receive it, returning whether anything was recovered.
    /// A recovered reply takes the path a push takes, so it looks and behaves exactly like one never missed.
    /// </summary>
    private async Task<bool> DeliverMissedRepliesAsync()
    {
        // The replies in Morgana's record past the latest one on screen.
        IReadOnlyList<ChannelMessage> missedReplies = await ConversationLifecycleService.GetMissedRepliesAsync();

        // Each goes on screen as its push would have.
        foreach (ChannelMessage missedReply in missedReplies)
            await HandleMessageReceivedAsync(missedReply);

        // A recovered reply has answered the turn.
        return missedReplies.Count > 0;
    }

    /// <summary>
    /// Settles a turn that has gone silent for the whole reply timeout.
    /// A reply Morgana wrote but could not push wins over the notice: the history is asked before the turn is given up on.
    /// </summary>
    private async Task SettleSilentTurnAsync()
    {
        // Text already received is still being revealed: Morgana has spoken and the screen is simply
        // catching up, so the turn is alive and keeps its place.
        if (StreamingService.IsRevealing)
        {
            ConversationLifecycleService.NoteReplyActivity();
            return;
        }

        // The turn was answered meanwhile.
        if (!ConversationLifecycleService.IsAwaitingReply)
            return;

        // A reply found in the history answers the turn.
        if (await DeliverMissedRepliesAsync())
            return;

        // A push may have answered the turn while the history was being read.
        if (!ConversationLifecycleService.IsAwaitingReply)
            return;

        // Nothing came: the turn is given up and the visitor told so.
        ConversationLifecycleService.AbandonTurn();
        StateHasChanged();
    }

    // =========================================================================
    // STREAMING HANDLERS
    // =========================================================================

    /// <summary>Hands a chunk of the reply to the typewriter, which opens the streaming message on the first one.</summary>
    private async Task HandleStreamChunkReceivedAsync(string chunkText)
    {
        // Marshal onto the circuit thread: the first chunk causes StreamingService.HandleChunkAsync
        // to mutate ChatStateService.ChatMessages (Add of the streaming placeholder and a
        // RemoveTypingIndicator), which must not interleave with the renderer's enumeration.
        await InvokeAsync(async () =>
        {
            try
            {
                // Morgana is answering, so the turn keeps its place however long the answer runs.
                ConversationLifecycleService.NoteReplyActivity();
                await StreamingService.HandleChunkAsync(chunkText);
            }
            catch (Exception ex)
            {
                // A chunk that cannot be queued costs itself: the final message still replaces the text.
                Console.WriteLine($"Error in HandleStreamChunkReceived: {ex.Message}");
            }
        });
    }

    // =========================================================================
    // UI INTERACTION HANDLERS
    // =========================================================================

    /// <summary>Sends the composer's words on Enter, leaving Shift+Enter to break the line.</summary>
    private async Task HandleKeyPressAsync(KeyboardEventArgs e)
    {
        // Enter alone sends.
        if (e is { Key: "Enter", ShiftKey: false })
            await SendMessageAsync();
    }

    /// <summary>Records the pressed quick reply on its message, freezing the row, and sends the reply's value as the turn.</summary>
    private async Task SelectQuickReplyAsync(QuickReply reply, ChatMessage message)
    {
        // A row already answered takes no second press.
        if (message.SelectedQuickReplyId != null)
            return;

        // Recorded on the message itself, which is what freezes the whole row and marks
        // the chosen button in the transcript.
        message.SelectedQuickReplyId = reply.Id;
        StateHasChanged();

        // Lets the selected state actually paint before the send redraws the conversation.
        await Task.Delay(250);

        // The reply's Value is what gets sent, not its Label: the button text is for the
        // user, the value is the phrasing Morgana expects back.
        ChatStateService.ComposerText = reply.Value;
        await SendTurnAsync(message);
    }

    /// <summary>Asks the visitor to confirm before the conversation is replaced by a new one.</summary>
    private void ShowConfirmModal()
    {
        // The dialog goes up over the chat.
        showConfirmModal = true;
        StateHasChanged();
    }

    /// <summary>Closes the dialog, keeping the conversation as it is.</summary>
    private void HideConfirmModal()
    {
        // The conversation carries on untouched.
        showConfirmModal = false;
        StateHasChanged();
    }

    /// <summary>Ends the conversation on Morgana's side, forgets it and reloads the page on a new one.</summary>
    private async Task ConfirmNewConversationAsync()
    {
        // Dismiss the modal before the teardown, so the user is not left staring at a dialog
        // while the round-trips to Morgana complete.
        showConfirmModal = false;
        StateHasChanged();

        // Morgana stops the conversation's actors. This comes before clearing the
        // storage: the id being ended is read from the state the next call is about to reset.
        await ConversationLifecycleService.EndConversationAsync();

        // Drop the saved id, so the reload below finds no conversation and starts a fresh one
        // instead of resuming the one just ended.
        await ConversationLifecycleService.ClearConversationAsync();

        // Full page reload rather than a Blazor navigation: it rebuilds the circuit from scratch,
        // which is the simplest way to get every scoped service back to its initial state.
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    /// <summary>Drops a banner that has faded away.</summary>
    private void HandleMessageDismissed(ChannelMessage message)
    {
        // The banner leaves the list and the page.
        ChatStateService.DismissTemporaryMessage(message);
        StateHasChanged();
    }

    // =========================================================================
    // UI STATE QUERIES
    // =========================================================================

    /// <summary>Whether the send button is shut: no connection, a turn in flight, nothing typed, buttons waiting or a spent budget.</summary>
    private bool IsSendButtonDisabled =>
        !ChatStateService.IsConnected ||
        ChatStateService.IsSending ||
        string.IsNullOrWhiteSpace(ChatStateService.ComposerText) ||
        !ChatStateService.IsInitialized ||
        ChatStateService.HasActiveQuickReplies() ||
        ChatStateService.HasTypingIndicator() ||
        IsAwaitingFirstBackendMessage ||
        ChatStateService.IsConversationDeadFromDust();

    /// <summary>
    /// Whether the New Conversation button shows: once a conversation is on screen, and always for one whose budget is spent.
    /// The lockout banner never fades, so a hidden button would strand the visitor.
    /// </summary>
    private bool IsNewConversationButtonVisible =>
        ChatStateService.HasCheckedStorage
        && !string.IsNullOrWhiteSpace(ChatStateService.ConversationId)
        && (ChatStateService.IsConversationDeadFromDust()
            || (ChatStateService.IsConnected
                && ChatStateService.IsInitialized
                && ChatStateService.ChatMessages.Count > 0));

    /// <summary>
    /// Whether the composer is shut, for the reasons the send button is and for a spent budget.
    /// A conversation out of dust leaves the visitor the lockout banner and the New Conversation button, nothing to type into.
    /// </summary>
    private bool IsTextareaDisabled =>
        !ChatStateService.IsConnected ||
        ChatStateService.IsSending ||
        !ChatStateService.IsInitialized ||
        ChatStateService.HasActiveQuickReplies() ||
        ChatStateService.HasTypingIndicator() ||
        IsAwaitingFirstBackendMessage ||
        ChatStateService.IsConversationDeadFromDust();

    /// <summary>
    /// Whether the loader still spins: Morgana's first message, the welcome or the resumed history, has not landed yet.
    /// A turn sent in this window would race the welcome, so the composer stays shut until Morgana has spoken once.
    /// </summary>
    private bool IsAwaitingFirstBackendMessage =>
        ChatStateService.ChatMessages.Count == 0;

    // =========================================================================
    // CLEANUP
    // =========================================================================

    /// <summary>Unsubscribes the page from the hub, the typewriter and the deadline, then stops the hub connection.</summary>
    public async ValueTask DisposeAsync()
    {
        // Each handler is removed by the instance that was subscribed.
        SignalRService.OnMessageReceived -= HandleMessageReceivedAsync;
        SignalRService.OnStreamChunkReceived -= HandleStreamChunkReceivedAsync;
        if (onConnectionStateChanged is not null)
            SignalRService.OnConnectionStateChanged -= onConnectionStateChanged;
        if (onStreamingStateChanged is not null)
            StreamingService.OnStateChanged -= onStreamingStateChanged;
        if (onReplyDeadlineExpired is not null)
            ConversationLifecycleService.OnReplyDeadlineExpired -= onReplyDeadlineExpired;

        // The typewriter and the connection go with the page.
        await StreamingService.DisposeAsync();
        await SignalRService.StopAsync();
    }
}