<Project>

  <!--
    Skipped inside Docker builds: each Dockerfile only stages its own subtree, so
    the sibling Directory.Build.props files this target reads aren't on disk.
    Each Dockerfile passes /p:InsideDockerBuild=true to dotnet build/publish.
  -->
  <Target Name="GenerateDockerVersionFile" BeforeTargets="Build" Condition="'$(InsideDockerBuild)' != 'true'">

    <PropertyGroup>
      <!-- Repository root is TWO levels up from this file
           (Channels/Rune/ → Channels/ → repo root) -->
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</RepoRoot>
      <EnvVersionsFile>$(RepoRoot)\.env.versions</EnvVersionsFile>

      <!-- Paths to Directory.Build.props files -->
      <MorganaPropsFile>$(RepoRoot)\Morgana\Directory.Build.props</MorganaPropsFile>
      <CauldronPropsFile>$(RepoRoot)\Channels\Cauldron\Directory.Build.props</CauldronPropsFile>
      <RunePropsFile>$(RepoRoot)\Channels\Rune\Directory.Build.props</RunePropsFile>
      <GrimoirePropsFile>$(RepoRoot)\Channels\Grimoire\Directory.Build.props</GrimoirePropsFile>
      <AlembicPropsFile>$(RepoRoot)\Alembic\Directory.Build.props</AlembicPropsFile>
    </PropertyGroup>

    <Message Text="════════════════════════════════════════════════════════════" Importance="high" />
    <Message Text="[Morgana Docker] Generating .env.versions file..." Importance="high" />
    <Message Text="════════════════════════════════════════════════════════════" Importance="high" />

    <!-- Read Morgana version: VersionPrefix, followed by -VersionSuffix when the props declare one -->
    <PropertyGroup>
      <MorganaProps Condition="Exists('$(MorganaPropsFile)')">$([System.IO.File]::ReadAllText('$(MorganaPropsFile)'))</MorganaProps>
      <MorganaVersion>$([System.Text.RegularExpressions.Regex]::Match('$(MorganaProps)', '(?&lt;=&lt;VersionPrefix&gt;)[^&lt;]+'))</MorganaVersion>
      <MorganaSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(MorganaProps)', '(?&lt;=&lt;VersionSuffix&gt;)[^&lt;]+'))</MorganaSuffix>
      <MorganaVersion Condition="'$(MorganaVersion)' != '' AND '$(MorganaSuffix)' != ''">$(MorganaVersion)-$(MorganaSuffix)</MorganaVersion>
    </PropertyGroup>

    <Message Text="[Morgana Docker] ✓ Morgana version:  $(MorganaVersion)" Importance="high" Condition="'$(MorganaVersion)' != ''" />
    <Warning Text="[Morgana Docker] Could not find $(MorganaPropsFile)" Condition="'$(MorganaVersion)' == ''" />

    <!-- Read Cauldron version: VersionPrefix, followed by -VersionSuffix when the props declare one -->
    <PropertyGroup>
      <CauldronProps Condition="Exists('$(CauldronPropsFile)')">$([System.IO.File]::ReadAllText('$(CauldronPropsFile)'))</CauldronProps>
      <CauldronVersion>$([System.Text.RegularExpressions.Regex]::Match('$(CauldronProps)', '(?&lt;=&lt;VersionPrefix&gt;)[^&lt;]+'))</CauldronVersion>
      <CauldronSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(CauldronProps)', '(?&lt;=&lt;VersionSuffix&gt;)[^&lt;]+'))</CauldronSuffix>
      <CauldronVersion Condition="'$(CauldronVersion)' != '' AND '$(CauldronSuffix)' != ''">$(CauldronVersion)-$(CauldronSuffix)</CauldronVersion>
    </PropertyGroup>

    <Message Text="[Morgana Docker] ✓ Cauldron version: $(CauldronVersion)" Importance="high" Condition="'$(CauldronVersion)' != ''" />
    <Warning Text="[Morgana Docker] Could not find $(CauldronPropsFile)" Condition="'$(CauldronVersion)' == ''" />

    <!-- Read Rune version: VersionPrefix, followed by -VersionSuffix when the props declare one -->
    <PropertyGroup>
      <RuneProps Condition="Exists('$(RunePropsFile)')">$([System.IO.File]::ReadAllText('$(RunePropsFile)'))</RuneProps>
      <RuneVersion>$([System.Text.RegularExpressions.Regex]::Match('$(RuneProps)', '(?&lt;=&lt;VersionPrefix&gt;)[^&lt;]+'))</RuneVersion>
      <RuneSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(RuneProps)', '(?&lt;=&lt;VersionSuffix&gt;)[^&lt;]+'))</RuneSuffix>
      <RuneVersion Condition="'$(RuneVersion)' != '' AND '$(RuneSuffix)' != ''">$(RuneVersion)-$(RuneSuffix)</RuneVersion>
    </PropertyGroup>

    <Message Text="[Morgana Docker] ✓ Rune version:     $(RuneVersion)" Importance="high" Condition="'$(RuneVersion)' != ''" />
    <Warning Text="[Morgana Docker] Could not find $(RunePropsFile)" Condition="'$(RuneVersion)' == ''" />

    <!-- Read Grimoire version: VersionPrefix, followed by -VersionSuffix when the props declare one -->
    <PropertyGroup>
      <GrimoireProps Condition="Exists('$(GrimoirePropsFile)')">$([System.IO.File]::ReadAllText('$(GrimoirePropsFile)'))</GrimoireProps>
      <GrimoireVersion>$([System.Text.RegularExpressions.Regex]::Match('$(GrimoireProps)', '(?&lt;=&lt;VersionPrefix&gt;)[^&lt;]+'))</GrimoireVersion>
      <GrimoireSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(GrimoireProps)', '(?&lt;=&lt;VersionSuffix&gt;)[^&lt;]+'))</GrimoireSuffix>
      <GrimoireVersion Condition="'$(GrimoireVersion)' != '' AND '$(GrimoireSuffix)' != ''">$(GrimoireVersion)-$(GrimoireSuffix)</GrimoireVersion>
    </PropertyGroup>

    <Message Text="[Morgana Docker] ✓ Grimoire version: $(GrimoireVersion)" Importance="high" Condition="'$(GrimoireVersion)' != ''" />
    <Warning Text="[Morgana Docker] Could not find $(GrimoirePropsFile)" Condition="'$(GrimoireVersion)' == ''" />

    <!-- Read Alembic version: VersionPrefix, followed by -VersionSuffix when the props declare one -->
    <PropertyGroup>
      <AlembicProps Condition="Exists('$(AlembicPropsFile)')">$([System.IO.File]::ReadAllText('$(AlembicPropsFile)'))</AlembicProps>
      <AlembicVersion>$([System.Text.RegularExpressions.Regex]::Match('$(AlembicProps)', '(?&lt;=&lt;VersionPrefix&gt;)[^&lt;]+'))</AlembicVersion>
      <AlembicSuffix>$([System.Text.RegularExpressions.Regex]::Match('$(AlembicProps)', '(?&lt;=&lt;VersionSuffix&gt;)[^&lt;]+'))</AlembicSuffix>
      <AlembicVersion Condition="'$(AlembicVersion)' != '' AND '$(AlembicSuffix)' != ''">$(AlembicVersion)-$(AlembicSuffix)</AlembicVersion>
    </PropertyGroup>

    <Message Text="[Morgana Docker] ✓ Alembic version:  $(AlembicVersion)" Importance="high" Condition="'$(AlembicVersion)' != ''" />
    <Warning Text="[Morgana Docker] Could not find $(AlembicPropsFile)" Condition="'$(AlembicVersion)' == ''" />

    <!-- Generate .env.versions content -->
    <PropertyGroup>
      <EnvVersionsContent>
<![CDATA[# Auto-generated by MSBuild from Directory.Build.props
# DO NOT EDIT MANUALLY - this file is regenerated on each build

MORGANA_VERSION=$(MorganaVersion)
CAULDRON_VERSION=$(CauldronVersion)
RUNE_VERSION=$(RuneVersion)
GRIMOIRE_VERSION=$(GrimoireVersion)
ALEMBIC_VERSION=$(AlembicVersion)
]]>
      </EnvVersionsContent>
    </PropertyGroup>

    <!-- Write to repository root -->
    <WriteLinesToFile
      File="$(EnvVersionsFile)"
      Lines="$(EnvVersionsContent)"
      Overwrite="true"
      Condition="'$(MorganaVersion)' != '' AND '$(CauldronVersion)' != '' AND '$(RuneVersion)' != '' AND '$(GrimoireVersion)' != '' AND '$(AlembicVersion)' != ''" />

    <Message Text="[Morgana Docker] ✅ Generated: $(EnvVersionsFile)" Importance="high" Condition="'$(MorganaVersion)' != '' AND '$(CauldronVersion)' != '' AND '$(RuneVersion)' != '' AND '$(GrimoireVersion)' != '' AND '$(AlembicVersion)' != ''" />
    <Message Text="════════════════════════════════════════════════════════════" Importance="high" />

  </Target>

</Project>
