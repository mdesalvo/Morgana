<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Morgana.AI</Title>
    <PackageId>Morgana.AI</PackageId>
    <OutputType>Library</OutputType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>bin\Debug\$(TargetFramework)\Morgana.AI.xml</DocumentationFile>
    <WarningLevel>4</WarningLevel>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>bin\Release\$(TargetFramework)\Morgana.AI.xml</DocumentationFile>
    <WarningLevel>0</WarningLevel>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="morgana.json" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Wire contracts shared with the reference channels (zero-dependency foundation) -->
  <ItemGroup>
    <ProjectReference Include="..\Morgana.Contracts\Morgana.Contracts.csproj" />
  </ItemGroup>

  <!-- Package References -->
  <ItemGroup>
    <!-- Actors -->
    <PackageReference Include="Akka" Version="1.5.*" />
    <PackageReference Include="Akka.DependencyInjection" Version="1.5.*" />
    <!-- Agents -->
    <PackageReference Include="A2A" Version="$(A2AVersion)" />
    <PackageReference Include="Microsoft.Agents.AI" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.A2A" Version="$(MicrosoftAgentsAIPreviewVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="$(MicrosoftAgentsAIPreviewVersion)" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsAIVersion)" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)" />
    <PackageReference Include="ModelContextProtocol.Core" Version="$(ModelContextProtocolVersion)" />
    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Api" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <!-- Services -->
    <PackageReference Include="Markdig" Version="1.5.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.*" />
  </ItemGroup>

</Project>