<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Title>Morgana.Web</Title>
    <PackageId>Morgana.Web</PackageId>
    <UserSecretsId>374228be-4f26-4382-a3ef-7500a0b829dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morgana.AI\Morgana.AI.csproj" />
    <!-- Built with the host and deployed by it into plugins/, never referenced as assemblies: the host knows only the providers it finds there -->
    <ProjectReference Include="..\Morgana.AI.LanguageModels\Anthropic\Morgana.AI.LanguageModels.Anthropic.csproj" ReferenceOutputAssembly="false" Private="false" LanguageModelPlugin="true" />
    <ProjectReference Include="..\Morgana.AI.LanguageModels\OpenAI\Morgana.AI.LanguageModels.OpenAI.csproj" ReferenceOutputAssembly="false" Private="false" LanguageModelPlugin="true" />
    <ProjectReference Include="..\Morgana.AI.LanguageModels\AzureOpenAI\Morgana.AI.LanguageModels.AzureOpenAI.csproj" ReferenceOutputAssembly="false" Private="false" LanguageModelPlugin="true" />
    <ProjectReference Include="..\Morgana.AI.LanguageModels\Ollama\Morgana.AI.LanguageModels.Ollama.csproj" ReferenceOutputAssembly="false" Private="false" LanguageModelPlugin="true" />
    <ProjectReference Include="..\Morgana.AI.LanguageModels\Google\Morgana.AI.LanguageModels.Google.csproj" ReferenceOutputAssembly="false" Private="false" LanguageModelPlugin="true" />
  </ItemGroup>

  <!-- A2A hosting: publishes each Morgana agent as an A2A endpoint (server side + routes) -->
  <ItemGroup>
    <PackageReference Include="A2A.AspNetCore" Version="$(A2AVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A" Version="$(MicrosoftAgentsAIPreviewVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="$(MicrosoftAgentsAIPreviewVersion)" />
  </ItemGroup>

  <!-- Create plugins directory automatically after build -->
  <Target Name="CreatePluginsDirectory" AfterTargets="Build">
    <PropertyGroup>
      <PluginsDir>$(OutputPath)plugins\</PluginsDir>
    </PropertyGroup>
    <Message Text="Ensuring plugins directory exists: $(PluginsDir)" Importance="high" />
    <MakeDir Directories="$(PluginsDir)" Condition="!Exists('$(PluginsDir)')" />
  </Target>

  <!--
    The providers are deployed by the host because only the host knows which assemblies it already
    holds: a provider brings its vendor SDK into plugins/, while every assembly the host references
    (Morgana.AI, its packages and the shared framework) stays out, since the host's own copy is the one loaded.
  -->
  <Target Name="DeployLanguageModelPlugins" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(ProjectReference.LanguageModelPlugin)' == 'true'"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="LanguageModelPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <LanguageModelPluginOutput Include="%(LanguageModelPluginAssembly.RootDir)%(LanguageModelPluginAssembly.Directory)*.dll" />
      <LanguageModelPluginFile Include="@(LanguageModelPluginOutput)" />
      <LanguageModelPluginFile Remove="@(ReferencePath)" MatchOnMetadata="Filename" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)plugins" Condition="!Exists('$(OutDir)plugins')" />
    <Copy SourceFiles="@(LanguageModelPluginFile)" DestinationFolder="$(OutDir)plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>