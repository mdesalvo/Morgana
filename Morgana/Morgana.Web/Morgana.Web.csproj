<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Title>Morgana.Web</Title>
    <PackageId>Morgana.Web</PackageId>
    <UserSecretsId>374228be-4f26-4382-a3ef-7500a0b829dd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morgana.AI\Morgana.AI.csproj" />
    <!-- Built with the host so that their plugins are deployed beside it, never referenced as assemblies, so the host knows only the providers it finds in plugins/ -->
    <ProjectReference Include="..\Morgana.AI.Vendors\Anthropic\Morgana.AI.Vendors.Anthropic.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Morgana.AI.Vendors\OpenAI\Morgana.AI.Vendors.OpenAI.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Morgana.AI.Vendors\AzureOpenAI\Morgana.AI.Vendors.AzureOpenAI.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Morgana.AI.Vendors\Ollama\Morgana.AI.Vendors.Ollama.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- A2A hosting: publishes each Morgana agent as an A2A endpoint (server side + routes) -->
  <ItemGroup>
    <PackageReference Include="A2A.AspNetCore" Version="$(A2AVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A" Version="$(MicrosoftAgentsAIPreviewVersion)" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="$(MicrosoftAgentsAIPreviewVersion)" />
  </ItemGroup>

  <!-- Create plugins directory automatically after build -->
  <Target Name="CreatePluginsDirectory" AfterTargets="Build">
    <PropertyGroup>
      <PluginsDir>$(OutputPath)plugins\</PluginsDir>
    </PropertyGroup>
    <Message Text="Ensuring plugins directory exists: $(PluginsDir)" Importance="high" />
    <MakeDir Directories="$(PluginsDir)" Condition="!Exists('$(PluginsDir)')" />
  </Target>

</Project>