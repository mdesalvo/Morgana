# ==============================================================================
# MORGANA - DEVELOPMENT ENVIRONMENT
# ==============================================================================
# For building Morgana and Cauldron from source code.
# Versions are auto-generated from Directory.Build.props into .env.versions
# 
# Usage:
#   1.  Copy this file to .env
#   2.  Fill in your secrets below
#   3.  Build Morgana:   dotnet build ./Morgana
#   4.  Build Cauldron:  dotnet build ./Channels/Cauldron
#   5A. Build Grimoire:  dotnet build ./Channels/Grimoire
#   5B. Build Rune:      dotnet build ./Channels/Rune
#   5C. Build Alembic:   dotnet build ./Alembic
#   6.  Build docker image:  docker compose --env-file .env --env-file .env.versions build
#   7.  Manage docker image: docker compose --env-file .env --env-file .env.versions up|down|...
#       Note: `up` starts Morgana + Cauldron only. Grimoire's Spectre.Console TUI needs its own terminal, so launch it interactively in a separate shell:
#        docker compose --env-file .env --env-file .env.versions run --rm --service-ports --use-aliases grimoire
#        `--use-aliases` is mandatory: `compose run` skips network aliases by default, so without it Morgana's webhook callback to http://grimoire:5004 fails DNS resolution.
#       Alembic is profile-gated too, for an unrelated reason: it is the authoring workbench, talks to no Morgana instance and joins no network, so `up` skips it as well:
#        docker compose --env-file .env --env-file .env.versions --profile authoring up alembic

# ==============================================================================
# ENCRYPTION
# ==============================================================================
# AES-256 key (32 bytes) encoded in Base64 for encrypting SQLite databases
# Generate a new key with: 
#   Linux/Mac:   openssl rand -base64 32
#   PowerShell:  $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
ENCRYPTIONKEY=YOUR_BASE64_ENCODED_256_BIT_KEY_HERE

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# HMAC-SHA256 symmetric key for JWT token signing between Cauldron and Morgana
# Generate a new key with:
#   Linux/Mac:   openssl rand -base64 32
#   PowerShell:  $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
JWT_SYMMETRIC_KEY=YOUR_BASE64_ENCODED_256_BIT_KEY_HERE

# ==============================================================================
# AGENT-TO-AGENT WITH REMOTE INSTALLATIONS (optional)
# ==============================================================================
# Only for agents that consult a partner's agents ([ConsultsAgent("intent", "partner")])
# or a partner that consults agents here. Uncomment these and the matching lines in
# docker-compose.yml together: a partner declared with empty values is refused at startup.
#
# Where partners reach this installation: absolute http(s) address, never a wildcard host.
#MORGANA_PUBLIC_URL=https://morgana.your-domain.example
#
# One partner. Its name is what [ConsultsAgent] writes, never a hostname ("morgana" is reserved).
# The key is shared with that partner alone, generated like the keys above.
#PARTNER_0_NAME=acme
#PARTNER_0_URL=https://morgana.acme.example
#PARTNER_0_SYMMETRIC_KEY=YOUR_BASE64_ENCODED_256_BIT_KEY_HERE
# The name the partner knows this installation by, from its own declaration of the relationship.
#PARTNER_0_OUTBOUND_ISSUER=YOUR_NAME_AT_THE_PARTNER
# How many conversations the partner may open here within a sliding hour.
#PARTNER_0_MAX_CONVERSATIONS_PER_HOUR=60

# ==============================================================================
# LLM TIERS
# ==============================================================================
# Each tier picks its own provider: "Anthropic", "AzureOpenAI", "OpenAI" or "Ollama".
# All three tiers are mandatory; no tier falls back to another. Economy, Efficiency and
# Performance go from the cheapest model to the most capable: the Anthropic models below
# are only an example. ApiKey is used by Anthropic, OpenAI and AzureOpenAI, Endpoint by
# AzureOpenAI and Ollama: leave the unused one empty.
# ModelId is the model id, or the deployment name on Azure.

#LLM_ECONOMY_PROVIDER=Anthropic
#LLM_ECONOMY_APIKEY=sk-ant-api03-YOUR_KEY_HERE
#LLM_ECONOMY_ENDPOINT=
#LLM_ECONOMY_MODEL=claude-haiku-5-5

#LLM_EFFICIENCY_PROVIDER=Anthropic
#LLM_EFFICIENCY_APIKEY=sk-ant-api03-YOUR_KEY_HERE
#LLM_EFFICIENCY_ENDPOINT=
#LLM_EFFICIENCY_MODEL=claude-sonnet-5-5

#LLM_PERFORMANCE_PROVIDER=Anthropic
#LLM_PERFORMANCE_APIKEY=sk-ant-api03-YOUR_KEY_HERE
#LLM_PERFORMANCE_ENDPOINT=
#LLM_PERFORMANCE_MODEL=claude-opus-5-5

# Tier on which Morgana's own framework actors (guard, classifier, presenter, channel adapter) run.
#ACTORSYSTEM_TIER=Economy
