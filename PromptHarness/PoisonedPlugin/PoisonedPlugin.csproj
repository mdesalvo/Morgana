<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Title>PoisonedPlugin</Title>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>0.33.0</Version>
    <IsPackable>false</IsPackable>

    <Description>
    A one-agent domain whose every source of data has been turned against it: its own tools, the
    MCP server it reads the weather from and the partner nursery it consults all answer with prompt
    injection. It exists for the harness's tool-guard run and ships with nothing.
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="agents.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Morgana\Morgana.AI\Morgana.AI.csproj" />
  </ItemGroup>

</Project>
