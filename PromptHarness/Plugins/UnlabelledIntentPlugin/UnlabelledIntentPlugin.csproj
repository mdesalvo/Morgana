<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Title>UnlabelledIntentPlugin</Title>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta1</VersionSuffix>
    <IsPackable>false</IsPackable>

    <Description>
    A domain built to be wrong: one intent without a Label. It exists only so the harness can prove
    that startup refuses it, ships with nothing and is loaded only by PluginValidationTests under
    Harness__MalformedDomain=unlabelled-intent.
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="agents.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Morgana\Morgana.AI\Morgana.AI.csproj" />
  </ItemGroup>

</Project>
