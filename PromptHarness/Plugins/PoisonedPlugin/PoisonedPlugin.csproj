<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Title>PoisonedPlugin</Title>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta2</VersionSuffix>
    <IsPackable>false</IsPackable>

    <Description>
    A one-agent domain whose every outside source and one of its own books answer with an attempt at
    hijacking. It exists only for the harness's hijacking run: the agent has to be written in code
    because its MCP servers and its colleagues at other installations are named on attributes.
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="agents.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Morgana\Morgana.AI\Morgana.AI.csproj" />
  </ItemGroup>

</Project>
