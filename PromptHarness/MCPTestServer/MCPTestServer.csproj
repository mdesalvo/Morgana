<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Title>MCPTestServer</Title>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <Description>
    A deterministic MCP server over stdio or, on request, over HTTP, with tools whose results never vary. It exists for the
    harness's workflow group: an MCP tool inside a workflow is asserted against answers that the test
    knows beforehand, with no model and nothing beyond the local machine.
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

</Project>
