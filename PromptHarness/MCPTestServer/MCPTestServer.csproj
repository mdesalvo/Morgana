<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Title>MCPTestServer</Title>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <Description>
    A deterministic MCP server over stdio, with tools whose results never vary. It exists for the
    harness's workflow group: an MCP tool inside a workflow is asserted against answers that the test
    knows beforehand, with no network and no model.
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
