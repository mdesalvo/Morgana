@*
    The way back, and it names where it lands rather than saying "back". A step of this wizard is not
    numbered on the screen, so a bare arrow asks the client to remember what came before their own
    answer.

    It is quiet and it sits under the box: going on is what they are here to do, and going back is
    what they do when something is wrong. On the first screen it renders nothing at all — the map is
    the beginning, and behind it there is only the landing.
*@

@if (Behind is { } behind)
{
    <div class="step-back">
        <button @onclick="() => OnBack.InvokeAsync()" disabled="@Busy">&larr; @behind</button>
    </div>
}

@code {
    /// <summary>
    /// The interview being stepped back through.
    /// </summary>
    [Parameter, EditorRequired]
    public InterviewState State { get; set; } = default!;

    /// <summary>
    /// Whether a turn is already under way, in which case there is nothing to step back from yet.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Raised when the client asks to go back a step.
    /// </summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>
    /// Where the way back lands, in the client's own words, or <c>null</c> when nothing is behind.
    /// </summary>
    // Worded as the rail above is worded, so the label and the step being returned to are the same
    // phrase. Leaving an entry says so by naming the entry instead: it is a bigger move than
    // stepping between two steps of one.
    private string? Behind => State switch
    {
        { Pass: InterviewPass.AgentFinalizer, ReadyForReview: true } => "Change something in this one",
        { Pass: InterviewPass.DomainMapper } => null,
        { Pass: InterviewPass.AgentModeler, At: 0 } => "Back to what your Morgana takes care of",
        { Pass: InterviewPass.AgentModeler } => $"Back to {Named(State.Map[State.At - 1])}",
        { Pass: InterviewPass.ToolkitModeler } => "Back to what it is",
        _ => "Back to what it reaches for"
    };

    /// <summary>
    /// The client's own word for an entry: its button once it has one, its name until then.
    /// </summary>
    private static string Named(IntentDraft intent) => intent.Label ?? intent.Name ?? "the one before";
}
