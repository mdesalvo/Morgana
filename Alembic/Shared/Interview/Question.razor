@inject IJSRuntime JS

@*
    One question, alone, because that is the whole of what the client is being asked to do right now.

    The question and the box it is answered in, and nothing else. No standing reassurance under the
    box either — a line promising that half an answer will do is read once and is furniture from the
    second turn on, and Alembic says the same thing better by actually inferring the rest and showing
    what it inferred.
*@

<div class="scene">
    @if (Busy)
    {
        @* Three dots that breathe: a spinner says "loading", and this is somebody composing. *@
        <div class="thinking"><span>&bull;</span><span>&bull;</span><span>&bull;</span></div>
    }
    else
    {
        <p class="asked">@Asked</p>

        @*
            Choices are an offer and never a gate: the box below stays open, because the client's own
            words are the material and a menu would replace them with Alembic's. They only ever
            confirm an inference it has just stated back.
        *@
        @if (Choices is { Count: > 0 })
        {
            <div class="choices">
                @foreach (QuickReply choice in Choices)
                {
                    <button class="choice" @onclick="() => OnChoose.InvokeAsync(choice)">@choice.Label</button>
                }
            </div>
        }

        @*
            The cloud, on the one question the client cannot dictate: nobody has a ready sentence
            about how their own staff should sound, and recognising a word is what they can do
            instead. Several at a time, or none — which is why these are not buttons: a button is a
            whole answer, and one of these is not.
        *@
        @if (Traits is { Count: > 0 })
        {
            <div class="traits">
                @foreach (string trait in Traits)
                {
                    <button class="trait @(picked.Contains(trait) ? "picked" : null)"
                            @onclick="() => Toggle(trait)">@trait</button>
                }
            </div>
        }

        <div class="reply">
            <textarea @bind="answer" @bind:event="oninput" rows="5"
                      placeholder="@Prompting" aria-label="Your answer"></textarea>

            @*
                The two movements, on one row: the way back is the client's decision as much as the
                answer is, and it is rendered here rather than under the box so it is one.
            *@
            <div class="reply-actions">
                @Back

                <button class="primary" @onclick="SendAsync"
                        disabled="@Empty">Answer &rarr;</button>
            </div>
        </div>
    }
</div>

@code {
    private string answer = string.Empty;
    private int focusedOn = -1;
    private readonly HashSet<string> picked = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The question on the table.
    /// </summary>
    [Parameter, EditorRequired]
    public string Asked { get; set; } = string.Empty;

    /// <summary>
    /// What the empty box asks for: the material this step is short of, named.
    /// </summary>
    [Parameter, EditorRequired]
    public string Prompting { get; set; } = string.Empty;

    /// <summary>
    /// Buttons attached to this question, if any.
    /// </summary>
    [Parameter]
    public IReadOnlyList<QuickReply>? Choices { get; set; }

    /// <summary>
    /// Words offered for the agent's voice, if this is the question that asks for it.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? Traits { get; set; }

    /// <summary>
    /// The way back, beside the answer.
    /// </summary>
    [Parameter]
    public RenderFragment? Back { get; set; }

    /// <summary>
    /// Whether Alembic is composing, in which case there is nothing to answer yet.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// How many exchanges have happened. The caret follows it, and nothing else.
    /// </summary>
    [Parameter]
    public int Turn { get; set; }

    /// <summary>
    /// Raised with what the client typed.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnAnswer { get; set; }

    /// <summary>
    /// Raised with the button they pressed instead.
    /// </summary>
    [Parameter]
    public EventCallback<QuickReply> OnChoose { get; set; }

    /// <summary>
    /// Whether there is nothing to send: no words picked and nothing typed.
    /// </summary>
    private bool Empty => picked.Count == 0 && string.IsNullOrWhiteSpace(answer);

    /// <summary>
    /// Takes a word for the voice, or gives it back.
    /// </summary>
    private void Toggle(string trait)
    {
        if (!picked.Remove(trait))
            picked.Add(trait);
    }

    /// <summary>
    /// Sends the answer and empties the box, so the next question is not met by the last answer.
    /// </summary>
    /// <remarks>
    /// Picked words go as a sentence rather than as a list, because what reaches the model is one
    /// person's answer either way and a bare enumeration reads as a form return. Anything typed
    /// stays first: it is the client's own account, and the words are what they recognised in it.
    /// </remarks>
    private async Task SendAsync()
    {
        string typed = answer.Trim();
        string said = picked.Count == 0
            ? typed
            : (typed.Length > 0 ? typed + " " : string.Empty)
              + $"The voice I would want here: {string.Join(", ", picked)}.";

        answer = string.Empty;
        picked.Clear();

        await OnAnswer.InvokeAsync(said);
    }

    /// <summary>
    /// Puts the caret where the next answer goes, once per question.
    /// </summary>
    /// <remarks>
    /// Keyed on the turn count rather than run on every render, so the focus lands when a new
    /// question arrives and never steals the caret back from a client who has clicked away
    /// mid-sentence.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Busy || Turn == focusedOn)
            return;

        focusedOn = Turn;
        await JS.InvokeVoidAsync("alembicFocusReply");
    }
}
