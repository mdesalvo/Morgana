<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
       <Title>Alembic</Title>
       <PackageId>Alembic</PackageId>
       <RootNamespace>Alembic</RootNamespace>
       <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
       <!--
         Same UserSecretsId as Morgana.Web, on purpose and for the same reason PromptHarness
         shares it: Alembic owns no secrets of its own. It reads the very same `Morgana:LLM:*`
         section (MorganaLLM hardcodes that path), so in-repo it runs against whatever provider
         and tiers this working copy is already wired to, with nothing to configure twice.
         A client deploying Alembic on its own supplies that section by environment variable.
       -->
       <UserSecretsId>374228be-4f26-4382-a3ef-7500a0b829dd</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
       <!--
         Alembic's own conducting prose, embedded exactly the way morgana.json is embedded in
         Morgana.AI — same mechanism, same Records.PromptCollection shape, same four sections.
         Dogfooding: whoever tunes Alembic does the job Alembic teaches.
       -->
       <EmbeddedResource Include="alembic.json" />
       <!--
         The briefing Alembic hands a model before asking it for harness scenarios: what the rig is,
         what can be observed and what cannot, and two scenarios from the shipped suite as worked
         examples. Prose and exemplars only — the key table it ends with is generated at runtime from
         the linked ScenarioDefinition below, so the one part that could drift silently cannot.
       -->
       <EmbeddedResource Include="harness.md" />

       <!--
         Three scenarios from the suite that actually ships, embedded VERBATIM from PromptHarness so
         the worked examples handed to a model are the real thing rather than a copy somebody pasted
         once. Compile-time fills the backpack; at runtime Alembic reads nothing but its own assembly.

         Copies would be the obvious alternative and are the trap: an exemplar is only worth showing
         while it is still what the suite does, and a pasted one goes stale in silence, teaching a
         model an idiom nothing uses any more.
       -->
       <EmbeddedResource Include="..\PromptHarness\Scenarios\behaviour-turn-continuation-operand.yaml"
                         Link="Exemplars\behaviour-turn-continuation-operand.yaml" />
       <EmbeddedResource Include="..\PromptHarness\Scenarios\behaviour-conversation-closure.yaml"
                         Link="Exemplars\behaviour-conversation-closure.yaml" />
       <EmbeddedResource Include="..\PromptHarness\Scenarios\context-cycle-on-miss.yaml"
                         Link="Exemplars\context-cycle-on-miss.yaml" />
    </ItemGroup>

    <ItemGroup>
       <!--
         PromptHarness's own scenario schema, compiled into Alembic as a LINKED SOURCE FILE.

         Alembic writes starter scenarios for a domain, and the harness's deserializer is built
         .IgnoreUnmatchedProperties() — so a key it does not recognise is dropped in silence and the
         scenario runs, passes and asserts nothing. Describing the schema in prose and hoping the two
         stay in step is exactly the failure this guards against, so the real type is compiled in:
         the vocabulary handed to the model and the vocabulary checked afterwards are both reflected
         off it, and a rename in the harness breaks Alembic's build instead of Alembic's output.

         A ProjectReference would be wrong — PromptHarness pulls Morgana.Web, the Examples plugin and
         xUnit, none of which belong in an authoring workbench. One file costs YamlDotNet, which
         Alembic wants anyway: it is what lets a generated scenario be parsed as the harness will
         parse it rather than pattern-matched.
       -->
       <Compile Include="..\PromptHarness\Infrastructure\Engine\ScenarioDefinition.cs"
                Link="Model\ScenarioDefinition.linked.cs" />
    </ItemGroup>

    <ItemGroup>
       <PackageReference Include="YamlDotNet" Version="18.*" />
    </ItemGroup>

    <ItemGroup>
       <!--
         Morgana.AI, not Morgana.Contracts: Alembic is not a channel and exchanges no wire DTOs.
         What it needs is the domain model of a Morgana configuration — Records.Prompt,
         Records.ToolDefinition, Records.Intent — plus IPromptComposerService, which lets it show
         the client the prompt the model will really read. Morgana.Contracts comes transitively.
       -->
       <ProjectReference Include="..\Morgana\Morgana.AI\Morgana.AI.csproj" />
    </ItemGroup>

</Project>
