@inject IDraftValidationService DraftValidationService
@inject ICoherenceService CoherenceService
@inject ICoherenceApplyService CoherenceApplyService

@*
    Validation: the checks are chosen, run on demand and each keeps its own outcomes. Nothing is ticked
    on arrival. A finding carries one action: Apply when a written fix exists, Go to section when the
    rewrite is the client's. A fixed finding disappears.
*@

@{
    IReadOnlyList<ValidationFinding> findings = DraftValidationService.Validate(Draft);
    int choiceCount = rows.Count(row => row.Chosen);
}

<section class="open">
    <div class="open-body">
        @* The judged run rewrites every outcome below, so it is waited on where they stand. *@
        @if (running)
        {
            <Waiting Text="Reading your agents side by side, for what only shows between them…" />
        }
        else
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                @foreach (CheckRow row in rows)
                {
                    List<ValidationFinding> rowFindings = row.Check is { } check ? [.. findings.Where(finding => finding.Check == check)] : [];
                    List<CoherenceFinding> judgements = row.Check is null ? [.. coherence.Where(finding => string.Equals(finding.Kind, row.Id, StringComparison.OrdinalIgnoreCase))] : [];
                    int count = rowFindings.Count + judgements.Count;
                    bool ranThis = checksRun.Contains(row.Id);
                    bool errors = rowFindings.Any(finding => finding.Severity == FindingSeverity.Error);
                    bool isOpen = checksOpen.Contains(row.Id);

                    @if (row != rows[0])
                    {
                        <FluentDivider />
                    }

                    @* The box chooses the check and the item opens its outcomes: kept side by side, ticking never unfolds a row. *@
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Top" HorizontalGap="10px">
                        <FluentCheckbox @bind-Value="row.Chosen" Class="vbox" />

                        <FluentAccordion ExpandMode="AccordionExpandMode.Multi" Block="true" Class="vcheck">
                            <FluentAccordionItem Expanded="isOpen" ExpandedChanged="expanded => SetOpen(row, expanded)"
                                                 MarkerPosition="AccordionItemMarkerPosition.End">
                                <HeaderTemplate>
                                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="14px">
                                        <FluentText Size="TextSize.Size400">@row.Label</FluentText>
                                        @if (row.Check is null)
                                        {
                                            <FluentBadge Appearance="BadgeAppearance.Tint" Shape="BadgeShape.Circular" Color="BadgeColor.Brand" title="Judged by a model">AI</FluentBadge>
                                        }

                                        @if (ranThis)
                                        {
                                            @if (count == 0)
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success">passed</FluentBadge>
                                            }
                                            else
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Tint" Color="@(errors ? BadgeColor.Danger : BadgeColor.Warning)">@Outcome(count, errors)</FluentBadge>
                                            }
                                        }
                                    </FluentStack>
                                </HeaderTemplate>

                                <ChildContent>
                                    @if (!ranThis)
                                    {
                                        <FluentText Class="muted">Not run yet: tick it and run validation.</FluentText>
                                    }
                                    else if (count == 0)
                                    {
                                        <FluentText Class="muted">Nothing found.</FluentText>
                                    }

                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="9px">
                                        @foreach (ValidationFinding finding in rowFindings)
                                        {
                                            bool error = finding.Severity == FindingSeverity.Error;

                                            <FluentMessageBar Intent="@(error ? MessageBarIntent.Error : MessageBarIntent.Warning)" Layout="MessageBarLayout.MultiLine" AllowDismiss="false" Class="message-fits">
                                                <ChildContent>
                                                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="6px" VerticalGap="6px">
                                                        @foreach (string place in Places(finding.Where))
                                                        {
                                                            <FluentBadge Appearance="BadgeAppearance.Outline" Size="BadgeSize.Large">@place</FluentBadge>
                                                        }
                                                    </FluentStack>
                                                    <FluentText Size="TextSize.Size400" Block="true" Color="Color.Custom" CustomColor="var(--alembic-text)">@finding.Message</FluentText>
                                                    <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Italic="true" Class="because muted">
                                                        @(error ? "It must be fixed:" : "You may leave it as it is, but it is worth fixing:") @finding.Because
                                                    </FluentText>
                                                </ChildContent>
                                                <ActionsTemplate>
                                                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="() => OnGoTo.InvokeAsync(finding)">Go to section &rarr;</FluentButton>
                                                </ActionsTemplate>
                                            </FluentMessageBar>
                                        }

                                        @foreach (CoherenceFinding finding in judgements)
                                        {
                                            <FluentMessageBar Intent="MessageBarIntent.Warning" Layout="MessageBarLayout.MultiLine" AllowDismiss="false" Class="message-fits">
                                                <ChildContent>
                                                    <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="6px" VerticalGap="6px">
                                                        @foreach (string place in Places(finding.Where))
                                                        {
                                                            <FluentBadge Appearance="BadgeAppearance.Outline" Size="BadgeSize.Large">@place</FluentBadge>
                                                        }
                                                    </FluentStack>
                                                    <FluentText Size="TextSize.Size400" Block="true" Color="Color.Custom" CustomColor="var(--alembic-text)">@WithNames(finding.What)</FluentText>
                                                    <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Italic="true" Class="because muted">
                                                        You may leave it as it is, but it is worth fixing: @WithNames(finding.Why)
                                                    </FluentText>

                                                    @if (fixInFlight == finding)
                                                    {
                                                        <Waiting Text="Rewriting the agents this finding names…" />
                                                    }
                                                    else
                                                    {
                                                        <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Italic="true" Class="because muted">@WithNames(finding.Fix)</FluentText>
                                                    }
                                                </ChildContent>
                                                <ActionsTemplate>
                                                    @if (fixInFlight != finding)
                                                    {
                                                        <FluentButton Appearance="ButtonAppearance.Outline"
                                                                      Disabled="@(fixInFlight is not null)" OnClick="() => ApplyAsync(finding)">
                                                            Apply the correction
                                                        </FluentButton>
                                                    }
                                                </ActionsTemplate>
                                            </FluentMessageBar>
                                        }
                                    </FluentStack>
                                </ChildContent>
                            </FluentAccordionItem>
                        </FluentAccordion>
                    </FluentStack>
                }
            </FluentStack>
        }
    </div>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="actions">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12px" Width="auto">
            <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Large" Disabled="@(choiceCount == 0 || running)" OnClick="RunAsync">
                Run validation
            </FluentButton>
            <FluentText Class="muted">@(choiceCount == 0 ? "choose at least one check" : $"{choiceCount} of {rows.Count}")</FluentText>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="9px" Width="auto">
            <FluentButton Appearance="ButtonAppearance.Primary" Size="ButtonSize.Large" OnClick="() => OnNext.InvokeAsync()">Next &rarr;</FluentButton>
            @Keep
        </FluentStack>
    </FluentStack>
</section>

@code {
    /// <summary>
    /// The domain being checked.
    /// </summary>
    [Parameter, EditorRequired]
    public DomainDraft Draft { get; set; } = default!;

    /// <summary>
    /// Taking the work away.
    /// </summary>
    [Parameter]
    public RenderFragment? Keep { get; set; }

    /// <summary>
    /// Raised when the client moves on to the Archive.
    /// </summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>
    /// Raised with a finding whose rewrite is the client's, to open where it is written.
    /// </summary>
    [Parameter]
    public EventCallback<ValidationFinding> OnGoTo { get; set; }

    /// <summary>
    /// Raised after a correction landed on the domain.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Raised with what happened and what kind of news it is.
    /// </summary>
    [Parameter]
    public EventCallback<Notice> OnNotify { get; set; }

    /// <summary>
    /// One check the client can choose: a family decided by reading or a class judged by a model.
    /// </summary>
    private sealed class CheckRow
    {
        /// <summary>The key its outcomes are held under; for a judged class, the kind the model answers with.</summary>
        public required string Id { get; init; }

        /// <summary>What the row reads.</summary>
        public required string Label { get; init; }

        /// <summary>The family of deterministic findings; <c>null</c> for a class judged by a model.</summary>
        public ValidationCheck? Check { get; init; }

        /// <summary>Whether the client asked for it.</summary>
        public bool Chosen { get; set; }
    }

    /// <summary>
    /// The families decided by reading, named as the client reads them.
    /// </summary>
    private static readonly (ValidationCheck Check, string Label)[] Families =
    [
        (ValidationCheck.Intents, "Intents are named and described"),
        (ValidationCheck.Routing, "Every intent has its agent"),
        (ValidationCheck.Colleagues, "Every colleague can be reached"),
        (ValidationCheck.Agents, "Agents' sections are written"),
        (ValidationCheck.Tools, "Tools and parameters fit the code"),
        (ValidationCheck.Code, "Class names can be C# identifiers")
    ];

    /// <summary>
    /// Every check, in the order the client reads them.
    /// </summary>
    private readonly List<CheckRow> rows = [];

    /// <summary>
    /// The checks the last run carried: only those show outcomes.
    /// </summary>
    private readonly HashSet<string> checksRun = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// The checks open on their findings.
    /// </summary>
    private readonly HashSet<string> checksOpen = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// What the model found and the client has not yet corrected.
    /// </summary>
    private List<CoherenceFinding> coherence = [];

    /// <summary>
    /// Corrections applied this sitting, so a later run tells a fixed finding from one still present.
    /// </summary>
    private readonly List<ResolvedCoherenceFinding> corrections = [];

    /// <summary>
    /// Whether a judged run is on the wire.
    /// </summary>
    private bool running;

    /// <summary>
    /// The correction being applied, so only one runs at a time.
    /// </summary>
    private CoherenceFinding? fixInFlight;

    /// <summary>
    /// Lays out the families decided by reading, then the classes the model's own prompt declares.
    /// </summary>
    protected override void OnInitialized()
    {
        foreach ((ValidationCheck check, string label) in Families)
            rows.Add(new CheckRow { Id = check.ToString(), Label = label, Check = check });

        foreach (CoherenceAspect aspect in CoherenceService.Aspects)
            rows.Add(new CheckRow { Id = aspect.Id, Label = aspect.Label });
    }

    /// <summary>
    /// Runs the chosen checks: the ones decided by reading at once, the judged ones in one model pass.
    /// </summary>
    private async Task RunAsync()
    {
        List<CheckRow> choices = [.. rows.Where(row => row.Chosen)];

        if (choices.Count == 0)
            return;

        checksRun.Clear();
        checksRun.UnionWith(choices.Where(row => row.Check is not null).Select(row => row.Id));

        List<string> aspects = [.. choices.Where(row => row.Check is null).Select(row => row.Id)];

        // The judged part costs a model call and can be turned away, which the summary below must know.
        bool refused = aspects.Count > 0 && await JudgeAsync(aspects);

        // What came back with something opens on its own: it is what was asked.
        IReadOnlyList<ValidationFinding> findings = DraftValidationService.Validate(Draft);
        checksOpen.Clear();
        checksOpen.UnionWith(rows.Where(row => checksRun.Contains(row.Id)
                                         && (row.Check is { } check
                                             ? findings.Any(finding => finding.Check == check)
                                             : coherence.Any(finding => string.Equals(finding.Kind, row.Id, StringComparison.OrdinalIgnoreCase))))
                           .Select(row => row.Id));

        int findingCount = findings.Count(FamilyRan)
                    + coherence.Count(finding => checksRun.Contains(finding.Kind));
        int checks = rows.Count(row => checksRun.Contains(row.Id));
        bool blocking = findings.Any(finding => finding.Severity == FindingSeverity.Error && FamilyRan(finding));

        if (!refused && checks > 0)
            await OnNotify.InvokeAsync(findingCount == 0
                ? new Notice($"Nothing to fix in the {checks} check(s) run.", NoticeKind.Success)
                : new Notice($"{findingCount} thing(s) worth a look in the {checks} check(s) run.", blocking ? NoticeKind.Failure : NoticeKind.Warning));
    }

    /// <summary>
    /// Runs the chosen judged classes in one model pass and says whether the run was refused.
    /// </summary>
    private async Task<bool> JudgeAsync(List<string> aspects)
    {
        // Relations need two ends: with a single agent the model has nothing to compare.
        if (Draft.Agents.Count < 2)
        {
            await OnNotify.InvokeAsync(new Notice("One agent, so there is nothing to relate: the judged checks need two.", NoticeKind.Warning));
            return true;
        }

        // The page shows the wait while the model reads the domain.
        running = true;
        StateHasChanged();

        CoherenceReport report;

        try
        {
            report = await CoherenceService.ReviewAsync(Draft, aspects, corrections);
        }
        finally
        {
            running = false;
        }

        // A report that carries an error holds no findings, so there is nothing to show beyond the failure.
        if (report.Error is { } failure)
        {
            await OnNotify.InvokeAsync(new Notice(failure, NoticeKind.Failure));
            return true;
        }

        coherence = [.. report.Findings];
        checksRun.UnionWith(aspects);

        // A kind outside the classes asked for is kept under its own row rather than dropped.
        foreach (string kind in coherence.Select(finding => finding.Kind).Distinct(StringComparer.OrdinalIgnoreCase)
                     .Where(kind => rows.All(row => !string.Equals(row.Id, kind, StringComparison.OrdinalIgnoreCase))))
        {
            rows.Add(new CheckRow { Id = kind, Label = kind, Chosen = true });
            checksRun.Add(kind);
        }

        return false;
    }

    /// <summary>
    /// Whether a finding decided by reading belongs to a family the last run carried.
    /// </summary>
    private bool FamilyRan(ValidationFinding finding) =>
        rows.Any(row => row.Check == finding.Check && checksRun.Contains(row.Id));

    /// <summary>
    /// Applies one finding's own fix; an applied finding disappears.
    /// </summary>
    private async Task ApplyAsync(CoherenceFinding finding)
    {
        fixInFlight = finding;
        CoherenceApplyResult result;

        try
        {
            result = await CoherenceApplyService.ApplyAsync(Draft, finding);
        }
        finally
        {
            fixInFlight = null;
        }

        // Refreshed even after a declared failure: the applier may have written before it stopped.
        await OnChanged.InvokeAsync();

        if (result.Applied)
        {
            coherence.Remove(finding);
            corrections.Add(new ResolvedCoherenceFinding(finding, result.Summary));
        }

        await OnNotify.InvokeAsync(new Notice(result.Summary, result.Applied ? NoticeKind.Success : NoticeKind.Failure));
    }

    /// <summary>
    /// Opens or closes a check on its findings, as its item was unfolded or folded.
    /// </summary>
    private void SetOpen(CheckRow row, bool expanded)
    {
        if (expanded)
            checksOpen.Add(row.Id);
        else
            checksOpen.Remove(row.Id);
    }

    /// <summary>
    /// A check's outcome in words, worst severity first.
    /// </summary>
    private static string Outcome(int count, bool errors) =>
        count == 1 ? errors ? "1 error" : "1 warning" : $"{count} {(errors ? "errors" : "warnings")}";

    /// <summary>
    /// A judged finding's sentence with every name the model set between backticks drawn as the badge that heads the
    /// finding, so the agent to open reads as a name and never as an ordinary word of the prose.
    /// </summary>
    private static RenderFragment WithNames(string text) => @<text>
        @foreach ((string piece, bool isName) in Pieces(text))
        {
            @if (isName)
            {
                <FluentBadge Appearance="BadgeAppearance.Outline" Size="BadgeSize.Large">@piece</FluentBadge>
            }
            else
            {
                @piece
            }
        }
    </text>;

    /// <summary>
    /// A sentence cut at its backticks: every other piece is a name, and an unclosed backtick leaves the rest as prose.
    /// </summary>
    private static IEnumerable<(string Piece, bool IsName)> Pieces(string text)
    {
        string[] pieces = text.Split('`');

        for (int index = 0; index < pieces.Length; index++)
        {
            bool closed = index % 2 == 1 && index < pieces.Length - 1;

            if (pieces[index].Length > 0)
                yield return (closed ? pieces[index] : (index % 2 == 1 ? "`" : "") + pieces[index], closed);
        }
    }

    /// <summary>
    /// Where a finding points, one badge per name: a judged finding lists the agents it involves, a finding decided
    /// by reading spells one element's path, and neither the quotes, the backticks nor the dots it was written with
    /// reach the badge.
    /// </summary>
    private static IEnumerable<string> Places(string location) =>
        location.Split([',', '.'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
             .Select(place => place.Replace("'", string.Empty).Replace("\"", string.Empty).Replace("`", string.Empty).Trim())
             .Where(place => place.Length > 0);

}
