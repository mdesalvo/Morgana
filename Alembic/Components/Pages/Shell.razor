@page "/shell"
@inject IInterviewService InterviewService
@inject IDraftStateService DraftStateService
@inject INotificationService NotificationService

@*
    The shell: the track on top, one open card below. While the interview runs the frontier is where it
    stands; once it ends the domain is the frontier and every moment behind it is free to read. A
    correction reopens one agent and hands the shell back where it was.
*@

<FluentLayout Height="100dvh">
    <FluentLayoutItem Area="LayoutArea.Header" Height="auto"
                      Style="display: block; padding: 11px 26px 13px; color: inherit; background: var(--alembic-bg-deep); border-bottom: 1px solid var(--alembic-border);">
        <div class="track-head">
            <span class="wordmark">Alembic</span>
        </div>

        <Track Entries="entries" Frontier="Frontier" Pointer="Pointer" DomainAt="domainAt" OnLook="LookAt" />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="stream">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="10px" Class="who-now">
            <FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold">@Heading</FluentText>
            @if (!Pointer.IsMap)
            {
                <FluentText Size="TextSize.Size300" Class="muted">@Pointer.Name</FluentText>
            }
        </FluentStack>

        @* The domain's cards stay mounted, so a distillation or a validation survives looking elsewhere. *@
        @if (inDomain && DraftStateService.Current is { } domain)
        {
            <div class="domain-slot" hidden="@(Pointer != Collaboration)">
                <CollaborationCard Draft="domain" OnNext="() => LookAt(Validation)" OnChanged="Changed" OnRefuse="RefuseAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </CollaborationCard>
            </div>

            <div class="domain-slot" hidden="@(Pointer != Validation)">
                <ValidationCard Draft="domain" OnNext="() => LookAt(Archive)" OnGoTo="GoTo" OnChanged="Changed" OnNotify="NotifyAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </ValidationCard>
            </div>

            <div class="domain-slot" hidden="@(Pointer != Archive)">
                <ArchiveCard Draft="domain" OnChanged="Changed" OnNotify="NotifyAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </ArchiveCard>
            </div>
        }

        @if (!(inDomain && Pointer.OnDomain))
        {
            @if (Pointer != Working)
            {
                <ReadingCard Point="Pointer" Entries="entries" Agent="AgentAt(Pointer.Entry)" Busy="busy"
                             CanUpdate="CanUpdate" OnLeave="() => LookAt(Working)" OnUpdate="ReopenAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </ReadingCard>
            }
            else if (InterviewService.Current is not { } interview)
            {
                <section class="open">
                    <div class="open-body"><Waiting /></div>
                </section>
            }
            else if (Working.Rail == ShellPoint.AcceptanceRail)
            {
                <AcceptanceCard Agent="interview.Agent" Busy="busy" OnAccept="AcceptAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </AcceptanceCard>
            }
            else
            {
                <QuestionCard Asked="@(interview.Question ?? "…")"
                              Quoted="@interview.Quoted"
                              Prompting="@Prompting(interview)"
                              Choice="@(interview.Chosen ? null : interview.Choice)"
                              Traits="interview.Traits"
                              Taken="interview.TraitsTaken"
                              Correcting="Correcting"
                              Busy="busy"
                              Error="@interview.Error"
                              Turn="interview.Exchanges"
                              OnAnswer="SendAsync"
                              OnChoose="ChooseAsync"
                              OnLeave="AcceptAsync">
                    <Keep><SaveWork Busy="busy" OnReceipt="NotifyAsync" /></Keep>
                </QuestionCard>
            }
        }
    </FluentLayoutItem>
</FluentLayout>

@code {
    /// <summary>
    /// The worked example under the very first question, while nothing about the client is known.
    /// </summary>
    private const string HouseExample =
        "We run Bistrot Luna, a small neighbourhood bistro. Guests book a table, ask what's on tonight's menu "
        + "and whether a dish suits their allergies, then order takeaway on the evenings they stay home.";

    /// <summary>
    /// The domain's three moments.
    /// </summary>
    private static readonly ShellPoint Collaboration = new(-1, ShellPoint.CollaborationRail);

    /// <inheritdoc cref="Collaboration" />
    private static readonly ShellPoint Validation = new(-1, ShellPoint.CollaborationRail + 1);

    /// <inheritdoc cref="Collaboration" />
    private static readonly ShellPoint Archive = new(-1, ShellPoint.CollaborationRail + 2);

    /// <summary>
    /// Where the client came in from the import: walk, validate or archive. Absent, the interview.
    /// </summary>
    [SupplyParameterFromQuery(Name = "door")]
    public string? Door { get; set; }

    /// <summary>
    /// Whether a turn is on the wire.
    /// </summary>
    private bool busy;

    /// <summary>
    /// Whether the interview is behind the client and the domain is what they are working on.
    /// </summary>
    private bool inDomain;

    /// <summary>
    /// The domain moment the client last stood on.
    /// </summary>
    private ShellPoint domainAt = Collaboration;

    /// <summary>
    /// Where the client is looking when it is not the work in hand; <c>null</c> means the work in hand.
    /// </summary>
    private ShellPoint? focus;

    /// <summary>
    /// The agents on the track, in map order.
    /// </summary>
    private IReadOnlyList<IntentDraft> entries = [];

    /// <summary>
    /// The interview that owns the frontier: the one a correction set aside, else the running one.
    /// </summary>
    private InterviewState? FrontierInterview => InterviewService.Current?.Resume ?? InterviewService.Current;

    /// <summary>
    /// Where the interview stands; in the domain, the Archive, so everything is open.
    /// </summary>
    private ShellPoint Frontier =>
        inDomain ? Archive
        : FrontierInterview is { } owner ? ShellPoint.FrontierOf(owner)
        : ShellPoint.Map;

    /// <summary>
    /// Where the open work is: the frontier, the reopened agent's step or the domain moment last stood on.
    /// </summary>
    // A correction's own map is the one agent it reopened, so its step is placed on the track by name.
    private ShellPoint Working =>
        InterviewService.Current is { } interview && (inDomain || interview.Resume is not null)
            ? new ShellPoint(EntryOf(interview.Intent), ShellPoint.FrontierOf(interview).Rail)
            : inDomain ? domainAt : Frontier;

    /// <summary>
    /// Where the client is looking.
    /// </summary>
    private ShellPoint Pointer => focus ?? Working;

    /// <summary>
    /// Whether the open question corrects an agent that already exists.
    /// </summary>
    private bool Correcting => inDomain || InterviewService.Current?.Resume is not null;

    /// <summary>
    /// Whether the agent read under the pointer can be reopened: one correction at a time.
    /// </summary>
    private bool CanUpdate =>
        Pointer.OnAgent && (inDomain
            ? InterviewService.Current is null
            : InterviewService.Current is { Resume: null, Revision: null });

    /// <summary>
    /// What the card is about, said once above it.
    /// </summary>
    private string Heading =>
        Pointer.IsMap ? "Domain map"
        : Pointer.OnAgent && Pointer.Entry >= 0 && Pointer.Entry < entries.Count ? $"Agent: {Named(entries[Pointer.Entry])}"
        : "Domain";

    /// <summary>
    /// Moves the pointer. In the domain a domain moment becomes the place the client stands.
    /// </summary>
    private void LookAt(ShellPoint point)
    {
        // With no correction running a domain moment is where the client works, not a page being leafed.
        if (inDomain && point.OnDomain && InterviewService.Current is null)
        {
            domainAt = point;
            focus = null;
            return;
        }

        // Looking at the work in hand or beyond the frontier clears the pointer: nothing there is written yet.
        focus = point == Working || point > Frontier ? null : point;
    }

    /// <summary>
    /// Opens where a finding's rewrite belongs: an agent's section, the map, the colleagues or the code.
    /// </summary>
    private void GoTo(ValidationFinding finding)
    {
        // A finding about the domain as a whole names no agent and has no entry on the track.
        int entry = finding.Agent is { } agent ? EntryOf(agent) : -1;

        // The destination is where the client can rewrite what the finding reports.
        ShellPoint target = finding.Check switch
        {
            // Colleague findings are settled on the Collaboration form.
            ValidationCheck.Colleagues => Collaboration,
            // Code findings are settled on the Archive card, where the class names are written.
            ValidationCheck.Code => Archive,
            // Agent and tool findings reopen the section that holds them, the Target when none is named.
            _ when entry >= 0 && finding.Check is ValidationCheck.Agents or ValidationCheck.Tools
                => new ShellPoint(entry, finding.Step is { } step ? (int)step : 1),
            // Every other finding concerns the map, which settles the intents against one another.
            _ => ShellPoint.Map
        };

        LookAt(target);
    }

    /// <summary>
    /// Where an intent sits on the track.
    /// </summary>
    private int EntryOf(IntentDraft intent) => EntryOf(intent.Name ?? string.Empty);

    /// <inheritdoc cref="EntryOf(IntentDraft)" />
    private int EntryOf(string name)
    {
        // Intent names are compared without case, as the framework resolves them.
        for (int entry = 0; entry < entries.Count; entry++)
            if (string.Equals(entries[entry].Name, name, StringComparison.OrdinalIgnoreCase))
                return entry;

        // An intent that is not on the track has no position.
        return -1;
    }

    /// <summary>
    /// The agent behind a track entry: the one being written or corrected, otherwise the one in the domain.
    /// </summary>
    private AgentDraft? AgentAt(int entry)
    {
        // The agent being corrected lives in the running interview, not in the domain.
        if (InterviewService.Current is { } interview && (inDomain || interview.Resume is not null) && entry == EntryOf(interview.Intent))
            return interview.Agent;

        // The agent being composed lives in the interview that owns the frontier until the client accepts it.
        if (!inDomain && FrontierInterview is { } owner && owner.OnAnEntry && entry == owner.At)
            return owner.Agent;

        // A position outside the track has no agent.
        if (entry < 0 || entry >= entries.Count)
            return null;

        // The intent name is the ID of the agent that answers it.
        string? name = entries[entry].Name;

        // An agent already accepted is read from the domain draft.
        return DraftStateService.Current?.Agents.FirstOrDefault(agent =>
            string.Equals(agent.ID, name, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// The worked example in the answer box: the model's, the house one on the opening question.
    /// </summary>
    private static string Prompting(InterviewState interview) =>
        interview.Example
        ?? (interview is { Pass: InterviewStep.DomainMapper, PassJustOpened: true } ? HouseExample : string.Empty);

    /// <summary>
    /// The name an entry goes by: the intent name, which the agent answering it carries as its ID.
    /// </summary>
    private static string Named(IntentDraft intent) => intent.Name ?? "…";

    /// <summary>
    /// Enters through the door the client chose, picks up an interview in hand or lights the burner.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Entry is decided once per circuit, on the first render.
        if (!firstRender)
            return;

        // The walk, validate and archive doors need a loaded domain with agents to work on.
        if (Door is "walk" or "validate" or "archive" && DraftStateService.Current is { Agents.Count: > 0 })
        {
            EnterDomain();

            // Each door opens the domain on the moment its intention names.
            domainAt = Door switch { "validate" => Validation, "archive" => Archive, _ => Collaboration };

            // Correcting starts on the first agent: whoever comes to correct recognises the problem by reading.
            if (Door == "walk")
                focus = new ShellPoint(0, 1);

            StateHasChanged();
            return;
        }

        // With no interview in hand the client starts one from the opening question.
        if (InterviewService.Current is null)
            await TurnAsync(() => InterviewService.StartAsync());

        // A start that left no interview means there is nothing to ask: the domain is what remains.
        if (InterviewService.Current is null)
            EnterDomain();

        Refresh();
        StateHasChanged();
    }

    /// <summary>
    /// Sends a typed answer; the answer that settles the last step hands the shell to the domain.
    /// </summary>
    private async Task SendAsync(string reply)
    {
        // The engine merges the answer into the draft and may open the next pass inside the same call.
        await TurnAsync(() => InterviewService.AnswerAsync(reply));
        AfterTurn();
    }

    /// <summary>
    /// Sends the offered button's answer, lit before the round trip so the gesture shows at once.
    /// </summary>
    private Task ChooseAsync(QuickReply choice)
    {
        // The button is marked chosen so the client sees their gesture while the turn runs.
        if (InterviewService.Current is { } interview)
            interview.Chosen = true;

        // The button's value travels as the client's answer.
        return SendAsync(choice.Value);
    }

    /// <summary>
    /// Lets the agent into the domain; a correction hands the shell back where it was.
    /// </summary>
    private async Task AcceptAsync()
    {
        // Accepting is the client's decision to admit the finished agent into the domain.
        await TurnAsync(() => InterviewService.AcceptAsync());
        AfterTurn();
    }

    /// <summary>
    /// Opens a correction of the agent under the pointer, starting at its Target.
    /// </summary>
    private async Task ReopenAsync()
    {
        // The pointer names the agent the client has been reading.
        int entry = Pointer.Entry;

        // Whether the engine agreed to open the correction.
        bool opened = false;

        // In the domain the agent is revised by name; the first branch needs an entry still on the track.
        if (inDomain && entry >= 0 && entry < entries.Count && entries[entry].Name is { } name)
            await TurnAsync(async () => opened = await InterviewService.ReviseAsync(name));
        // During the interview the agent is reopened by its position on the map.
        else if (!inDomain)
            await TurnAsync(async () => opened = await InterviewService.ReopenAsync(entry));

        // A refused reopening is reported, since the card stays where it was.
        if (!opened)
            await NotifyAsync(new Notice("This agent cannot be reopened right now.", NoticeKind.Failure));
    }

    /// <summary>
    /// Runs one engine call with the shell marked busy, then brings the pointer back to the work in hand.
    /// </summary>
    private async Task TurnAsync(Func<Task> call)
    {
        // The card is locked while the model works so no second answer is sent.
        busy = true;
        StateHasChanged();

        try
        {
            // The engine call whose outcome the open card shows.
            await call();
        }
        finally
        {
            // A failed turn also unlocks the card: the interview carries its error for the client to read.
            busy = false;
            focus = null;
            Refresh();
        }
    }

    /// <summary>
    /// Hands the shell to the domain once no interview is left running.
    /// </summary>
    private void AfterTurn()
    {
        // An interview that ended leaves the domain as the client's place.
        if (!inDomain && InterviewService.Current is null)
            EnterDomain();
        // Otherwise the track follows the interview where it stands.
        else
            Refresh();
    }

    /// <summary>
    /// Puts the client on the domain, on its first moment.
    /// </summary>
    private void EnterDomain()
    {
        // The domain opens on the Collaboration form with nothing set aside to look at.
        inDomain = true;
        domainAt = Collaboration;
        focus = null;
        Refresh();
    }

    /// <summary>
    /// Reads the track's entries: today's map while interviewing, the domain's agents once in it.
    /// </summary>
    // A correction takes its agent out of the domain while it runs, so the track keeps the list it had.
    private void Refresh()
    {
        // While interviewing the track follows the map the interview is building.
        if (!inDomain && FrontierInterview is { } owner)
        {
            entries = [.. owner.Map];
            return;
        }

        // A correction in the domain keeps the list the track already shows.
        if (inDomain && InterviewService.Current is not null)
            return;

        // The domain draft holds the agents accepted so far.
        DomainDraft? draft = DraftStateService.Current;

        // Only intents that already have an agent appear on the track.
        entries = draft is null
            ? []
            : [.. draft.Intents.Where(intent => draft.Agents.Any(agent =>
                  string.Equals(agent.ID, intent.Name, StringComparison.OrdinalIgnoreCase)))];
    }

    /// <summary>
    /// Records that the domain changed under a form, so the save file and the autosave are never behind.
    /// </summary>
    private void Changed() => DraftStateService.Set(DraftStateService.Current);

    /// <summary>
    /// Shows a refusal.
    /// </summary>
    private Task RefuseAsync(string reason) => NotifyAsync(new Notice(reason, NoticeKind.Warning));

    /// <summary>
    /// Shows a passing notice, drawn in the colour of the kind of news it is.
    /// </summary>
    private async Task NotifyAsync(Notice notice)
    {
        // The toast carries the notice's sentence as its title and the palette of its kind.
        await NotificationService.ShowToastAsync(options =>
        {
            // Each kind of news maps to the toast intent that carries its icon.
            options.Intent = notice.Kind switch
            {
                NoticeKind.Success => ToastIntent.Success,
                NoticeKind.Warning => ToastIntent.Warning,
                NoticeKind.Failure => ToastIntent.Error,
                _ => ToastIntent.Info
            };
            options.Title = notice.Message;
            options.Lifetime = NoticeLifetime;
            options.Style = LookOf(notice.Kind);
        });
    }

    /// <summary>
    /// How long a notice stays before it goes by itself.
    /// </summary>
    private static readonly TimeSpan NoticeLifetime = TimeSpan.FromSeconds(7);

    /// <summary>
    /// A notice as a lit panel of the room, edged in the colour the checks use for the same news.
    /// </summary>
    // The kinds' own marks already come from the theme; only plain news needs its mark set, in the accent.
    private static string LookOf(NoticeKind kind)
    {
        // The edge colour is the one the checks use for the same kind of news.
        string colour = kind switch
        {
            NoticeKind.Success => "var(--alembic-success)",
            NoticeKind.Warning => "var(--alembic-gold)",
            NoticeKind.Failure => "var(--alembic-error)",
            _ => "var(--alembic-accent)"
        };

        // Plain news is the only kind whose icon is not drawn by the theme.
        string mark = kind is NoticeKind.Success or NoticeKind.Warning or NoticeKind.Failure ? string.Empty : $" --colorBrandForeground1: {colour};";

        // The style sets the lit panel of the room and the edge in the kind's colour.
        return "--colorNeutralBackground1: var(--alembic-panel-lit); --shadow8: var(--alembic-glow); "
               + $"--colorTransparentStroke: {colour};{mark}";
    }
}
