@*
    The way back and it names where it lands rather than saying "back". A step of this wizard is not
    numbered on the screen, so a bare arrow asks the client to remember what came before their own
    answer.

    It sits in the same row as the answer and at the same size, because the two are equally theirs to
    make — and going back is in fact the only movement of the interview they decide, since going on is
    a claim the state machine settles. A line of small print under the box said the opposite.

    On the first screen it renders nothing at all: the map is the beginning and behind it there is
    only the landing.
*@

@if (Behind is { } behind)
{
    <button class="secondary" @onclick="() => OnBack.InvokeAsync()" disabled="@Busy">&larr; @behind</button>
}

@code {
    /// <summary>
    /// The interview being stepped back through.
    /// </summary>
    [Parameter, EditorRequired]
    public InterviewState State { get; set; } = default!;

    /// <summary>
    /// Whether a turn is already under way, in which case there is nothing to step back from yet.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Raised when the client asks to go back a step.
    /// </summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>
    /// Where the way back lands, in the client's own words, or <c>null</c> when nothing is behind.
    /// </summary>
    // The strings on the right are rail labels, not InterviewStep names — each step's own name minus
    // "Agent" happens to be its rail label today, but nothing ties the two together structurally the
    // way PassPromptIds ties a step to its prompt ID, so a step renamed without its rail label (or
    // the other way round) would drift here silently.
    //
    // Pattern matching, so order decides: the first arm that fits wins.
    private string? Behind => State switch
    {
        // ReadyForReview only surfaces here at AgentFormatting now, for both jobs alike: composing or
        // editing, AnswerAsync's loop drains it immediately at every earlier pass by carrying a
        // settled one straight into the next. So this arm no longer needs a Revision check to tell
        // the two apart — reaching AgentFormatting ready for review means the same thing either way,
        // and this button reopens that very section rather than stepping back to the one before it,
        // exactly like every other arm below, so it is named the same way they are.
        { Pass: InterviewStep.AgentFormatting, ReadyForReview: true } => "Back to Formatting",

        // The map is the first thing there is. Behind it is only the landing.
        { Pass: InterviewStep.DomainMapper } => null,

        // Leaving an edit's very first step exits to the walk it was opened from, named by the agent
        // rather than by a section — a bigger move than stepping between two steps of one. A fresh
        // compose's Target has no agent behind it, only the map or the entry before it, below.
        { Pass: InterviewStep.AgentTarget, Revision: not null } => $"Back to {Named(State.Intent)}",

        { Pass: InterviewStep.AgentTarget, At: 0 } => "Back to Domain Mapping",
        { Pass: InterviewStep.AgentTarget } => $"Back to {Named(State.Map[State.At - 1])}",
        { Pass: InterviewStep.AgentPersonality } => "Back to Target",
        { Pass: InterviewStep.AgentToolkit } => "Back to Personality",
        { Pass: InterviewStep.AgentInstructions } => "Back to Toolkit",
        _ => "Back to Instructions"
    };

    /// <summary>
    /// The client's own word for an entry: its button once it has one, its name until then.
    /// </summary>
    private static string Named(IntentDraft intent) => intent.Label ?? intent.Name ?? "the one before";
}
