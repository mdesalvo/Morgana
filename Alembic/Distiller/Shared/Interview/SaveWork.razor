@*
    Taking the work away, in one gesture and one file.

    It is the only thing between a client and losing an afternoon: the interview lives in a Blazor
    circuit, nothing is persisted and nothing is resumed, so this file is the whole of what survives
    closing the tab. That is why it stands with the two movements of the interview rather than off in
    the page's furniture — same row, same size, reached without looking for it.

    What it hands over is the state at the click: the Draft is serialized when the button is pressed,
    never in advance, so there is no window in which the file and the interview disagree. If that
    fails — a Draft caught mid-write — it falls back to the newest autosave, at worst a few seconds
    behind. The client gets a file either way.

    AND IT READS THE FILE BACK. What appears after the press is not a report of what Alembic meant to
    save: it is the downloaded bytes, parsed again, counted in the client's own nouns. A save button
    that silently hands over an empty file is the worst thing in this program, because the person who
    finds out is the one who trusted it — and no reassurance drawn from the interview's own state
    could have caught that, since the interview's state was fine. Only the file was empty.
*@

<div class="keeping">
    <button type="button" class="primary keep" @onclick="HandOver" disabled="@(Busy || kept is not null)"
            title="Downloads alembic-draft.json. Bring it back to the first screen to carry on where you left off.">
        @(kept is null ? "Save my work" : "Saved")
    </button>

    @if (kept is { } receipt)
    {
        @*
            A receipt, not a notice: it says what is in the file that just landed in their downloads,
            in the words they gave it — so "I saved twice and lost everything" becomes something they
            can see going wrong at the moment it goes wrong.
        *@
        <div class="receipt" role="status">
            <span class="what">@receipt.What</span>
            <span class="where">@receipt.Where</span>
            <span class="how-big">@receipt.HowBig</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The circuit's own Draft under construction, and the autosave snapshots taken of it — the
    /// two sources <see cref="HandOver"/> falls back between.
    /// </summary>
    [Inject]
    private IDraftStateService DraftStateService { get; set; } = default!;

    /// <summary>
    /// Used only by <see cref="ReadBack"/>, to parse the just-downloaded bytes back into a Draft
    /// for the receipt — never to produce the bytes handed to the browser, which come from
    /// <see cref="DraftStateService"/> already serialized.
    /// </summary>
    [Inject]
    private IDraftSerializationService DraftSerializationService { get; set; } = default!;

    /// <summary>
    /// Carries the file to the browser via the <c>alembicSave</c> interop function.
    /// </summary>
    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    /// <summary>
    /// Whether the interview is mid-turn, in which case this waits like everything else.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// The name the file is saved under, and the one the landing page expects back.
    /// </summary>
    private const string FileName = "alembic-draft.json";

    /// <summary>
    /// How long the receipt stands before the button goes back to offering to save.
    /// </summary>
    private static readonly TimeSpan Shown = TimeSpan.FromSeconds(8);

    /// <summary>
    /// What the file that just left holds: what is in it, where it stopped, how big it is.
    /// </summary>
    private record Receipt(string What, string Where, string HowBig);

    /// <summary>
    /// The receipt for the file most recently handed over, shown for <see cref="Shown"/> and then
    /// cleared so the button goes back to offering to save. <c>null</c> both before the first save
    /// and once the receipt has timed out.
    /// </summary>
    private Receipt? kept;

    /// <summary>
    /// Hands the work over: this moment if it can be had, the last autosave if it cannot.
    /// </summary>
    /// <remarks>
    /// The bytes go to the browser through one JS call rather than sitting in the markup as a
    /// data: URI, so they cross the wire when somebody asks for them instead of on every turn.
    /// </remarks>
    private async Task HandOver()
    {
        byte[]? work = DraftStateService.Snapshot() ?? DraftStateService.Latest();

        if (work is null)
        {
            kept = new Receipt("Nothing saved", "there is no work in hand yet", string.Empty);
        }
        else
        {
            await JS.InvokeVoidAsync("alembicSave", FileName, Convert.ToBase64String(work));
            kept = await ReadBack(work);
        }

        StateHasChanged();

        await Task.Delay(Shown);

        kept = null;
        StateHasChanged();
    }

    /// <summary>
    /// Reads the downloaded bytes back into a Draft and says what is in them.
    /// </summary>
    /// <remarks>
    /// The file rather than the interview, deliberately: this is the one check that would have
    /// caught a save handing back an empty document while the interview on screen was perfectly
    /// healthy. What it counts is what the client would count — kinds of request on the map, agents
    /// finished, which one is in hand — and never a field name.
    /// </remarks>
    private async Task<Receipt> ReadBack(byte[] work)
    {
        using MemoryStream stream = new MemoryStream(work);

        if (await DraftSerializationService.DeserializeAsync(stream) is not { } saved)
            return new Receipt("Saved, but unreadable", "the file could not be parsed back", Sized(work.Length));

        InterviewSitting? sitting = saved.Sitting;

        int mapped = sitting?.Map.Count ?? 0;
        int written = saved.Agents.Count;

        string what = mapped == 0 && written == 0
            ? "Nothing of the domain yet"
            : $"{Counted(mapped, "kind of request", "kinds of request")} mapped, {Counted(written, "agent", "agents")} finished";

        string where = sitting is { At: >= 0 } && sitting.At < sitting.Map.Count
            ? $"in hand: {Named(sitting.Map[sitting.At])}, at {Step(sitting.Pass)}"
            : "in hand: the map itself";

        return new Receipt(what, where, Sized(work.Length));
    }

    /// <summary>
    /// The client's own word for an entry: its button once it has one, its name until then.
    /// </summary>
    private static string Named(IntentDraft intent) => intent.Label ?? intent.Name ?? "this one";

    /// <summary>
    /// The step, named as the rail names it.
    /// </summary>
    private static string Step(InterviewStep pass) => pass switch
    {
        InterviewStep.DomainMapper => "the map",
        InterviewStep.AgentTarget => "Target",
        InterviewStep.AgentPersonality => "Personality",
        InterviewStep.AgentToolkit => "Toolkit",
        InterviewStep.AgentInstructions => "Instructions",
        InterviewStep.DomainColleagues => "the colleagues",
        _ => "Formatting"
    };

    private static string Counted(int how, string one, string many) => $"{how} {(how == 1 ? one : many)}";

    /// <summary>
    /// The file's size, in the unit somebody reads a file size in.
    /// </summary>
    private static string Sized(int bytes) =>
        bytes >= 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes} bytes";
}
