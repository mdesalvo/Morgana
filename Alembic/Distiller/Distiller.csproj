<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
       <Title>Distiller</Title>
       <PackageId>Distiller</PackageId>
       <RootNamespace>Distiller</RootNamespace>
       <!--
         The project is Distiller; the product it builds is still Alembic. The deployed binary,
         Docker image and OCI labels all stay "Alembic" — only this source project's own identity
         changed when Alembic/ became a container for Distiller/ (this) and PromptHarness/.
       -->
       <AssemblyName>Alembic</AssemblyName>
       <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
       <!--
         Same UserSecretsId as Morgana.Web, on purpose and for the same reason PromptHarness
         shares it: Alembic owns no secrets of its own. It reads the very same `Morgana:LLM:*`
         section (MorganaLLM hardcodes that path), so in-repo it runs against whatever provider
         and tiers this working copy is already wired to, with nothing to configure twice.
         A client deploying Alembic on its own supplies that section by environment variable.
       -->
       <UserSecretsId>374228be-4f26-4382-a3ef-7500a0b829dd</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
       <!--
         Alembic's own conducting prose, embedded exactly the way morgana.json is embedded in
         Morgana.AI — same mechanism, same Records.PromptCollection shape, same four sections.
         Dogfooding: whoever tunes Alembic does the job Alembic teaches.
       -->
       <EmbeddedResource Include="alembic.json" />

       <!--
         Alembic's harness component: one YAML template per behavioural use-case worth protecting in
         any domain — a boundary refused, an irreversible action confirmed, a subject that is not
         there — with every domain word left as a placeholder. At the end of the journey each one is
         derived against the domain just authored, and what comes out is 100% that domain's.

         Authored here and owned here. Nothing is linked or copied from PromptHarness: its suite
         tests framework policy, which is precisely the half a client must never duplicate, so there
         is nothing in it to derive a domain scenario from. The templates carry the harness's shape
         because they were written against it, not because they are pieces of it.

         Globbed rather than listed: adding a use-case is a file in this folder and nothing else.
       -->
       <EmbeddedResource Include="Harness\Templates\*.yaml" />
    </ItemGroup>

    <ItemGroup>
       <!--
         Parses a derivation the way the harness would, so a key the model invented is named here
         instead of dropped in silence there — ScenarioLoader ignores what it does not recognise,
         and a scenario that runs, passes and asserts nothing is the worst artifact to hand anybody.
       -->
       <PackageReference Include="YamlDotNet" Version="18.*" />
    </ItemGroup>

    <ItemGroup>
       <!--
         Morgana.AI, not Morgana.Contracts: Alembic is not a channel and exchanges no wire DTOs.
         What it needs is the domain model of a Morgana configuration — Records.Prompt,
         Records.ToolDefinition, Records.Intent — plus IPromptComposerService, which lets it show
         the client the prompt the model will really read. Morgana.Contracts comes transitively.
       -->
       <ProjectReference Include="..\..\Morgana\Morgana.AI\Morgana.AI.csproj" />
    </ItemGroup>

</Project>
