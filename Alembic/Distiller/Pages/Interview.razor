@page "/interview"
@inject IInterviewService InterviewService
@inject IDraftStateService DraftStateService
@inject NavigationManager NavigationManager

@*
    The interview, and this page owns none of its pieces: the journey across the top, the question,
    and the agent's rows along the foot are each their own component under Shared/Interview. What is
    left here is the only thing that is genuinely this page's — driving the state machine and
    deciding where the client goes when the map is spent.

    There is no transcript on the screen, and remembering the conversation is not the client's job
    either: it is the agent's, and it has a live AgentSession that is the real record. A second copy
    beside it would be a log to keep in step with one that already exists, in exchange for a panel
    saying what the client has just finished saying.

    Opening this page is what lights the burner. Arriving here is already the client saying what they
    came to do, so a screen that describes the interview and offers to begin it is a door in front of
    a door.

    Nothing on this page advances the interview by itself. The model decides which question comes
    next and when a step is behind it; the state machine confirms that before agreeing. The client is
    asked about their work and never about Alembic's structure, which is why the steps are named in
    their words and the word "pass" appears nowhere they can see it.
*@

<div class="alembic-page">

    @if (InterviewService.Current is not { } interviewState)
    {
        <div class="scene">
            <div class="thinking"><span>&bull;</span><span>&bull;</span><span>&bull;</span></div>
        </div>
    }
    else
    {
        <Journey State="interviewState" Established="Established" Written="Written(interviewState)" />

        @*
            The way back travels with whatever is on the table — the answer or the commit — and is a
            button of the same size beside it, because going back is the one movement of the interview
            the client decides.
        *@
        @if (Written(interviewState))
        {
            <AgentWritten State="interviewState" Busy="isBusy" OnAccept="AcceptAsync">
                <Back>
                    <StepBack State="interviewState" Busy="isBusy" OnBack="BackAsync" />
                </Back>
                <Keep>
                    <SaveWork Busy="isBusy" />
                </Keep>
            </AgentWritten>
        }
        else
        {
            <Question Asked="@(interviewState.Question ?? "…")"
                      Prompting="@Prompting(interviewState)"
                      Choice="Offered(interviewState)"
                      Traits="interviewState.Traits"
                      Taken="interviewState.TraitsTaken"
                      Busy="isBusy"
                      Turn="interviewState.Exchanges"
                      OnAnswer="SendAsync"
                      OnChoose="ChooseAsync">
                <Back>
                    <StepBack State="interviewState" Busy="isBusy" OnBack="BackAsync" />
                </Back>
                <Keep>
                    <SaveWork Busy="isBusy" />
                </Keep>
            </Question>
        }

        @if (interviewState.Error is not null)
        {
            <p class="severity-error">@interviewState.Error</p>
        }

    }

</div>

@code {
    private bool isBusy;
    private bool started;

    /// <summary>
    /// The agent whose section the client came to rewrite, when they arrived from the walk rather
    /// than to write something new.
    /// </summary>
    /// <remarks>
    /// In the address, because what it names is their own gesture — this agent, this section — and it
    /// has to survive the reload a Blazor Server circuit does not. It is also why the two are one
    /// page: an edit is the same interview entered partway down, and a second page would be a copy of
    /// this one with the map taken out.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "revise")]
    public string? Revise { get; set; }

    /// <summary>
    /// Where on the walk they were standing, so finishing here puts them back on that screen rather
    /// than at its first agent.
    /// </summary>
    [SupplyParameterFromQuery(Name = "back")]
    public int? Walked { get; set; }

    /// <summary>
    /// Where the client goes when there is nothing more to do here: back onto the walk if that is
    /// where they came from, and to the finished domain otherwise.
    /// </summary>
    private string Leaving => Walked is { } at ? $"revise?at={at}" : "review";

    /// <summary>
    /// What the domain held before this interview: earlier sittings and uploaded configurations.
    /// </summary>
    /// <remarks>
    /// Anything on today's map is left out, agents committed a minute ago included — the map shows
    /// those in their own place, and a name in both strips reads as two intents. The fallback is left
    /// out for a different reason: it is in every domain, no agent answers it, and it is not a step
    /// of anybody's work.
    /// </remarks>
    private IEnumerable<IntentDraft> Established =>
        (DraftStateService.Current?.Intents ?? [])
            .Where(i => !string.Equals(i.Name, DomainDraft.FallbackIntent, StringComparison.OrdinalIgnoreCase))
            .Where(i => InterviewService.Current?.Map.Any(m =>
                            string.Equals(m.Name, i.Name, StringComparison.OrdinalIgnoreCase)) != true);

    /// <summary>
    /// Whether the agent is done here and waiting to be let into the domain.
    /// </summary>
    /// <remarks>
    /// The last of the five steps, whichever job this is: composing, the agent does not exist until
    /// all of it does; editing, the chain walks the same five before it, so an agent is never handed
    /// back with only one section rechecked.
    /// </remarks>
    private static bool Written(InterviewState interviewState) =>
        interviewState is { ReadyForReview: true, Pass: InterviewStep.AgentFormatting };

    /// <summary>
    /// The worked example in the answer box: the model's, or the house one on the very first question.
    /// </summary>
    // An example rather than a label: somebody who has just been asked a question does not yet know
    // what a good answer looks like, and naming the material only restates the question. What it
    // shows is the register, the length and the level of detail at once.
    //
    // Every example past the first is the model's, because by then it has read the map and can write
    // one in the client's own trade about the agent being built — which is what makes it something
    // to cut about rather than a stranger's business quoted at them.
    //
    // The opening question of the map is the exception, and the one below is deliberately not the
    // model's. Nothing is known about this client yet, so it would be inventing a hypothetical
    // domain exactly as this does — but differently every run, unverifiable, on the screen that sets
    // the register for the whole interview.
    //
    // It stands only while nothing is known: a client who arrived with an agents.json has a trade on
    // the table, the mapping pass can call SetExample from it, and what it writes wins here.
    private const string HouseExample =
        "We run a small bike repair shop. Customers bring in the bike, we give them a quote, "
        + "then we repair it and let them know when it's ready.";

    private static string Prompting(InterviewState interviewState) =>
        interviewState.Example
        ?? (interviewState is { Pass: InterviewStep.DomainMapper, PassJustOpened: true }
                ? HouseExample
                : string.Empty);

    /// <summary>
    /// The choices attached to the question being asked right now, if any.
    /// </summary>
    /// <remarks>
    /// A choice belongs to the question it was asked with, so the row goes the moment one is
    /// pressed: what stands after that is the next question, and offering an answer to something
    /// already settled is worse than offering nothing.
    /// </remarks>
    private static QuickReply? Offered(InterviewState interviewState) =>
        interviewState.Chosen ? null : interviewState.Choice;

    /// <summary>
    /// Sends a choice as the answer, and records which one was pressed.
    /// </summary>
    /// <remarks>
    /// Recorded before the round trip, so the button lights the instant it is clicked rather than
    /// after the model answers. Without it the screen shows an answer nobody typed and no trace of
    /// the gesture that produced it.
    /// </remarks>
    private Task ChooseAsync(QuickReply choice)
    {
        if (InterviewService.Current is { } interviewState)
            interviewState.Chosen = true;

        return SendAsync(choice.Value);
    }

    /// <summary>
    /// Sends a typed answer for the current question and waits for the next turn of the interview.
    /// </summary>
    private async Task SendAsync(string said)
    {
        isBusy = true;

        try
        {
            await InterviewService.AnswerAsync(said);

            // The closing step is the one that ends here rather than on a button: nothing is waiting
            // to be let into the domain — every agent is in it already — so the answer that settles
            // the colleagues also puts the interview behind them, and what is left is the finished
            // domain. An interview that has ended leaves nothing on this page to stand on.
            if (InterviewService.Current is null)
                NavigationManager.NavigateTo(Leaving);
        }
        finally { isBusy = false; }
    }

    /// <summary>
    /// Steps back to the previous part of the interview.
    /// </summary>
    private async Task BackAsync()
    {
        isBusy = true;

        try
        {
            if (await InterviewService.BackAsync())
                return;

            // Nothing behind it, which on an edit means the first step of the one agent in hand. That
            // agent is out of the domain while it is being worked on, so leaving has to put it back
            // — a client who opened the wrong section and pressed back must not be the reason an
            // agent is missing from their own configuration.
            if (InterviewService.Current?.Revision is not null)
            {
                await InterviewService.AcceptAsync();
                NavigationManager.NavigateTo(Leaving);
            }
        }
        finally { isBusy = false; }
    }

    /// <summary>
    /// Lights the burner on arrival.
    /// </summary>
    /// <remarks>
    /// Here rather than in <c>OnInitializedAsync</c> because the first turn of an interview is a
    /// model call on the Performance tier, and this is the first place the circuit is known to be
    /// live and the screen already drawn — so the client sees the burner lit rather than a page that
    /// arrives once the model has finished thinking. The flag keeps a re-render from starting a
    /// second one.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || started || InterviewService.Current is not null)
            return;

        started = true;
        isBusy = true;
        StateHasChanged();

        try
        {
            // An agent named in the address is one the client picked off their own domain, so there
            // is nothing to fall back to when it is not there: starting a fresh interview instead
            // would answer a gesture about one agent by offering to write another.
            if (Revise is { Length: > 0 } revised)
            {
                if (!await InterviewService.ReviseAsync(revised))
                    NavigationManager.NavigateTo(Leaving);
            }
            else
            {
                await InterviewService.StartAsync();
            }
        }
        finally { isBusy = false; }

        StateHasChanged();
    }

    /// <summary>
    /// Lets the finished agent into the domain, and goes on to the next entry of the map.
    /// </summary>
    /// <remarks>
    /// The review is where the interview ends, not where each agent lands: an agent is only worth
    /// weighing against the others once the others exist, and a report between every two entries of
    /// the map turns one interview into a series of errands.
    /// </remarks>
    private async Task AcceptAsync()
    {
        isBusy = true;

        try
        {
            // An edit puts one agent back and is over — its map was one entry. Where that lands is
            // the walk it came from, on the same agent, now reading what was just changed: the client
            // corrected one thing and is still going over their domain.
            if (!await InterviewService.AcceptAsync())
                NavigationManager.NavigateTo(Leaving);
        }
        finally { isBusy = false; }
    }
}
