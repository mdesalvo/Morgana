@page "/morganize"
@using Distiller.Services
@using Morgana.AI.Attributes
@using Morgana.AI.Services
@inject IDraftStateService DraftStateService
@inject IDraftValidationService DraftValidationService
@inject IMigrationReportService MigrationReportService
@inject IAssetPackageService AssetPackageService
@inject ICodeEmitService CodeEmitService
@inject ILogger Logger
@inject IJSRuntime JS
@implements IDisposable

@*
    Morganize. The turnkey end of the workbench: the whole domain leaves as one archive,
    because the pieces are only correct together.

    Three things settle before it can be built, and none of them is in agents.json: the namespace,
    each agent's tier, and — where an agent has no native tools — nothing at all. The validator has
    been calling these "Alembic's guess" since phase 4; this is the page that stops them being one.

    A fourth belongs here for the same reason: which agents reach further capability through an MCP
    server at runtime. That is a C# fact (AgentCodeFacts.MCPServers), never a domain question — the
    interview never asks it, because "MCP server" is a concept from whoever configures Morgana, not
    from the domain expert describing their work.

    A fifth sits here on a different argument. Which colleagues an agent may consult IS a domain
    question, and the interview's closing step asks it properly — reconciling the boundary prose an
    edge contradicts, which is the half that matters and the half only that step can do. But an
    uploaded agents.json carries no C# at all, so a domain that arrives and is only walked never
    reaches that step, and every other C# fact it needs is already settled on this page. So the edge
    is settleable here too, as the fact it is; the prose is not touched, and the coherence pass on
    Review is what reports an agent left saying it cannot answer what its new colleague answers.
*@

<div class="alembic-page">

    <FinalizationRail At="1" />

    @if (DraftStateService.Current is not { } draft)
    {
        <div class="panel">
            <h2>Nothing to morganize</h2>
            <p>Import an <code>agents.json</code> or run an interview first.</p>
            <p><a href="import">Go to import &rarr;</a></p>
        </div>
    }
    else
    {
        @if (errors.Count > 0)
        {
            <div class="panel">
                <h2>Not yet</h2>
                <p class="severity-error">
                    @errors.Count @(errors.Count == 1 ? "error stops" : "errors stop") this domain from
                    starting, so there is nothing worth generating from it.
                </p>
                <ul>
                    @foreach (ValidationFinding finding in errors)
                    {
                        <li><code>@finding.Where</code> &mdash; @finding.Message</li>
                    }
                </ul>
                <p class="muted">
                    A required parameter behind an optional one is the one that would also emit C#
                    that does not compile: the generated signature follows the configuration's own
                    order, and never quietly reorders it.
                </p>
                <p><a href="review">See them all &rarr;</a></p>
            </div>
        }
        else
        {
            <div class="panel">
                <h2>What the interview cannot say</h2>

                @* The client has spent the whole interview describing their own work in their own
                   words. This panel is the one place that asks for something else — facts about the
                   C# Alembic is about to write — so it says so plainly before asking, rather than
                   letting four unfamiliar words be the first thing on the screen. *@
                <p class="panel-intro">
                    Everything so far came out of the interview. These four did not: they describe the
                    <b>C# code</b> Alembic is about to write for you, not the work your agents do.
                    Nobody asked you during the interview because they belong to whoever installs
                    Morgana rather than to the person who knows the business. Every one already has a
                    sensible answer &mdash; change them only if your team has its own conventions.
                </p>

                @* The one field on this page that reaches every generated file, so it is given the
                   room that says so rather than sitting inline like a filter box. *@
                <div class="field">
                    <label for="ns">Namespace</label>
                    <input id="ns" class="mono" spellcheck="false" autocomplete="off"
                           placeholder="@Distiller.Services.CodeEmitService.DefaultNamespace"
                           @bind="rootNamespace" @bind:event="oninput" />
                    @if (NamespaceProblem is { } problem)
                    {
                        <p class="field-note severity-error">@problem</p>
                    }
                    else
                    {
                        <p class="field-note muted">
                            C# files every class under one, and this is the name your team gives this
                            plugin's code. It prefixes everything Alembic writes
                            @* Shown against a real class of this domain or not at all: a stand-in
                               name here would be one more identifier on a screen already full of
                               them, and the only one that is not going to exist. *@
                            @if (draft.Agents.FirstOrDefault(a => a.Code.AgentClassName is not null) is { } named)
                            {
                                <text>&mdash; yours will read <code>@($"{EffectiveNamespace}.Agents.{named.Code.AgentClassName}")</code></text>
                            }
                            else
                            {
                                <text>, under <code>@EffectiveNamespace</code>.</text>
                            }
                        </p>
                    }
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th>Die <span class="th-note">which model it thinks with</span></th>
                            <th>Classes <span class="th-note">what Alembic will name its code</span></th>
                            <th>MCP <span class="th-note">servers it connects to at runtime for extra tools</span></th>
                            <th>Colleagues <span class="th-note">other agents it may put a question to</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AgentDraft agent in draft.Agents)
                        {
                            <tr>
                                <td><code>@agent.ID</code></td>
                                <td>
                                    <select value="@agent.Code.Tier"
                                            @onchange="e => SetTier(agent, e)">
                                        <option value="@Records.LLMTier.Efficiency">Efficiency</option>
                                        <option value="@Records.LLMTier.Performance">Performance</option>
                                    </select>
                                </td>
                                <td class="muted">
                                    <code>@(agent.Code.AgentClassName ?? "—")</code>
                                    @if (agent.Tools.Count > 0)
                                    {
                                        <text>, <code>@(agent.Code.ToolClassName ?? "—")</code></text>
                                    }
                                    else
                                    {
                                        <text> &mdash; no tool class: nothing native to back</text>
                                    }
                                </td>
                                <td>
                                    @* The header carries the sentence once. Repeating it per row put
                                       the same nineteen words beside every agent and left the switch
                                       itself the least visible thing in its own cell. *@
                                    <label class="switch">
                                        <input type="checkbox"
                                               checked="@(agent.Code.MCPServers.Count > 0)"
                                               @onchange="e => ToggleMcp(agent, e)" />
                                        <span>Reaches MCP servers</span>
                                    </label>

                                    @if (agent.Code.MCPServers.Count > 0)
                                    {
                                        <div class="mcp-servers">
                                            @for (int i = 0; i < agent.Code.MCPServers.Count; i++)
                                            {
                                                int index = i;
                                                McpTestResult test = GetMcpTest(agent, index);
                                                bool malformed = !string.IsNullOrWhiteSpace(agent.Code.MCPServers[index])
                                                                 && !IsAbsoluteHttpUri(agent.Code.MCPServers[index]);

                                                <div class="mcp-server">
                                                    <div class="mcp-server-row">
                                                        <input type="url" class="mono"
                                                               value="@agent.Code.MCPServers[index]"
                                                               placeholder="https://…"
                                                               spellcheck="false" autocomplete="off"
                                                               @oninput="e => SetMcpServer(agent, index, e)" />
                                                        <button type="button" class="agent-pick"
                                                                disabled="@(test.Status == McpTestStatus.Testing || malformed)"
                                                                @onclick="() => TestMcpServer(agent, index)">
                                                            @(test.Status == McpTestStatus.Testing ? "Testing…" : "Test")
                                                        </button>
                                                        <button type="button" class="agent-pick icon"
                                                                title="Remove this server"
                                                                @onclick="() => RemoveMcpServer(agent, index)">
                                                            &times;
                                                        </button>
                                                    </div>

                                                    @* Said in full under the field rather than hidden
                                                       in a tooltip: the detail IS the answer — which
                                                       tools it advertises, or why it could not be
                                                       reached — and a title attribute is the one place
                                                       nobody reads it from. *@
                                                    @if (malformed)
                                                    {
                                                        <p class="field-note severity-error">Not an absolute http(s) URI.</p>
                                                    }
                                                    else if (test.Status == McpTestStatus.Ok)
                                                    {
                                                        <p class="field-note severity-ok">✓ live &mdash; @test.Detail</p>
                                                    }
                                                    else if (test.Status == McpTestStatus.Failed)
                                                    {
                                                        <p class="field-note severity-error">✗ unreachable &mdash; @test.Detail</p>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <button type="button" class="agent-pick" @onclick="() => AddMcpServer(agent)">
                                            + Add another
                                        </button>
                                    }
                                </td>
                                <td>
                                    @* One switch per other agent, not a free field: a colleague on THIS
                                       Morgana is an intent this domain already handles, and
                                       [ConsultsAgent] naming anything else is startup-fatal. Offering
                                       what cannot be wrong is cheaper than validating what can. The
                                       free fields below are for the case where nothing here can be
                                       right or wrong, because the desk answering is somebody else's. *@
                                    @{
                                        AgentDraft[] colleagues = [.. draft.Agents.Where(a =>
                                            !string.IsNullOrWhiteSpace(a.ID)
                                            && !string.Equals(a.ID, agent.ID, StringComparison.OrdinalIgnoreCase))];
                                    }

                                    <p class="colleague-scope">On this Morgana</p>

                                    @if (colleagues.Length == 0)
                                    {
                                        <span class="muted">&mdash; nobody to ask</span>
                                    }
                                    else
                                    {
                                        @foreach (AgentDraft colleague in colleagues)
                                        {
                                            string named = colleague.ID!;
                                            <label class="switch">
                                                <input type="checkbox"
                                                       checked="@Consults(agent, named)"
                                                       @onchange="e => ToggleColleague(agent, named, e)" />
                                                <span><code>@named</code></span>
                                            </label>
                                        }
                                    }

                                    @* The other half of the same question: on WHICH Morgana that desk
                                       answers. Everything above answers "this one" — the domain in
                                       front of you — and everything here answers "another one", where
                                       both names are the partner's word and neither can be checked
                                       from here. It is a free field for exactly that reason. *@
                                    <div class="partner-colleagues">
                                        <p class="colleague-scope remote">On another Morgana</p>

                                        @for (int i = 0; i < agent.Code.Consults.Count; i++)
                                        {
                                            int index = i;

                                            if (agent.Code.Consults[index].Partner is null)
                                                continue;

                                            <div class="partner-colleague-row">
                                                <input type="text" class="mono"
                                                       value="@agent.Code.Consults[index].Intent"
                                                       placeholder="intent"
                                                       spellcheck="false" autocomplete="off"
                                                       @oninput="e => SetPartnerColleagueIntent(agent, index, e)" />
                                                <span class="muted">at</span>
                                                <input type="text"
                                                       value="@agent.Code.Consults[index].Partner"
                                                       placeholder="partner"
                                                       spellcheck="false" autocomplete="off"
                                                       @oninput="e => SetPartnerColleaguePartner(agent, index, e)" />
                                                <button type="button" class="agent-pick icon"
                                                        title="Remove this colleague"
                                                        @onclick="() => RemovePartnerColleague(agent, index)">
                                                    &times;
                                                </button>
                                            </div>
                                        }

                                        <button type="button" class="agent-pick" @onclick="() => AddPartnerColleague(agent)">
                                            + On another Morgana
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <p class="muted">
                    A colleague at another Morgana is named twice over &mdash; the intent, and the partner
                    publishing it &mdash; and neither name is checked here or at startup, because the only
                    thing that knows is that partner's own agent card, read on the first consultation.
                    The partner itself must be declared in the deployment's configuration under
                    <code>Morgana:AgentToAgent:Partners</code>, spelled exactly as it is here; the
                    migration report in the archive says so again, with the address and key it
                    deliberately does not carry.
                </p>

                <p class="muted">
                    A colleague ticked here changes what an agent <em>can</em> do and not a word of what
                    its own prose <em>says</em> — so an agent whose instructions still send the customer
                    to another desk for that very subject will keep doing exactly that, and the
                    consultation is paid for in prompt tokens and never happens. Run
                    <b>colleagues out of step</b> on Review, which is the pass that reads the two
                    against each other. The interview's own closing step does both at once, and is
                    where this belongs when a domain is being written rather than uploaded.
                </p>
            </div>

            <div class="panel">
                <h2>Migration</h2>
                <p class="muted">
                    @if (report.BaselineName is null)
                    {
                        <text>Nothing was uploaded into this session, so everything here is new.</text>
                    }
                    else
                    {
                        <text>
                            Against <code>@report.BaselineName</code>. Alembic never sees your tree,
                            so nothing is applied for you &mdash; this names every difference
                            precisely enough to apply by hand.
                        </text>
                    }
                </p>

                @if (report.Entries.Count == 0)
                {
                    <p>Nothing changed.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th></th><th>Where</th><th>What it costs you</th></tr>
                        </thead>
                        <tbody>
                            @foreach (MigrationEntry entry in report.Entries)
                            {
                                <tr>
                                    <td class="@(Compiled(entry.Change) ? "severity-error" : "severity-warning")">
                                        @entry.Change.ToString().ToLowerInvariant()
                                    </td>
                                    <td><code>@entry.Where</code></td>
                                    <td>@entry.Detail</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="panel">
                <h2>Code Generation</h2>
                <p class="muted">
                    Your domain is ready to be distilled. Press the button below and wait for it to finish: depending on the domain's size, it may take up to several minutes.
                </p>

                <details class="harness-section">
                    <summary>Generate PromptHarness &mdash; optional</summary>

                    <p>
                        <label>
                            <input type="checkbox" @bind="includeScenarios" />
                            Include the harness scenarios
                        </label>
                        <span class="muted">
                            &mdash; one more call per agent. An agent's whole behavior lives in the
                            prose you just built; whenever someone edits it later, these are the test
                            conversations that get replayed to catch what that edit broke.
                        </span>
                    </p>

                    <div class="power-notice">
                        <svg class="sigil" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                        </svg>
                        <div>
                            <strong>PromptHarness requires a local source checkout of Morgana.</strong>
                            It cannot connect to deployed instances, containers, or managed environments.
                            <ul>
                                <li><strong>Check this box</strong> ONLY if your team hosts or customizes the Morgana source code directly within your own DevOps.</li>
                                <li><strong>Leave it unchecked</strong> if you do not have the source code — no scenario files will be written this time. Come back and check it once your setup changes; nothing about the rest of this archive depends on it.</li>
                            </ul>
                        </div>
                    </div>
                </details>

                @if (package is null && !isBuilding)
                {
                    @if (stoppedNotice is not null)
                    {
                        <p class="muted stopped-notice">@stoppedNotice</p>
                    }
                    <button class="primary" @onclick="BuildAsync"
                            disabled="@(HasInvalidMcpServer(draft) || NamespaceProblem is not null)">
                        Build the archive
                    </button>
                    @if (NamespaceProblem is not null)
                    {
                        <p class="severity-error">
                            Fix the namespace above before building &mdash; it is declared in every
                            generated file, so the archive would not compile.
                        </p>
                    }
                    else if (HasInvalidMcpServer(draft))
                    {
                        <p class="severity-error">
                            Fix or remove the MCP server URLs above before building.
                        </p>
                    }
                }
                else if (isBuilding)
                {
                    <div class="distillation">
                        <svg class="distillation-vessel" viewBox="0 0 64 88" role="img" aria-label="Distilling">
                            <defs>
                                <clipPath id="belly-clip">
                                    <circle cx="29" cy="55" r="15.2" />
                                </clipPath>
                            </defs>

                            @* The neck: extended all the way down to where each line meets the belly's own
                               outline (x=25.2/32.8 crosses the r=15.2 circle at y≈40.3), so the cap sits on
                               a continuous vessel rather than floating over a gap above the belly. *@
                            <path d="M25.2 40.3 V13 M32.8 40.3 V13" fill="none" stroke="var(--alembic-border-lit)" stroke-width="3.4" stroke-linecap="round" />
                            <rect x="21.8" y="10" width="14.4" height="4.8" rx="2.4" fill="var(--alembic-border-lit)" />
                            <path d="M40 20.5 H49 A3.2 3.2 0 0 1 52 23.7 V33" fill="none" stroke="var(--alembic-border-lit)" stroke-width="3.4" stroke-linecap="round" />

                            <g clip-path="url(#belly-clip)">
                                <rect x="10" width="38"
                                      y="@((70.2 - FillHeight).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      height="@(FillHeight.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                      style="fill:var(--alembic-accent); transition: y 0.5s ease, height 0.5s ease;" />
                            </g>

                            <circle cx="29" cy="55" r="15.2" fill="none" stroke="var(--alembic-border-lit)" stroke-width="1.8" />
                        </svg>

                        <div class="distillation-status">
                            <p class="distillation-phase">@PhaseLabel</p>
                            <div class="distillation-bar">
                                <div class="distillation-bar-fill" style="width:@(Percent)%"></div>
                            </div>
                            <p class="muted distillation-percent">
                                @Progress(Percent)
                                @if (StepElapsed is { } elapsed)
                                {
                                    <span> &middot; @elapsed on this step</span>
                                }
                            </p>
                        </div>
                    </div>

                    @* Execution is actually two flat passes over every agent — every agent's code and
                       mock, then, later, every agent's scenarios — never one agent finished start to
                       finish before the next begins. A grid reads that truthfully without narrating
                       it: each agent gets its own card and its own done/now/ahead marks, so the eye
                       sees several agents in flight together rather than one linear sentence implying
                       an order that was never real. *@
                    <div class="distillation-agents">
                        @foreach (IGrouping<string, Step> card in AgentCards)
                        {
                            <div class="agent-card">
                                <p class="agent-card-name">@card.First().Label</p>
                                <ul class="agent-card-steps">
                                    @foreach (Step step in card)
                                    {
                                        <li class="@(step.Done ? "stage-done" : step == InProgress ? "stage-current" : "stage-todo")">
                                            <span class="stage-mark @(step == InProgress ? "spin" : "")" aria-hidden="true">
                                                @(step.Done ? "✓" : step == InProgress ? "⟳" : "○")
                                            </span>
                                            @StepKindLabel(step.Kind)
                                        </li>
                                    }
                                </ul>
                                <div class="agent-card-bar">
                                    <div class="agent-card-bar-fill" style="width:@(CardPercent(card))%"></div>
                                </div>
                                <p class="muted agent-card-percent">@Progress(CardPercent(card))</p>
                            </div>
                        }
                    </div>

                    @* The percentage and the log are the same fact at two grains, so they live in the
                       same panel: the bar says how far, this says exactly what just landed, oldest at
                       the top and the newest line at the bottom — the order any log is read in — kept
                       scrolled to that bottom by <c>ScrollLogAsync</c> so the client never has to. *@
                    <ol class="distillation-log" aria-live="polite">
                        @foreach (string path in written)
                        {
                            <li class="log-done">
                                <span class="log-mark" aria-hidden="true">✓</span><code>@path</code>
                            </li>
                        }
                        <li class="log-current">
                            <span class="log-mark spin" aria-hidden="true">⟳</span>Writing @CurrentLogLabel&hellip;
                        </li>
                    </ol>

                    <p class="distillation-stop">
                        <button class="agent-pick" @onclick="Stop" disabled="@isStopping">
                            @(isStopping ? "Stopping…" : "Stop")
                        </button>
                        <span class="muted">Discards everything written so far &mdash; nothing partial is kept.</span>
                    </p>
                }
                else
                {
                    <div class="distillation-done">
                        <p class="distillation-done-headline">Your domain has been distilled with success!</p>
                        <p>
                            Unzip the archive, build the .NET solution in your favorite IDE or with .NET CLI,
                            then drop the resulting assembly into the configured directory of your Morgana's
                            plugins. That's it: Morgana will be ready to fly on this broomstick!
                        </p>
                        <a class="download-archive" download="@ArchiveName" href="@DataUri(package!)">
                            <svg class="download-archive-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
                            </svg>
                            <span class="download-archive-text">
                                <strong>Download @ArchiveName</strong>
                                <span>@written.Count files, @(package!.Length / 1024) KB</span>
                            </span>
                        </a>
                        <p>
                            <button class="agent-pick" @onclick="Reset">Build it again</button>
                        </p>
                    </div>

                    @if (written.Count > 0)
                    {
                        <details class="muted">
                            <summary>@written.Count files written</summary>
                            <ul>
                                @foreach (string path in written)
                                {
                                    <li><code>@path</code></li>
                                }
                            </ul>
                        </details>
                    }
                }

                @if (error is not null)
                {
                    <p class="severity-error">@error</p>
                }
            </div>
        }
    }

    <Back />

</div>

@code {
    /// <summary>Blocking findings against the current Draft; a non-empty list keeps the whole page behind the "Not yet" panel.</summary>
    private IReadOnlyList<ValidationFinding> errors = [];

    /// <summary>What this Draft differs from, computed once in <see cref="OnInitialized"/> and shown in the Migration panel.</summary>
    private MigrationReport report = new(null, [], string.Empty);

    /// <summary>Every path the last <see cref="AssetPackageService.BuildAsync"/> call reported through its <see cref="Progress{T}"/> callback.</summary>
    private readonly List<string> written = [];

    private string rootNamespace = Distiller.Services.CodeEmitService.DefaultNamespace;

    /// <summary>The finished archive, non-null only between a successful <see cref="BuildAsync"/> and the next <see cref="Reset"/>.</summary>
    private byte[]? package;
    private bool includeScenarios;
    private bool isBuilding;
    private string? error;

    /// <summary>Cancels the running <see cref="AssetPackageService.BuildAsync"/> call, live only while <see cref="isBuilding"/> is.</summary>
    private CancellationTokenSource? buildCts;

    /// <summary>True between pressing Stop and the build actually unwinding, so a second press cannot fire a second cancel.</summary>
    private bool isStopping;

    /// <summary>What to say next to the button once a stop has actually landed — cleared the moment a fresh build starts.</summary>
    private string? stoppedNotice;

    private string ArchiveName => $"{rootNamespace.ToLowerInvariant().Replace('.', '-')}-morganized.zip";

    /// <summary>
    /// Whether acting on this change means touching code rather than re-reading a sentence.
    /// </summary>
    private static bool Compiled(MigrationChange change) =>
        change is MigrationChange.Removed or MigrationChange.SignatureChanged;

    protected override void OnInitialized()
    {
        if (DraftStateService.Current is not { } draft)
            return;

        // The die select shows Efficiency the moment nothing is chosen, so the model has to actually
        // hold that the instant the page does — a control bound to a value the client never asked
        // for and never confirmed is a control lying about its own state. Committing it here, before
        // anything is read or built, is what makes "visit the Emit page" in the validator's own
        // warning literally true rather than true only once the select is clicked.
        foreach (AgentDraft agent in draft.Agents)
        {
            agent.Code.Tier ??= Records.LLMTier.Efficiency;
            agent.Code.Inferred = false;
        }

        errors = [.. DraftValidationService.Validate(draft).Where(f => f.Severity == FindingSeverity.Error)];
        report = MigrationReportService.Build(draft);

        // A namespace already stated by one agent is the domain's, not a default to be re-typed.
        if (draft.Agents.FirstOrDefault(a => !string.IsNullOrWhiteSpace(a.Code.Namespace)) is { } stated)
            rootNamespace = stated.Code.Namespace!;
    }

    /// <summary>
    /// Applies the client's choice from the die <c>&lt;select&gt;</c> and invalidates any archive
    /// already built, since it was built against the previous tier.
    /// </summary>
    private void SetTier(AgentDraft agent, ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out Records.LLMTier tier))
            agent.Code.Tier = tier;

        // Stated is no longer guessed, and the validator's warning about it should stop.
        agent.Code.Inferred = false;
        package = null;
    }

    /// <summary>
    /// Whether a string is a well-formed absolute HTTP or HTTPS URI — the shape
    /// <c>UsesMCPServerAttribute</c>'s single-string constructor expects.
    /// </summary>
    private static bool IsAbsoluteHttpUri(string value) =>
        Uri.TryCreate(value, UriKind.Absolute, out Uri? uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    /// <summary>
    /// True while any agent's MCP list holds an empty or malformed entry — the build stays blocked
    /// rather than silently dropping or emitting a broken attribute.
    /// </summary>
    private static bool HasInvalidMcpServer(DomainDraft draft) =>
        draft.Agents.Any(a => a.Code.MCPServers.Any(s => !IsAbsoluteHttpUri(s)));

    /// <summary>What the emit will actually declare: the field when it says something, the default otherwise.</summary>
    private string EffectiveNamespace =>
        string.IsNullOrWhiteSpace(rootNamespace)
            ? Distiller.Services.CodeEmitService.DefaultNamespace
            : rootNamespace.Trim();

    /// <summary>
    /// Why the namespace as typed would not compile, or <c>null</c> while it would.
    /// </summary>
    /// <remarks>
    /// Checked here because this field is the one input on the page that reaches every generated
    /// file: a stray space or a leading digit turns the whole archive into C# that does not build,
    /// which is the single failure Alembic exists to keep a client from meeting.
    /// </remarks>
    private string? NamespaceProblem
    {
        get
        {
            if (string.IsNullOrWhiteSpace(rootNamespace))
                return null;

            foreach (string part in rootNamespace.Trim().Split('.'))
            {
                if (part.Length == 0)
                    return "Empty segment — two dots in a row, or a dot at one end.";

                if (!char.IsLetter(part[0]) && part[0] != '_')
                    return $"\"{part}\" starts with something other than a letter or underscore.";

                if (part.Any(c => !char.IsLetterOrDigit(c) && c != '_'))
                    return $"\"{part}\" holds a character a C# identifier cannot.";
            }

            return null;
        }
    }

    /// <summary>
    /// Checking the box opens one empty row to fill in; unchecking clears the list outright, since
    /// an unchecked box saying "no MCP" next to a stale URL would be a fact contradicting itself.
    /// </summary>
    private void ToggleMcp(AgentDraft agent, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            if (agent.Code.MCPServers.Count == 0)
                agent.Code.MCPServers.Add(string.Empty);
        }
        else
        {
            agent.Code.MCPServers.Clear();
            mcpTests.Remove(agent);
        }

        package = null;
    }

    /// <summary>
    /// Whether this agent already declares that colleague, matched the way Morgana matches an
    /// intent name.
    /// </summary>
    /// <remarks>
    /// Agents of this domain only. The boxes on this page are drawn from the domain, so a colleague
    /// at a partner has none to be ticked in — it is declared in the interview, where the client can
    /// say whose desk it is, and it must survive every toggle here untouched.
    /// </remarks>
    private static bool Consults(AgentDraft agent, string colleague) =>
        agent.Code.Consults.Any(c => c.Partner is null && string.Equals(c.Intent, colleague, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Adds or removes one <c>[ConsultsAgent]</c> declaration, and invalidates any archive already
    /// built — the attribute is on the agent class, so the emitted file is no longer the one on disk.
    /// </summary>
    /// <remarks>
    /// The prose is deliberately left alone. On this page the Instructions are the client's own —
    /// uploaded or written in an interview that already settled them — and Alembic does not rewrite
    /// a sentence nobody asked it to touch. What reads the two against each other is the coherence
    /// pass, which reports rather than repairs, exactly as it does for every other relation.
    /// </remarks>
    private void ToggleColleague(AgentDraft agent, string colleague, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            if (!Consults(agent, colleague))
                agent.Code.Consults.Add(new Morgana.AI.Records.PeerReference(colleague));
        }
        else
        {
            agent.Code.Consults.RemoveAll(c => c.Partner is null && string.Equals(c.Intent, colleague, StringComparison.OrdinalIgnoreCase));
        }

        package = null;
    }

    /// <summary>
    /// Opens a row for a colleague published by another Morgana.
    /// </summary>
    /// <remarks>
    /// Blank on both halves, and deliberately so: an empty partner is what the validator reports, and
    /// guessing either name here would be inventing the one thing only the partner's card knows.
    /// </remarks>
    private void AddPartnerColleague(AgentDraft agent)
    {
        agent.Code.Consults.Add(new Morgana.AI.Records.PeerReference(string.Empty, string.Empty));
        package = null;
    }

    /// <summary>Renames the intent a partner-published colleague answers for.</summary>
    /// <remarks>
    /// The declaration is a record, so it is replaced rather than mutated; the row is addressed by
    /// its index in the agent's own list, which is what the markup iterates.
    /// </remarks>
    private void SetPartnerColleagueIntent(AgentDraft agent, int index, ChangeEventArgs e)
    {
        agent.Code.Consults[index] = agent.Code.Consults[index] with { Intent = e.Value?.ToString() ?? string.Empty };
        package = null;
    }

    /// <summary>Renames the partner publishing a colleague.</summary>
    /// <remarks>
    /// Never emptied back to null here: a row that lost its partner would silently become a
    /// consultation on this Morgana, which is a different declaration and a different attribute.
    /// Removing the row is how a partner colleague is taken back.
    /// </remarks>
    private void SetPartnerColleaguePartner(AgentDraft agent, int index, ChangeEventArgs e)
    {
        agent.Code.Consults[index] = agent.Code.Consults[index] with { Partner = e.Value?.ToString() ?? string.Empty };
        package = null;
    }

    /// <summary>Takes back one colleague published by another Morgana.</summary>
    private void RemovePartnerColleague(AgentDraft agent, int index)
    {
        agent.Code.Consults.RemoveAt(index);
        package = null;
    }

    private void AddMcpServer(AgentDraft agent)
    {
        agent.Code.MCPServers.Add(string.Empty);
        package = null;
    }

    private void RemoveMcpServer(AgentDraft agent, int index)
    {
        agent.Code.MCPServers.RemoveAt(index);

        // Indices above the removed one just shifted down a slot, so any cached result would now
        // be read against the wrong URL — drop the whole agent's cache rather than the one entry.
        mcpTests.Remove(agent);
        package = null;
    }

    private void SetMcpServer(AgentDraft agent, int index, ChangeEventArgs e)
    {
        agent.Code.MCPServers[index] = e.Value?.ToString() ?? string.Empty;

        // The URL changed under it, so a stale ✓/✗ from the previous value would be a lie.
        GetMcpTest(agent, index).Status = McpTestStatus.Idle;
        package = null;
    }

    private enum McpTestStatus { Idle, Testing, Ok, Failed }

    /// <summary>
    /// One MCP URL's last live-test outcome. Kept only in this page's own memory, never on the
    /// Draft: it says something about the network right now, not about the domain being authored.
    /// </summary>
    private sealed class McpTestResult
    {
        public McpTestStatus Status { get; set; } = McpTestStatus.Idle;
        public string? Detail { get; set; }
    }

    /// <summary>Keyed by agent reference and list index — this page's scratch state, not the Draft's.</summary>
    private readonly Dictionary<AgentDraft, Dictionary<int, McpTestResult>> mcpTests = new();

    private McpTestResult GetMcpTest(AgentDraft agent, int index)
    {
        if (!mcpTests.TryGetValue(agent, out Dictionary<int, McpTestResult>? perAgent))
        {
            perAgent = new Dictionary<int, McpTestResult>();
            mcpTests[agent] = perAgent;
        }

        if (!perAgent.TryGetValue(index, out McpTestResult? result))
        {
            result = new McpTestResult();
            perAgent[index] = result;
        }

        return result;
    }

    /// <summary>
    /// Connects to the URL directly and calls ListTools once — the same handshake
    /// <c>MorganaAgentAdapter</c> performs at startup for every <c>[UsesMCPServer]</c>, run here on
    /// demand instead of on a deployed Morgana. Deliberately bypasses the shared connection pool
    /// <c>MCPClientRegistryService</c> would keep for a live agent: this is a one-shot probe, so the
    /// client is disposed the moment the answer is in, whichever it is.
    /// </summary>
    private async Task TestMcpServer(AgentDraft agent, int index)
    {
        string url = agent.Code.MCPServers[index];
        McpTestResult result = GetMcpTest(agent, index);

        if (!IsAbsoluteHttpUri(url))
        {
            result.Status = McpTestStatus.Failed;
            result.Detail = "Not an absolute http(s) URI.";
            return;
        }

        result.Status = McpTestStatus.Testing;
        result.Detail = null;
        StateHasChanged();

        MCPClient? client = null;

        try
        {
            UsesMCPServerAttribute attribute = new(url);
            client = await MCPClient.ConnectAsync(attribute, Logger);
            var tools = await client.DiscoverToolsAsync();

            result.Status = McpTestStatus.Ok;
            result.Detail = $"{tools.Count} tool{(tools.Count == 1 ? "" : "s")} advertised.";
        }
        catch (Exception ex)
        {
            result.Status = McpTestStatus.Failed;
            result.Detail = ex.Message;
        }
        finally
        {
            if (client is not null)
                await client.DisposeAsync();
        }
    }

    /// <summary>
    /// Clears the built archive so the panel falls back to the build button — used by "Build it
    /// again" rather than a full page reload, since the die choices and namespace are worth keeping.
    /// </summary>
    private void Reset()
    {
        package = null;
        written.Clear();
    }

    /// <summary>
    /// One thing the archive is built toward: the fixed configuration files, or one agent's code,
    /// mock, or starter scenarios. Marked done on the first file that matches it, which slightly
    /// overcounts a multi-file step — acceptable, because the bar exists to show the client this is
    /// moving and where, not to meter it to the file.
    /// </summary>
    private sealed class Step
    {
        public required string AgentId { get; init; }
        public required string Kind { get; init; }
        public required string Label { get; init; }
        public bool Done { get; set; }
    }

    private readonly List<Step> plan = [];

    /// <summary>
    /// The step actually being worked on: the first one not yet done.
    /// </summary>
    /// <remarks>
    /// Derived rather than assigned, because a step is only ever <em>reported</em> when it finishes
    /// — the progress callback fires on a written file. Reading the last thing reported as the thing
    /// happening names the step behind the one running, which is furthest from the truth exactly
    /// where it matters most: while a toolkit's mock is being written, the slowest wait of the whole
    /// emit, the mock would show as already ticked.
    /// </remarks>
    private Step? InProgress => plan.FirstOrDefault(s => !s.Done);

    private int Percent => plan.Count == 0 ? 0 : plan.Count(s => s.Done) * 100 / plan.Count;

    /// <summary>
    /// The plan's own steps, regrouped by agent for the card grid — the "structure" step has no
    /// agent and is excluded, since it is already said once by <see cref="PhaseLabel"/>. Grouping
    /// preserves each agent's own step order (code, then mock, then, from the later pass, scenarios)
    /// even though those steps sit far apart inside <see cref="plan"/> itself.
    /// </summary>
    private IEnumerable<IGrouping<string, Step>> AgentCards =>
        plan.Where(s => s.Kind != "structure").GroupBy(s => s.AgentId);

    /// <summary>An agent card's own completion — its steps only, never the whole plan's.</summary>
    private static int CardPercent(IGrouping<string, Step> card) =>
        card.Count(s => s.Done) * 100 / card.Count();

    /// <summary>
    /// A completion as the client reads it: a number while there is still something to count, and
    /// the word for having arrived once there is not.
    /// </summary>
    private static string Progress(int percent) => percent == 100 ? "done" : $"{percent}%";

    // Named for what the client gets, not for what Alembic writes: the agent class and its toolkit
    // are the two halves of a Morgana agent, and "Code"/"Mock" named the emit's own vocabulary.
    private static string StepKindLabel(string kind) => kind switch
    {
        "code" => "Agent",
        "mock" => "Tools",
        "scenarios" => "Scenarios",
        _ => kind
    };

    /// <summary>
    /// The belly is a circle of radius 15.2 centred at y=55, so a full pour is its diameter, 30.4.
    /// Rounded to a tenth: the CSS transition already smooths the motion, and a long float in the
    /// attribute string only invites the kind of sub-pixel rounding disagreement between browsers
    /// that reads as the vessel trembling instead of pouring.
    /// </summary>
    private double FillHeight => Math.Round(30.4 * Percent / 100.0, 1);

    /// <summary>When <see cref="InProgress"/> last changed, so a slow step can say how long it has been slow.</summary>
    private DateTime stepEnteredAt = DateTime.UtcNow;

    /// <summary>Redraws the page at a fixed cadence while the build runs; null whenever it is not running.</summary>
    private Timer? heartbeat;

    /// <summary>How many log rows had been drawn when the log was last scrolled, so it is only scrolled on growth.</summary>
    private int scrolledThrough = -1;

    /// <summary>
    /// The one thing that draws this screen while the archive is being built.
    /// </summary>
    /// <remarks>
    /// A timer rather than a redraw per reported file: it draws the last file of a burst as well as
    /// the first, it bounds what a domain of any size costs in redraws, and it keeps ticking through
    /// the long silence of a model call, where <see cref="StepElapsed"/> is what tells a slow step
    /// apart from a dead page.
    /// </remarks>
    private void StartHeartbeat()
    {
        StopHeartbeat();
        scrolledThrough = -1;
        heartbeat = new Timer(
            _ => Beat(),
            null,
            TimeSpan.FromMilliseconds(250),
            TimeSpan.FromMilliseconds(250));
    }

    /// <summary>
    /// One redraw, asked for from the timer's own thread and unable to fault the circuit.
    /// </summary>
    private void Beat() => _ = BeatAsync();

    /// <summary>
    /// The redraw itself, which swallows everything so the discarded task above cannot fault.
    /// </summary>
    /// <remarks>
    /// Awaited rather than dropped, because <c>InvokeAsync</c> reports a dispatcher that is going
    /// away by completing its task as <em>cancelled</em> — not by throwing. Pressing Stop unwinds
    /// the build in the same instant a tick is in flight, so that is exactly when it happens, and a
    /// dropped task cancelled after the fact is an unobserved <c>TaskCanceledException</c> the
    /// client meets as an unhandled error.
    /// </remarks>
    private async Task BeatAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The dispatcher is going away; there is nothing left to draw on.
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
            StopHeartbeat();
        }
    }

    private void StopHeartbeat()
    {
        heartbeat?.Dispose();
        heartbeat = null;
    }

    /// <summary>Disposes the heartbeat and cancels any build still running when the client leaves the page.</summary>
    public void Dispose()
    {
        StopHeartbeat();

        try
        {
            // The circuit is going away and nothing is left to receive the archive, so a build still
            // in flight is work nobody will collect — and, when it is mid-completion, a model call
            // still being paid for.
            buildCts?.Cancel();
        }
        catch (Exception ex)
        {
            // Cancel runs its registrations inline and rethrows whatever they throw. Nothing here is
            // worth failing a teardown over — least of all on the way out of the page.
            Logger.LogDebug(ex, "Cancelling the build on dispose threw");
        }

        buildCts?.Dispose();
        buildCts = null;
    }

    /// <summary>How long the step in hand has been running, shown once it is long enough to wonder about.</summary>
    private string? StepElapsed
    {
        get
        {
            if (!isBuilding)
                return null;

            int seconds = (int)(DateTime.UtcNow - stepEnteredAt).TotalSeconds;

            return seconds < 3 ? null : seconds < 60 ? $"{seconds}s" : $"{seconds / 60}m {seconds % 60:00}s";
        }
    }

    /// <summary>
    /// What the vessel is doing right now. The <c>null</c> arm is the moment every step is done and
    /// the archive is being sealed.
    /// </summary>
    private string PhaseLabel => InProgress is not { } step
        ? "Sealing the archive…"
        : step.Kind switch
        {
            "structure" => "Writing the domain's configuration and reports…",
            "code" => $"Distilling {step.Label} — writing its agent class…",
            "mock" => $"Distilling {step.Label} — mocking its tool class (AI)…",
            "scenarios" => $"Distilling {step.Label} — writing its harness scenarios (AI)…",
            _ => "Distilling…"
        };

    /// <summary>
    /// The log's own pinned "now" row — a noun phrase rather than <see cref="PhaseLabel"/>'s full
    /// sentence, because it sits after the word "Writing" in the markup rather than standing alone.
    /// </summary>
    private string CurrentLogLabel => InProgress is not { } step
        ? "the last of it"
        : step.Kind switch
        {
            "structure" => "the configuration",
            "code" => $"{step.Label}'s agent class",
            "mock" => $"{step.Label}'s tool class",
            "scenarios" => $"{step.Label}'s scenarios",
            _ => step.Label
        };

    /// <summary>
    /// Builds the plan in the same order <see cref="AssetPackageService"/> actually writes: the
    /// four fixed files, then every agent's code and mock together, then every agent's scenarios —
    /// a second pass over the same agents, because that pass runs after the first has finished for
    /// all of them.
    /// </summary>
    private static List<Step> BuildPlan(DomainDraft draft, bool includeScenarios)
    {
        List<AgentDraft> agents = [.. draft.Agents.Where(a => !string.IsNullOrWhiteSpace(a.ID))];
        List<Step> steps = [new Step { AgentId = "", Kind = "structure", Label = "the configuration" }];

        foreach (AgentDraft agent in agents)
        {
            string label = char.ToUpperInvariant(agent.ID![0]) + agent.ID[1..];
            steps.Add(new Step { AgentId = agent.ID, Kind = "code", Label = label });

            if (agent.Tools.Count > 0)
                steps.Add(new Step { AgentId = agent.ID, Kind = "mock", Label = label });
        }

        if (includeScenarios)
            foreach (AgentDraft agent in agents)
            {
                string label = char.ToUpperInvariant(agent.ID![0]) + agent.ID[1..];
                steps.Add(new Step { AgentId = agent.ID, Kind = "scenarios", Label = label });
            }

        return steps;
    }

    /// <summary>
    /// Which step one written path belongs to. Asks <see cref="Distiller.Services.CodeEmitService"/>
    /// itself for the agent's real paths rather than re-deriving the class names here — the same
    /// formula duplicated in a second place is exactly the kind of thing that silently drifts, and
    /// this way it cannot: whatever <see cref="AssetPackageService"/> actually wrote is what this
    /// compares against.
    /// </summary>
    private Step? MatchStep(string path, DomainDraft draft)
    {
        if (path is "agents.json" or "alembic-draft.json" or "MIGRATION.md" or "README.md" or Distiller.Services.AssetPackageService.MarkerFileName)
            return plan.FirstOrDefault(s => s.Kind == "structure");

        foreach (AgentDraft agent in draft.Agents.Where(a => !string.IsNullOrWhiteSpace(a.ID)))
        {
            string id = agent.ID!;

            foreach (EmittedFile file in CodeEmitService.Emit(agent, id))
            {
                if (path == file.Path)
                    return plan.FirstOrDefault(s => s.AgentId == id && s.Kind == "code");

                // The mock is the generated tool file's own client half — same path, ".g" dropped —
                // so deriving it from that path is the X.g.cs/X.cs convention itself, not a guess.
                if (file.Path.StartsWith("Tools/", StringComparison.Ordinal) && file.Path.EndsWith(".g.cs", StringComparison.Ordinal))
                {
                    string mockPath = file.Path[..^".g.cs".Length] + ".cs";
                    if (path == mockPath || path == mockPath + ".FAILED.txt")
                        return plan.FirstOrDefault(s => s.AgentId == id && s.Kind == "mock");
                }
            }

            if (path.StartsWith($"Scenarios/{id}-", StringComparison.Ordinal) || path == $"Scenarios/{id}.FAILED.txt")
                return plan.FirstOrDefault(s => s.AgentId == id && s.Kind == "scenarios");
        }

        return null;
    }

    /// <summary>
    /// Runs <see cref="AssetPackageService.BuildAsync"/> and drives the distillation bar off its
    /// progress callback, matching each reported path back to the <see cref="Step"/> it belongs to.
    /// </summary>
    private async Task BuildAsync()
    {
        if (DraftStateService.Current is not { } draft)
            return;

        isBuilding = true;
        error = null;
        stoppedNotice = null;
        written.Clear();
        plan.Clear();
        plan.AddRange(BuildPlan(draft, includeScenarios));
        stepEnteredAt = DateTime.UtcNow;
        buildCts = new CancellationTokenSource();
        StartHeartbeat();

        try
        {
            // The die is already bound to a real value by OnInitialized — nothing left to default
            // here. The namespace goes in as the field shows it, so what was previewed and what is
            // declared cannot differ.
            foreach (AgentDraft agent in draft.Agents)
                agent.Code.Namespace = EffectiveNamespace;

            // State only. Nothing here renders and nothing here reaches the browser: a callback that
            // awaited JS interop had its Task discarded, and interop that outlives the circuit's own
            // one-minute call timeout throws something JSDisconnectedException does not cover — an
            // unobserved fault on a dispatched work item, which tears the circuit down and freezes
            // the page while the build carries on invisibly. Drawing is the heartbeat's job.
            Progress<string> progress = new Progress<string>(path =>
            {
                written.Add(path);

                if (MatchStep(path, draft) is not { } step)
                    return;

                // Only a genuine handover restarts the clock: several files of one step must not
                // keep resetting it, or a slow step would never look slow.
                Step? before = InProgress;
                step.Done = true;

                if (!ReferenceEquals(InProgress, before))
                    stepEnteredAt = DateTime.UtcNow;
            });

            // Off the dispatcher, and that is load-bearing rather than tidy. An event handler runs on
            // the renderer's synchronization context, and Progress<T> captures whatever context it is
            // constructed on — so awaiting the build here queues every Report behind the build
            // producing it, and the structure phase, whose MemoryStream writes all complete
            // synchronously, never yields to let one through.
            // The token goes to the build and NOT to Task.Run. On Task.Run it would only govern
            // scheduling, and it lets the outer task report itself cancelled while the delegate is
            // still unwinding — leaving the real work orphaned, and whatever it throws on the way
            // out observed by nobody.
            CancellationToken token = buildCts.Token;
            package = await Task.Run(
                () => AssetPackageService.BuildAsync(draft, includeScenarios, progress, token));

            // The archive is whole the moment this returns, even if the last agent's slow step only
            // reported its first file — the bar owes the client a full vessel, not a nearly-full one.
            foreach (Step step in plan)
                step.Done = true;
        }
        catch (OperationCanceledException)
        {
            // Stopped, not failed: nothing partial is worth keeping, since a client who asked to
            // discard the run does not want half an archive quietly held onto behind the button.
            package = null;
            written.Clear();
            plan.Clear();
            stoppedNotice = "Build stopped — nothing was distilled.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The archive could not be built");
            error = $"The archive could not be built: {ex.Message}";
        }
        finally
        {
            StopHeartbeat();
            isBuilding = false;
            isStopping = false;
            buildCts?.Dispose();
            buildCts = null;
        }
    }

    /// <summary>
    /// Cancels the running build. <see cref="BuildAsync"/>'s own <c>catch</c> does the actual
    /// discarding once the cancellation unwinds through <see cref="AssetPackageService.BuildAsync"/>
    /// — this only asks for it, and guards against a second press firing a second cancel while the
    /// first is still unwinding.
    /// </summary>
    private void Stop()
    {
        if (buildCts is null || isStopping)
            return;

        isStopping = true;

        try
        {
            buildCts.Cancel();
        }
        catch (Exception ex)
        {
            // Cancel runs every registration inline on this thread and rethrows what they throw, so
            // a press of Stop can surface somebody else's unwinding as an unhandled error on an
            // event handler. The build's own catch does the work either way; this only asks.
            Logger.LogDebug(ex, "Cancelling the build threw while stopping");
        }
    }

    /// <summary>
    /// Pins the emission log to its newest entry, at the bottom of the box. Nothing about the CSS
    /// keeps an overflowing box scrolled to its own bottom as rows are appended, so it is asked for.
    /// </summary>
    /// <remarks>
    /// Here rather than beside a <c>StateHasChanged</c>, on two counts: this is the first moment the
    /// rows being scrolled past are in the browser's DOM, and the interop's Task is awaited by the
    /// framework instead of dropped — an unobserved failure on dispatched work takes the circuit
    /// down with it.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isBuilding || written.Count == scrolledThrough)
            return;

        scrolledThrough = written.Count;

        try
        {
            await JS.InvokeVoidAsync("alembicScrollLogBottom");
        }
        catch (Exception ex)
        {
            // Never rethrown. Keeping the newest line in view is a courtesy, and losing it is not
            // worth failing a build the client has been waiting minutes for.
            Logger.LogDebug(ex, "Could not scroll the emission log");
        }
    }

    /// <summary>
    /// The archive as a downloadable <c>data:</c> URI, for the same reason the JSON downloads are:
    /// the Draft lives in the circuit, so no stateless endpoint can reach it.
    /// </summary>
    private static string DataUri(byte[] content) =>
        $"data:application/zip;base64,{Convert.ToBase64String(content)}";
}
