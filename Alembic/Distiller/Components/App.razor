<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Alembic - Morgana's Authoring Workbench</title>
    <link href="favicon.svg" rel="icon" type="image/svg+xml" />

    @* The palette first: every file after it spends its tokens and none defines them. *@
    <link rel="stylesheet" href="@Assets["css/palette.css"]" />
    <link rel="stylesheet" href="@Assets["css/shell.css"]" />
    <link rel="stylesheet" href="@Assets["css/landing.css"]" />
    <link rel="stylesheet" href="@Assets["css/domain.css"]" />
    <HeadOutlet @rendermode="Interactive" />
</head>
<body>
    <Routes @rendermode="Interactive" />

    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["js/alembic.js"]"></script>
</body>
</html>

@code {
    /// <summary>
    /// Server interactivity with no prerender: the first model call starts once, on the live circuit.
    /// </summary>
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);
}
