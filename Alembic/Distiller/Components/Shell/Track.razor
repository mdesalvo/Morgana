@*
    The track: the map once, the agent in hand between its neighbours, the domain once. Fixed height,
    so twelve agents take the room of two.
*@

<div class="track" data-phase="@Phase">
    <FluentCard Class="seg edge fixed" data-state="@(Pointer.IsMap ? "here" : "done")" Shadow="CardShadow.None" Role="button"
                OnClick="() => OnLook.InvokeAsync(ShellPoint.Map)">
        <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
            <span class="seg-name">Map</span>
            <FluentProgressBar Value="@(Mapped ? 100 : 0)" Max="100" Width="100%" Color="@BarWritten" BackgroundColor="@BarAhead" Thickness="ProgressThickness.Large" />
        </FluentStack>
    </FluentCard>

    <span class="sep"></span>

    @if (!Mapped)
    {
        <FluentCard Class="seg" data-state="ahead" Shadow="CardShadow.None">
            <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
                <span class="seg-name">Agents</span>
                <FluentProgressBar Value="0" Max="100" Width="100%" Color="@BarWritten" BackgroundColor="@BarAhead" Thickness="ProgressThickness.Large" />
            </FluentStack>
        </FluentCard>
    }
    else if (ShowsCarousel)
    {
        <div class="carousel">
            @Arrow(Centred - 1, "‹", "The previous agent")

            @* Keyed on the agent, so the slide plays when the agent changes and never on a step. *@
            <FluentCard Class="seg middle slide" data-state="here" Shadow="CardShadow.None" @key="Centred">
                <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
                    <span class="seg-name">
                        Agent: @Named(Centred)
                        <span class="pos-now">@(Centred + 1)/@Entries.Count</span>
                    </span>

                    <div class="ticks">
                        @for (int rail = 1; rail <= ShellPoint.AcceptanceRail; rail++)
                        {
                            ShellPoint moment = new ShellPoint(Centred, rail);

                            @Tick(moment, moment > Frontier, IsFrontierMark(moment) ? "Where the interview stands" : moment.Name)
                        }
                    </div>
                </FluentStack>
            </FluentCard>

            @Arrow(Centred + 1, "›", "The next agent")
        </div>
    }
    else
    {
        <FluentCard Class="seg" data-state="done" Shadow="CardShadow.None" Role="button" title="Back to the first agent"
                    OnClick="() => OnLook.InvokeAsync(new ShellPoint(0, 1))">
            <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
                <span class="seg-name">
                    Agents
                    <span class="pos-now">@Accepted/@Entries.Count</span>
                </span>
                <FluentProgressBar Value="@Accepted" Max="@Math.Max(Entries.Count, 1)" Width="100%" Color="@BarWritten" BackgroundColor="@BarAhead" Thickness="ProgressThickness.Large" />
            </FluentStack>
        </FluentCard>
    }

    <span class="sep"></span>

    @if (Frontier.OnDomain)
    {
        @* Every domain moment is open once the interview is behind: the marks are the way between them. *@
        <FluentCard Class="seg edge" data-state="@(Pointer.OnDomain ? "here" : "done")" Shadow="CardShadow.None">
            <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
                <span class="seg-name">Domain</span>
                <div class="ticks">
                    @for (int rail = ShellPoint.CollaborationRail; rail < ShellPoint.CollaborationRail + ShellPoint.DomainMoments.Count; rail++)
                    {
                        ShellPoint moment = new ShellPoint(-1, rail);

                        @Tick(moment, false, moment.Name)
                    }
                </div>
            </FluentStack>
        </FluentCard>
    }
    else
    {
        <FluentCard Class="seg edge" data-state="ahead" Shadow="CardShadow.None">
            <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.SpaceBetween" Height="100%">
                <span class="seg-name">Domain</span>
                <FluentProgressBar Value="0" Max="100" Width="100%" Color="@BarWritten" BackgroundColor="@BarAhead" Thickness="ProgressThickness.Large" />
            </FluentStack>
        </FluentCard>
    }
</div>

@code {
    /// <summary>
    /// What a segment's bar has written: cyan, the colour of resolved work.
    /// </summary>
    private const string BarWritten = "var(--alembic-cyan)";

    /// <summary>
    /// What a segment's bar has still ahead of it, drawn in the border's colour.
    /// </summary>
    private const string BarAhead = "var(--alembic-border)";

    /// <summary>
    /// The mark of the moment the client is looking at.
    /// </summary>
    private const string BarHere = "var(--alembic-accent)";

    /// <summary>
    /// The mark of where the interview stands while the client looks elsewhere.
    /// </summary>
    private const string BarFrontier = "var(--alembic-gold)";

    /// <summary>
    /// The agents on the track, one per map entry.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<IntentDraft> Entries { get; set; } = [];

    /// <summary>
    /// Where the work stands: the pointer may never pass it.
    /// </summary>
    [Parameter, EditorRequired]
    public ShellPoint Frontier { get; set; }

    /// <summary>
    /// Where the client is looking.
    /// </summary>
    [Parameter, EditorRequired]
    public ShellPoint Pointer { get; set; }

    /// <summary>
    /// Raised with the moment the client wants to look at.
    /// </summary>
    [Parameter]
    public EventCallback<ShellPoint> OnLook { get; set; }

    /// <summary>
    /// Whether the map is behind the work, so there are agents to show.
    /// </summary>
    private bool Mapped => Frontier > ShellPoint.Map;

    /// <summary>
    /// Whether the agents are open in the carousel rather than folded into one box.
    /// </summary>
    // Out of the agents they fold away: two open blocks would compete for the scene.
    private bool ShowsCarousel => Entries.Count > 0 && (Pointer.OnAgent || (Pointer.IsMap && Frontier.OnAgent));

    /// <summary>
    /// The agent at the centre of the carousel: the one looked at, else the one in hand.
    /// </summary>
    private int Centred => Pointer.OnAgent ? Pointer.Entry : Frontier.OnAgent ? Frontier.Entry : 0;

    /// <summary>
    /// How many agents are already in the domain.
    /// </summary>
    private int Accepted => Frontier.OnDomain ? Entries.Count : Frontier.OnAgent ? Frontier.Entry : 0;

    /// <summary>
    /// What the track is about right now, which decides who takes the width.
    /// </summary>
    private string Phase => Pointer.OnAgent ? "agent" : Pointer.IsMap ? "map" : "edge";

    /// <summary>
    /// Whether this is where the interview stands while the client looks elsewhere.
    /// </summary>
    // In the domain nothing is still being settled, so no mark is owed.
    private bool IsFrontierMark(ShellPoint moment) => moment == Frontier && Pointer != Frontier && !Frontier.OnDomain;

    /// <summary>
    /// A moment's bar: accent where the client looks, gold at the frontier, cyan where it is resolved.
    /// </summary>
    private string MarkColor(ShellPoint moment) =>
        moment == Pointer ? BarHere : IsFrontierMark(moment) ? BarFrontier : BarWritten;

    /// <summary>
    /// Whether a moment's bar is drawn at all: nothing is drawn for what lies ahead of the work.
    /// </summary>
    private bool Marked(ShellPoint moment) =>
        moment == Pointer || IsFrontierMark(moment) || moment < Frontier || Frontier.OnDomain;

    /// <summary>
    /// A moment's name: full where the client looks, gold at the frontier, muted elsewhere.
    /// </summary>
    private string MarkText(ShellPoint moment) =>
        moment == Pointer ? string.Empty : IsFrontierMark(moment) ? "frontier-mark" : "muted";

    /// <summary>
    /// One step of an agent or of the domain: its bar over its name, the way onto it.
    /// </summary>
    private RenderFragment Tick(ShellPoint moment, bool locked, string title) =>
        @<FluentCard Appearance="CardAppearance.Subtle" Shadow="CardShadow.None" Class="tick" title="@title"
                     Role="@(locked ? null : "button")"
                     OnClick="() => LookAt(moment, locked)">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5px">
                <FluentProgressBar Value="@(Marked(moment) ? 100 : 0)" Max="100" Width="100%" Thickness="ProgressThickness.Large"
                                   Color="@MarkColor(moment)" BackgroundColor="@BarAhead" Class="@(moment == Pointer ? "glow" : null)" />
                <FluentText Size="TextSize.Size200" Weight="TextWeight.Regular" Truncate="true" Class="@MarkText(moment)">@moment.Name</FluentText>
            </FluentStack>
        </FluentCard>;

    /// <summary>
    /// Moves the client onto a step, unless the interview has not reached it yet.
    /// </summary>
    private Task LookAt(ShellPoint moment, bool locked) =>
        locked ? Task.CompletedTask : OnLook.InvokeAsync(moment);

    /// <summary>
    /// The name an entry goes by: its intent name.
    /// </summary>
    private string Named(int entry) =>
        entry >= 0 && entry < Entries.Count ? Entries[entry].Name ?? "…" : "…";

    /// <summary>
    /// An arrow to a neighbouring agent, absent at either end of the row.
    /// </summary>
    // It lands on the work in hand for the agent at the frontier and on the Target for one behind it.
    private RenderFragment Arrow(int entry, string glyph, string label)
    {
        if (entry < 0 || entry >= Entries.Count)
            return _ => { };

        ShellPoint landing = Frontier.OnAgent && entry == Frontier.Entry ? Frontier : new ShellPoint(entry, 1);
        string position = $"{entry + 1}/{Entries.Count}";

        return @<FluentButton Appearance="ButtonAppearance.Outline" Class="arrow" Disabled="@(landing > Frontier)"
                              Title="@label" OnClick="() => OnLook.InvokeAsync(landing)">
                    @if (glyph == "‹")
                    {
                        @glyph<span class="pos">@position</span>
                    }
                    else
                    {
                        <span class="pos">@position</span>@glyph
                    }
                </FluentButton>;
    }
}
