@inherits LayoutComponentBase
@inject IThemeService ThemeService

@* The page waits for the palette's theme, so no control is ever seen in Fluent's default colours. *@
@if (themed)
{
    @Body
}

<FluentProviders />

@code {
    /// <summary>
    /// The theme's seed: palette.css's --alembic-accent-deep, the violet the vessel is lit with.
    /// </summary>
    private const string Seed = "#8b5cf6";

    /// <summary>
    /// Alembic's reading face, with the system faces behind it while the file loads.
    /// </summary>
    private const string BaseFace = "'Source Sans 3', 'Segoe UI', system-ui, sans-serif";

    /// <summary>
    /// The face tool signatures and file names are set in.
    /// </summary>
    private const string MonospaceFace = "'IBM Plex Mono', ui-monospace, monospace";

    /// <summary>
    /// Whether the palette's theme is in place, so the page may be shown.
    /// </summary>
    private bool themed;

    /// <summary>
    /// Grows Fluent's colour ramp from the seed, then stands its grounds, text and lines in the palette's room.
    /// </summary>
    // Every value is a palette token rather than a hex, so palette.css stays the one place a colour is written.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        Theme theme = await ThemeService.CreateCustomThemeAsync(new ThemeSettings(Seed, 0, 0, ThemeMode.Dark, true));

        theme.Fonts.Family.Base = BaseFace;
        theme.Fonts.Family.Numeric = BaseFace;
        theme.Fonts.Family.Monospace = MonospaceFace;

        // The two smallest steps are where badges and a message bar's body are set, with no size of their own
        // to raise; lifted here, every label and hint stays readable at the workbench's desk distance.
        theme.Fonts.Size.Base100 = "12px";
        theme.Fonts.Size.Base200 = "14px";

        // Fluent's grounds darken as their number grows, the palette's in the order they stack.
        theme.Colors.Neutral.Background1 = "var(--alembic-panel)";
        theme.Colors.Neutral.Background2 = "var(--alembic-bg)";
        theme.Colors.Neutral.Background3 = "var(--alembic-bg-deep)";
        theme.Colors.Neutral.Background4 = "var(--alembic-bg-deep)";
        theme.Colors.Neutral.CardBackground = "var(--alembic-panel)";

        theme.Colors.Neutral.Foreground1 = "var(--alembic-text)";
        theme.Colors.Neutral.Foreground2 = "var(--alembic-text)";
        theme.Colors.Neutral.Foreground3 = "var(--alembic-muted)";
        theme.Colors.Neutral.Foreground4 = "var(--alembic-muted)";

        theme.Colors.Neutral.Stroke1 = "var(--alembic-border-lit)";
        theme.Colors.Neutral.Stroke2 = "var(--alembic-border)";
        theme.Colors.Neutral.StrokeSubtle = "var(--alembic-border)";

        // News wears the palette's kinds: gold warns, red refuses, green is verified. A tint for the ground keeps a
        // warning from reading as a failure the way Fluent's dark defaults drew it.
        theme.Colors.Status.WarningBackground1 = "color-mix(in srgb, var(--alembic-gold) 12%, transparent)";
        theme.Colors.Status.WarningBackground2 = "color-mix(in srgb, var(--alembic-gold) 20%, transparent)";
        theme.Colors.Status.WarningBackground3 = "var(--alembic-gold)";
        theme.Colors.Status.WarningBorder1 = "var(--alembic-gold)";
        theme.Colors.Status.WarningBorder2 = "var(--alembic-gold)";
        theme.Colors.Status.WarningBorderActive = "var(--alembic-gold)";
        theme.Colors.Status.WarningForeground1 = "var(--alembic-gold)";
        theme.Colors.Status.WarningForeground2 = "var(--alembic-gold)";
        theme.Colors.Status.WarningForeground3 = "var(--alembic-gold)";
        theme.Colors.Status.WarningForegroundInverted = "var(--alembic-bg-deep)";

        theme.Colors.Status.DangerBackground1 = "color-mix(in srgb, var(--alembic-error) 12%, transparent)";
        theme.Colors.Status.DangerBackground2 = "color-mix(in srgb, var(--alembic-error) 20%, transparent)";
        theme.Colors.Status.DangerBackground3 = "var(--alembic-error)";
        theme.Colors.Status.DangerBackground3Hover = "var(--alembic-error)";
        theme.Colors.Status.DangerBackground3Pressed = "var(--alembic-error)";
        theme.Colors.Status.DangerBorder1 = "var(--alembic-error)";
        theme.Colors.Status.DangerBorder2 = "var(--alembic-error)";
        theme.Colors.Status.DangerBorderActive = "var(--alembic-error)";
        theme.Colors.Status.DangerForeground1 = "var(--alembic-error)";
        theme.Colors.Status.DangerForeground2 = "var(--alembic-error)";
        theme.Colors.Status.DangerForeground3 = "var(--alembic-error)";
        theme.Colors.Status.DangerForegroundInverted = "var(--alembic-bg-deep)";

        theme.Colors.Status.SuccessBackground1 = "color-mix(in srgb, var(--alembic-success) 12%, transparent)";
        theme.Colors.Status.SuccessBackground2 = "color-mix(in srgb, var(--alembic-success) 20%, transparent)";
        theme.Colors.Status.SuccessBackground3 = "var(--alembic-success)";
        theme.Colors.Status.SuccessBorder1 = "var(--alembic-success)";
        theme.Colors.Status.SuccessBorder2 = "var(--alembic-success)";
        theme.Colors.Status.SuccessBorderActive = "var(--alembic-success)";
        theme.Colors.Status.SuccessForeground1 = "var(--alembic-success)";
        theme.Colors.Status.SuccessForeground2 = "var(--alembic-success)";
        theme.Colors.Status.SuccessForeground3 = "var(--alembic-success)";
        theme.Colors.Status.SuccessForegroundInverted = "var(--alembic-bg-deep)";

        // A message bar reads its kinds off the palette hues rather than the status ones: dark orange warns, red
        // refuses, green is verified, so those hues take the same three palette tokens.
        theme.Colors.Palette.DarkOrangeBackground1 = "color-mix(in srgb, var(--alembic-gold) 12%, transparent)";
        theme.Colors.Palette.DarkOrangeBorder1 = "var(--alembic-gold)";
        theme.Colors.Palette.DarkOrangeForeground1 = "var(--alembic-gold)";
        theme.Colors.Palette.DarkOrangeForeground3 = "var(--alembic-gold)";

        theme.Colors.Palette.RedBackground1 = "color-mix(in srgb, var(--alembic-error) 12%, transparent)";
        theme.Colors.Palette.RedBorder1 = "var(--alembic-error)";
        theme.Colors.Palette.RedForeground1 = "var(--alembic-error)";
        theme.Colors.Palette.RedForeground3 = "var(--alembic-error)";

        theme.Colors.Palette.GreenBackground1 = "color-mix(in srgb, var(--alembic-success) 12%, transparent)";
        theme.Colors.Palette.GreenBorder1 = "var(--alembic-success)";
        theme.Colors.Palette.GreenForeground1 = "var(--alembic-success)";
        theme.Colors.Palette.GreenForeground3 = "var(--alembic-success)";

        await ThemeService.SetThemeAsync(theme);

        themed = true;
        StateHasChanged();
    }
}
