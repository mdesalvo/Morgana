<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
</Router>

@*
    Root component: builds the route table from this assembly and renders the match.

    No <NotFound> handler on purpose — Program.cs already routes every unmatched request to
    _Host, so nothing ever reaches a not-found branch.

    Nothing is focused on navigation either. Focusing the heading rings a caret round a word that
    cannot be typed into and every page here has a better place for it or none at all: the
    interview puts the caret in the reply box on each new question and the landing and the import
    page open on a handful of controls a keyboard reaches with one Tab.
*@
