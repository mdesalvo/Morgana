@page "/interview"
@using Alembic.Interfaces
@using Alembic.Model
@inject IInterviewService InterviewService
@inject IDraftStateService DraftStateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@*
    The three passes. Two columns on purpose: the client talks on the left and watches
    the configuration fill in on the right. Seeing a field appear the moment it is inferred is what
    turns "answer some questions" into "watch your domain being written", and it is also what makes
    a wrong inference cheap to catch.

    One transcript across all three passes. The model starts each pass with a fresh session, but the
    client is having a single interview and must never be shown the seam.
*@

<div class="alembic-page alembic-wide">

    <h1>Interview</h1>
    <p class="tagline">@Tagline(InterviewService.Current?.Pass ?? InterviewPass.Functional)</p>

    @if (InterviewService.Current is not { } state)
    {
        <div class="panel">
            <h2>Before we start</h2>
            <p>
                You will be asked about your work, not about Morgana. Answer as you would explain it
                to a new colleague; Alembic writes the configuration.
            </p>
            <p class="muted">
                Three passes, one conversation: what the agent is for, then what it has to reach for,
                then how it works. The first deliberately does not ask about tools or systems &mdash;
                what you say there could change what belongs here, which is why they are separate.
            </p>
            <button class="primary" @onclick="StartAsync" disabled="@isBusy">
                @(isBusy ? "Starting…" : "Start the interview")
            </button>
        </div>
    }
    else
    {
        <div class="interview-grid">

            <div class="panel">
                <h2>Conversation</h2>

                <div class="transcript">
                    @foreach ((InterviewTurn turn, int index) in state.Transcript.Select((t, i) => (t, i)))
                    {
                        <div class="turn @(turn.Speaker == InterviewSpeaker.Alembic ? "turn-alembic" : "turn-client")">
                            <div class="who">@(turn.Speaker == InterviewSpeaker.Alembic ? "Alembic" : "You")</div>
                            <div class="said">@turn.Text</div>

                            @*
                                Buttons render only on the turn still awaiting an answer. Once the
                                client has replied the row is spent, so it is shown inert rather
                                than removed — the transcript should still say what was offered.

                                Unlike a channel's quick replies, these never disable the text box
                                below. A choice here is an offer, never a gate: the client's own
                                words are the material being distilled, and a menu must never be
                                the only way to answer.
                            *@
                            @if (turn.Choices is { Count: > 0 } choices)
                            {
                                bool spent = index != state.Transcript.Count - 1 || turn.ChosenId is not null;

                                <div class="choices @(spent ? "spent" : "")">
                                    @foreach (QuickReply choice in choices)
                                    {
                                        <button class="choice @(turn.ChosenId == choice.Id ? "chosen" : "")"
                                                disabled="@(spent || isBusy)"
                                                @onclick="() => ChooseAsync(turn, choice)">@choice.Label</button>
                                    }
                                </div>

                                @if (!spent)
                                {
                                    <div class="choices-hint">
                                        Pressing one sends it as your answer. You can ignore them and
                                        write your own &mdash; they never replace the box below.
                                    </div>
                                }
                            }
                        </div>
                    }
                    @if (isBusy)
                    {
                        <div class="turn turn-alembic"><div class="who">Alembic</div><div class="said muted">thinking&hellip;</div></div>
                    }
                </div>

                @if (state.Error is not null)
                {
                    <p class="severity-error">@state.Error</p>
                }

                <textarea @bind="answer" @bind:event="oninput" rows="3"
                          placeholder="Your answer&hellip;" disabled="@isBusy"></textarea>
                <p>
                    <button class="primary" @onclick="AnswerAsync" disabled="@(isBusy || string.IsNullOrWhiteSpace(answer))">Send</button>
                    <button class="agent-pick" @onclick="Abandon" disabled="@isBusy">Abandon</button>
                </p>
            </div>

            <div class="panel">
                <h2>@PanelTitle(state.Pass)</h2>
                <p class="muted">@PanelLead(state.Pass)</p>

                @*
                    Pass-aware, and the point is that it should never look the same twice. What this
                    pass is settling is shown open and labelled in the client's terms; what an
                    earlier pass settled folds into a line of history; what a later one will write is
                    named as pending rather than left as an empty row that reads like a gap.

                    A field the last exchange moved is marked. Without that the panel is a list that
                    fills in silently, and the whole reason for the second column — watching your
                    domain being written — is lost.
                *@

                @if (state.Pass == InterviewPass.Functional)
                {
                    <dl class="fields">
                        <dt class="@Moved(state, "intentName")">what it is called</dt>
                        <dd>@Show(state.Intent.Name)</dd>
                        <dt class="@Moved(state, "intentDescription")">when a message belongs to it</dt>
                        <dd>@Show(state.Intent.Description)</dd>
                        <dt class="@Moved(state, "intentLabel")">its button</dt>
                        <dd>@Show(state.Intent.Label)</dd>
                        <dt class="@Moved(state, "intentDefaultValue")">how someone opens with it</dt>
                        <dd>@Show(state.Intent.DefaultValue)</dd>
                        <dt class="@Moved(state, "agentTarget")">what it is for, and where it stops</dt>
                        <dd>@Show(state.Agent.Target)</dd>
                        <dt class="@Moved(state, "agentPersonality")">how it meets someone</dt>
                        <dd>@Show(state.Agent.Personality)</dd>
                    </dl>

                    <p class="later">
                        Still to come: what it reaches for, then how it works and how it shows what
                        it finds. Those speak about its tools, so they wait for the tools.
                    </p>
                }
                else
                {
                    <p class="settled">
                        <strong>@state.Intent.Name</strong> &mdash; @Show(state.Intent.Description)
                        <span class="muted">Settled in the first pass, with its voice and its edges.</span>
                    </p>
                }

                @if (state.Pass != InterviewPass.Functional)
                {
                    <h3 class="@Moved(state, "tools")">What it reaches for</h3>

                    @if (state.Agent.Tools.Count == 0)
                    {
                        <p class="muted">
                            Nothing yet. An agent may end with none &mdash; one whose tools all arrive
                            from an MCP server declares nothing here.
                        </p>
                    }
                    else
                    {
                        @foreach (ToolDraft tool in state.Agent.Tools)
                        {
                            <div class="tool">
                                <div class="tool-name">@tool.Name</div>
                                <div class="muted">@Show(tool.Description)</div>

                                @if (tool.Parameters.Count > 0)
                                {
                                    <dl class="fields">
                                        @foreach (ToolParameterDraft parameter in tool.Parameters)
                                        {
                                            <dt>@parameter.Name @Annotations(parameter)</dt>
                                            <dd>@Show(parameter.Description)</dd>
                                        }
                                    </dl>
                                }
                            </div>
                        }
                    }
                }

                @if (state.Pass == InterviewPass.Toolkit)
                {
                    <p class="later">
                        Still to come: how it works, and how it shows what these give back.
                    </p>
                }

                @if (state.Pass == InterviewPass.Return)
                {
                    <h3>How it works</h3>
                    <dl class="fields">
                        <dt class="@Moved(state, "agentInstructions")">the order of the work, and its refusals</dt>
                        <dd>@Show(state.Agent.Instructions)</dd>
                        <dt class="@Moved(state, "agentFormatting")">how it shows what it finds</dt>
                        <dd>@Show(state.Agent.Formatting)</dd>
                    </dl>
                }

                @if (state.ReadyForReview)
                {
                    <p>@Settled(state.Pass)</p>

                    @if (state.Pass == InterviewPass.Return)
                    {
                        <button class="primary" @onclick="CommitAsync" disabled="@isBusy">Add to the draft</button>
                    }
                    else
                    {
                        <button class="primary" @onclick="AdvanceAsync" disabled="@isBusy">@NextPassLabel(state.Pass)</button>
                    }
                }
                else if (state.Missing() is { Count: > 0 } missing)
                {
                    <p class="muted">Still unproposed: @string.Join(", ", missing).</p>
                }
            </div>

        </div>
    }

    <p class="phase-note">
        Three passes, one conversation: what the agent is, what it reaches for, how it works.
    </p>

    <p><a href="">&larr; back</a></p>

</div>

@code {
    private string answer = string.Empty;
    private bool isBusy;
    private int scrolledTo = -1;

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>
    /// Marks a field the last exchange actually moved, so the panel says what just happened rather
    /// than only what is true.
    /// </summary>
    private static string Moved(InterviewState state, string field) =>
        state.Changed.Contains(field) ? "moved" : string.Empty;

    private static string PanelTitle(InterviewPass pass) => pass switch
    {
        InterviewPass.Functional => "What this agent is",
        InterviewPass.Toolkit => "What it reaches for",
        _ => "How it works"
    };

    private static string PanelLead(InterviewPass pass) => pass switch
    {
        InterviewPass.Functional => "Filled in as Alembic infers it. Anything wrong here is cheapest to say now.",
        InterviewPass.Toolkit => "Each action becomes a tool, and what must be known before it becomes its inputs.",
        _ => "Written from the toolkit above, which is why it waited for it."
    };

    private static string Tagline(InterviewPass pass) => pass switch
    {
        InterviewPass.Functional => "Functional pass — what the agent is for, where it stops, how it sounds.",
        InterviewPass.Toolkit => "Toolkit pass — what the agent reaches for outside the conversation.",
        _ => "Last pass — how the agent works, and how it shows what it finds."
    };

    private static string Settled(InterviewPass pass) => pass switch
    {
        InterviewPass.Functional => "The agent's purpose and voice are settled.",
        InterviewPass.Toolkit => "The toolkit is settled.",
        _ => "Every section is settled."
    };

    private static string NextPassLabel(InterviewPass pass) => pass switch
    {
        InterviewPass.Functional => "Continue to the toolkit",
        _ => "Continue to instructions"
    };

    /// <summary>
    /// The parameter's scope and its two flags, shown as they are configured rather than as prose:
    /// a context-scoped parameter is what lets the agent stop re-asking, and shared is what carries
    /// it to the other agents, so both are worth seeing at a glance.
    /// </summary>
    private static string Annotations(ToolParameterDraft parameter)
    {
        List<string> annotations = [parameter.Scope ?? "authored"];

        if (!parameter.Required) annotations.Add("optional");
        if (parameter.Shared) annotations.Add("shared");

        return $"[{string.Join(", ", annotations)}]";
    }

    private async Task StartAsync()
    {
        isBusy = true;
        try { await InterviewService.StartAsync(); }
        finally { isBusy = false; }
    }

    private async Task AnswerAsync()
    {
        string said = answer;
        answer = string.Empty;
        await SendAsync(said);
    }

    /// <summary>
    /// Sends a choice as the answer, and records on the turn which one was pressed.
    /// </summary>
    /// <remarks>
    /// Recorded before the round trip, so the button lights the instant it is clicked rather than
    /// after the model answers. The label and the value are deliberately different things, and
    /// without this the transcript shows a sentence the client never wrote with no sign of the
    /// gesture that produced it.
    /// </remarks>
    private Task ChooseAsync(InterviewTurn turn, QuickReply choice)
    {
        turn.ChosenId = choice.Id;
        return SendAsync(choice.Value);
    }

    private async Task SendAsync(string said)
    {
        isBusy = true;
        try { await InterviewService.AnswerAsync(said); }
        finally { isBusy = false; }
    }

    /// <summary>
    /// Keeps the newest turn in view.
    /// </summary>
    /// <remarks>
    /// The transcript is a fixed-height scroll box that does not scroll itself, so without this
    /// every new turn lands below the fold: the client presses a button, the row greys out, and
    /// their own answer and Alembic's reply are both off-screen. Pressing a button then reads as
    /// nothing having happened, which is exactly what it looked like.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        int turns = InterviewService.Current?.Transcript.Count ?? 0;

        if (turns == scrolledTo && !isBusy)
            return;

        scrolledTo = turns;
        await JS.InvokeVoidAsync("alembicScrollTranscript");
    }

    private async Task AdvanceAsync()
    {
        isBusy = true;
        try { await InterviewService.AdvanceAsync(); }
        finally { isBusy = false; }
    }

    private Task CommitAsync()
    {
        InterviewService.Commit();
        NavigationManager.NavigateTo("review");
        return Task.CompletedTask;
    }

    private void Abandon() => InterviewService.Abandon();
}
