@page "/interview"
@using Alembic.Interfaces
@using Alembic.Model
@inject IInterviewService InterviewService
@inject IDraftStateService DraftStateService
@inject NavigationManager NavigationManager

@*
    Phase 5 — the functional pass. Two columns on purpose: the client talks on the left and watches
    the configuration fill in on the right. Seeing a field appear the moment it is inferred is what
    turns "answer some questions" into "watch your domain being written", and it is also what makes
    a wrong inference cheap to catch.
*@

<div class="alembic-page alembic-wide">

    <h1>Interview</h1>
    <p class="tagline">Functional pass &mdash; what the agent is for, where it stops, how it sounds.</p>

    @if (InterviewService.Current is not { } state)
    {
        <div class="panel">
            <h2>Before we start</h2>
            <p>
                You will be asked about your work, not about Morgana. Answer as you would explain it
                to a new colleague; Alembic writes the configuration.
            </p>
            <p class="muted">
                This pass deliberately does not ask about tools, data sources or systems. What you
                say there could change what belongs here, which is why the toolkit is a separate pass.
            </p>
            <button class="primary" @onclick="StartAsync" disabled="@isBusy">
                @(isBusy ? "Starting…" : "Start the interview")
            </button>
        </div>
    }
    else
    {
        <div class="interview-grid">

            <div class="panel">
                <h2>Conversation</h2>

                <div class="transcript">
                    @foreach (InterviewTurn turn in state.Transcript)
                    {
                        <div class="turn @(turn.Speaker == InterviewSpeaker.Alembic ? "turn-alembic" : "turn-client")">
                            <div class="who">@(turn.Speaker == InterviewSpeaker.Alembic ? "Alembic" : "You")</div>
                            <div class="said">@turn.Text</div>
                        </div>
                    }
                    @if (isBusy)
                    {
                        <div class="turn turn-alembic"><div class="who">Alembic</div><div class="said muted">thinking&hellip;</div></div>
                    }
                </div>

                @if (state.Error is not null)
                {
                    <p class="severity-error">@state.Error</p>
                }

                <textarea @bind="answer" @bind:event="oninput" rows="3"
                          placeholder="Your answer&hellip;" disabled="@isBusy"></textarea>
                <p>
                    <button class="primary" @onclick="AnswerAsync" disabled="@(isBusy || string.IsNullOrWhiteSpace(answer))">Send</button>
                    <button class="agent-pick" @onclick="Abandon" disabled="@isBusy">Abandon</button>
                </p>
            </div>

            <div class="panel">
                <h2>Configuration so far</h2>

                <dl class="fields">
                    <dt>intent name</dt><dd>@Show(state.Intent.Name)</dd>
                    <dt>intent description</dt><dd>@Show(state.Intent.Description)</dd>
                    <dt>label</dt><dd>@Show(state.Intent.Label)</dd>
                    <dt>opening sentence</dt><dd>@Show(state.Intent.DefaultValue)</dd>
                    <dt>agent target</dt><dd>@Show(state.Agent.Target)</dd>
                    <dt>agent personality</dt><dd>@Show(state.Agent.Personality)</dd>
                    <dt>language</dt><dd>@state.Agent.Language</dd>
                </dl>

                <p class="muted">
                    Instructions and Formatting are not written in this pass. They speak about the
                    agent's tools, and a rule written about a tool that has not been designed is a
                    rule that will have to be unwritten.
                </p>

                @if (state.ReadyForReview)
                {
                    <p>Every field this pass owns is settled.</p>
                    <button class="primary" @onclick="CommitAsync" disabled="@isBusy">Add to the draft</button>
                }
                else
                {
                    <p class="muted">Still unproposed: @string.Join(", ", state.Missing()).</p>
                }
            </div>

        </div>
    }

    <p class="phase-note">
        Phase 5 &mdash; functional pass. The toolkit pass, the return pass and the emit are not here yet.
    </p>

    <p><a href="">&larr; back</a></p>

</div>

@code {
    private string answer = string.Empty;
    private bool isBusy;

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private async Task StartAsync()
    {
        isBusy = true;
        try { await InterviewService.StartAsync(); }
        finally { isBusy = false; }
    }

    private async Task AnswerAsync()
    {
        string said = answer;
        answer = string.Empty;
        isBusy = true;
        try { await InterviewService.AnswerAsync(said); }
        finally { isBusy = false; }
    }

    private Task CommitAsync()
    {
        InterviewService.Commit();
        NavigationManager.NavigateTo("review");
        return Task.CompletedTask;
    }

    private void Abandon() => InterviewService.Abandon();
}
