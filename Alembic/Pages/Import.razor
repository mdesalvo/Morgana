@page "/import"
@using Alembic.Interfaces
@using System.Text.Json
@using Alembic.Model
@inject IDraftImportService DraftImportService
@inject IDraftExportService DraftExportService
@inject IDraftSerializationService DraftSerializationService
@inject IDraftStateService DraftStateService

@*
    The only way an existing domain enters Alembic: there is no filesystem to read from, by design.
    What the page shows back is the parsed Draft, not a "file accepted" message — the client has to
    be able to see that Alembic understood the same domain Morgana would load.

    Two kinds of file arrive through the same control, because to the client they are one gesture:
    "here is where I am". Which one it is is decided by reading it, never by its name.
*@

<div class="alembic-page">

    <h1>Import</h1>
    <p class="tagline">Upload an existing <code>agents.json</code> to evolve it, resume a saved interview, or start from nothing.</p>

    <div class="panel">
        <h2>Upload</h2>
        <InputFile OnChange="OnFileSelectedAsync" accept=".json" disabled="@isReading" />
        <p class="muted">
            Either an <code>agents.json</code> &mdash; the configuration Morgana loads &mdash; or an
            <code>alembic-draft.json</code> saved from a previous sitting. Alembic tells them apart by
            reading them, not by their name, so a renamed file still lands where it belongs.
        </p>
        @if (isReading)
        {
            <p class="muted">Reading&hellip;</p>
        }
    </div>

    @if (error is not null)
    {
        <div class="panel panel-error">
            <h2>Not read</h2>
            <p>@error</p>
        </div>
    }

    @if (notices.Count > 0)
    {
        <div class="panel">
            <h2>What was read</h2>
            <ul>
                @foreach (string notice in notices)
                {
                    <li>@notice</li>
                }
            </ul>
        </div>
    }

    @if (DraftStateService.Current is { } draft)
    {
        <div class="panel">
            <h2>Download</h2>
            <p>
                <a download="agents.json" href="@DataUri(DraftExportService.Export(draft))">agents.json</a>
                <span class="muted"> &mdash; the configuration Morgana loads</span>
            </p>
            <p>
                <a download="alembic-draft.json" href="@DataUri(DraftSerializationService.Serialize(draft))">alembic-draft.json</a>
                <span class="muted"> &mdash; the interview's save file: provenance, the C# facts a configuration cannot express, and half-answered elements</span>
            </p>
            <p><a href="review">Review this domain &rarr;</a></p>
        </div>

        <div class="panel">
            <h2>Intents</h2>
            <table>
                <thead>
                    <tr><th>Name</th><th>Label</th><th>Description</th></tr>
                </thead>
                <tbody>
                    @foreach (IntentDraft intent in draft.Intents)
                    {
                        <tr>
                            <td><code>@intent.Name</code></td>
                            <td>@intent.Label</td>
                            <td class="description">@intent.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @foreach (AgentDraft agent in draft.Agents)
        {
            <div class="panel">
                <h2>Agent &mdash; @agent.ID</h2>
                <dl>
                    <dt>Language</dt><dd>@agent.Language</dd>
                    <dt>Version</dt><dd>@agent.Version</dd>
                    <dt>Personality</dt><dd>@(agent.Personality is null ? "—" : "declared")</dd>
                    <dt>Proposed classes</dt>
                    <dd>
                        <code>@agent.Code.AgentClassName</code>
                        @if (agent.Code.ToolClassName is not null)
                        {
                            <text>, <code>@agent.Code.ToolClassName</code></text>
                        }
                        <span class="muted"> (inferred &mdash; to confirm)</span>
                    </dd>
                </dl>

                @if (agent.Tools.Count == 0)
                {
                    <p class="muted">No native tools. Legal: this may be an MCP-only agent.</p>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th>Tool</th><th>Parameter</th><th>Scope</th><th>Required</th><th>Shared</th></tr>
                        </thead>
                        <tbody>
                            @foreach (ToolDraft tool in agent.Tools)
                            {
                                @if (tool.Parameters.Count == 0)
                                {
                                    <tr>
                                        <td><code>@tool.Name</code></td>
                                        <td colspan="4" class="muted">no parameters</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach ((ToolParameterDraft parameter, int index) in tool.Parameters.Select((p, i) => (p, i)))
                                    {
                                        <tr>
                                            <td>@(index == 0 ? tool.Name : string.Empty)</td>
                                            <td><code>@parameter.Name</code></td>
                                            <td>@(parameter.Scope ?? "—")</td>
                                            <td>@(parameter.Required ? "yes" : "no")</td>
                                            <td>@(parameter.Shared ? "yes" : "—")</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }

    <p class="phase-note">
        An <code>agents.json</code> becomes a Draft, and a Draft becomes an <code>agents.json</code> again &mdash; the invariant everything else stands on.
    </p>

    <p><a href="">&larr; back</a></p>

</div>

@code {
    /// <summary>Maximum size accepted for an agents.json upload.</summary>
    /// <remarks>
    /// Generous by two orders of magnitude against any real configuration — the Examples domain,
    /// four agents with full prose and toolkits, is a few tens of kilobytes. The cap exists so a
    /// mistaken upload fails immediately instead of being read into the circuit's memory.
    /// </remarks>
    private const long MaxUploadBytes = 4 * 1024 * 1024;

    /// <summary>
    /// Renders bytes as a downloadable <c>data:</c> URI.
    /// </summary>
    /// <remarks>
    /// A plain anchor rather than JS interop or a download endpoint, and the reason is the same one
    /// that shapes the rest of Alembic: the Draft lives in the circuit, so no stateless endpoint
    /// can reach it, and a configuration is tens of kilobytes — small enough that the simplest
    /// mechanism with no moving parts is also the right one.
    /// </remarks>
    private static string DataUri(byte[] content) =>
        $"data:application/json;charset=utf-8;base64,{Convert.ToBase64String(content)}";

    private IReadOnlyList<string> notices = [];
    private string? error;
    private bool isReading;

    /// <summary>
    /// The root property only a saved interview carries.
    /// </summary>
    /// <remarks>
    /// <see cref="DomainDraft.CreatedAt"/> is non-nullable, so a serialized Draft always has it and
    /// an <c>agents.json</c> never does — the two shapes are told apart by a fact rather than by a
    /// file name, which the client is free to change and often has.
    /// </remarks>
    private const string SaveFileMarker = "CreatedAt";

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        isReading = true;
        error = null;
        notices = [];

        try
        {
            IBrowserFile file = e.File;

            // Buffered because it is read twice: once to decide what it is, once to parse it. A
            // configuration is tens of kilobytes and the cap above is two orders of magnitude above
            // any real one, so this costs nothing worth avoiding.
            using MemoryStream buffer = new MemoryStream();
            await using (Stream stream = file.OpenReadStream(MaxUploadBytes))
                await stream.CopyToAsync(buffer);

            buffer.Position = 0;

            if (IsSaveFile(buffer))
            {
                buffer.Position = 0;
                await ResumeAsync(buffer, file.Name);
                return;
            }

            buffer.Position = 0;

            DraftImportResult result = await DraftImportService.ImportAsync(buffer, file.Name);

            notices = result.Notices;
            error = result.Error;
            DraftStateService.Set(result.Draft);
        }
        catch (IOException ex)
        {
            // Thrown by OpenReadStream when the upload exceeds MaxUploadBytes.
            error = ex.Message;
        }
        finally
        {
            isReading = false;
        }
    }

    /// <summary>
    /// Restores a Draft saved in an earlier sitting.
    /// </summary>
    /// <remarks>
    /// An interview over a real domain does not fit in one sitting and Alembic has no database, so
    /// the save file is the whole of its memory. It carries what a configuration cannot: provenance,
    /// the C# facts <c>agents.json</c> does not express, half-answered elements, and the baseline the
    /// migration report diffs against — which is why the report still tells the truth on the second
    /// day.
    /// </remarks>
    private async Task ResumeAsync(Stream saveFile, string fileName)
    {
        DomainDraft? draft = await DraftSerializationService.DeserializeAsync(saveFile);

        if (draft is null)
        {
            error = $"{fileName} looks like a saved interview but could not be read.";
            return;
        }

        DraftStateService.Set(draft);

        List<string> read =
        [
            $"Resumed a saved interview: {draft.Intents.Count} intents and {draft.Agents.Count} agents, "
            + $"carrying {draft.Agents.Sum(a => a.Tools.Count)} tools.",

            draft.Baseline is null
                ? "It was started from nothing, so the migration report will say everything is new."
                : $"It carries the domain as uploaded from {draft.Baseline.ImportedFrom}, so the migration report still diffs against it."
        ];

        int authored = draft.Agents.Count(a => a.Origin == Provenance.Authored);

        if (authored > 0)
            read.Add($"{authored} of the agents were authored here rather than imported.");

        notices = read;
    }

    /// <summary>
    /// Decides which of the two shapes arrived, by reading the file.
    /// </summary>
    private static bool IsSaveFile(Stream json)
    {
        try
        {
            using JsonDocument document = JsonDocument.Parse(json);

            // Case-insensitively, because the reader that follows is case-insensitive too and this
            // file is documented as hand-editable between sittings.
            return document.RootElement.ValueKind == JsonValueKind.Object
                   && document.RootElement.EnumerateObject().Any(p =>
                       string.Equals(p.Name, SaveFileMarker, StringComparison.OrdinalIgnoreCase));
        }
        catch (JsonException)
        {
            // Not JSON at all. Left to the importer, whose error message is about a configuration
            // that could not be read — which is what the client was almost certainly uploading.
            return false;
        }
    }
}
