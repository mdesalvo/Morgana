{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",

  "Alembic": {
    "Work": {
      "AutosaveSeconds": 30,
      "TurnSeconds": 600
    }
  },

  "Morgana": {
    "OpenTelemetry": {
      "Enabled": false
    },
    "LLM": {
      "Tiers": {
        "Economy": {
          "Provider": "_FUNCTIONAL_OVERRIDE_",
          "Connection": {
            "ApiKey": "_SECURE_OVERRIDE_",
            "Endpoint": "_SECURE_OVERRIDE_",
            "MaxRetries": 2,
            "TimeoutSeconds": 180
          },
          "Options": {
            "ModelId": "_FUNCTIONAL_OVERRIDE_",
            "MaxOutputTokens": 16384
          },
          "MagicDust": {
            "InputTokensPerDustUnit": 0,
            "OutputTokensPerDustUnit": 0
          }
        },
        "Efficiency": {
          "Provider": "_FUNCTIONAL_OVERRIDE_",
          "Connection": {
            "ApiKey": "_SECURE_OVERRIDE_",
            "Endpoint": "_SECURE_OVERRIDE_",
            "MaxRetries": 2,
            "TimeoutSeconds": 180
          },
          "Options": {
            "ModelId": "_FUNCTIONAL_OVERRIDE_",
            "MaxOutputTokens": 16384
          },
          "MagicDust": {
            "InputTokensPerDustUnit": 0,
            "OutputTokensPerDustUnit": 0
          }
        },
        "Performance": {
          "Provider": "_FUNCTIONAL_OVERRIDE_",
          "Connection": {
            "ApiKey": "_SECURE_OVERRIDE_",
            "Endpoint": "_SECURE_OVERRIDE_",
            "MaxRetries": 2,
            "TimeoutSeconds": 180
          },
          "Options": {
            "ModelId": "_FUNCTIONAL_OVERRIDE_",
            "MaxOutputTokens": 16384
          },
          "MagicDust": {
            "InputTokensPerDustUnit": 0,
            "OutputTokensPerDustUnit": 0
          }
        }
      }
    }
  }
}