{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",

  "//": [
    "The section is 'Morgana:LLM' and not 'Alembic:LLM' because MorganaLLM reads that path:",
    "Alembic consumes the framework's own provider abstraction rather than reimplementing it.",
    "Only the Performance tier is declared — Alembic writes dispositive prose and runs once per",
    "onboarding, so it never uses the Efficiency die. A single-tier deployment therefore does",
    "not serve Alembic until a Performance entry exists (no cross-tier fallback, by design).",
    "MagicDust pricing is declared because TierDefinition requires it, not because Alembic",
    "meters anything: there is no conversation here to charge a budget to."
  ],
  "Morgana": {
    "LLM": {
      "Provider": "_FUNCTIONAL_OVERRIDE_",
      "Anthropic": {
        "ApiKey": "_SECURE_OVERRIDE_",
        "Tiers": {
          "Performance": {
            "Options": {
              "ModelId": "_FUNCTIONAL_OVERRIDE_",
              "MaxOutputTokens": 8192
            },
            "MagicDust": {
              "InputTokensPerDustUnit": 5333,
              "OutputTokensPerDustUnit": 1067,
              "CachedInputWeight": 0.10,
              "CacheCreationWeight": 2.00
            }
          }
        }
      },
      "AzureOpenAI": {
        "ApiKey": "_SECURE_OVERRIDE_",
        "Endpoint": "_SECURE_OVERRIDE_",
        "Tiers": {
          "Performance": {
            "Options": {
              "ModelId": "_FUNCTIONAL_OVERRIDE_",
              "MaxOutputTokens": 8192
            },
            "MagicDust": {
              "InputTokensPerDustUnit": 3072,
              "OutputTokensPerDustUnit": 768,
              "CachedInputWeight": 0.50,
              "CacheCreationWeight": 1.00
            }
          }
        }
      },
      "OpenAI": {
        "ApiKey": "_SECURE_OVERRIDE_",
        "Tiers": {
          "Performance": {
            "Options": {
              "ModelId": "_FUNCTIONAL_OVERRIDE_",
              "MaxOutputTokens": 8192
            },
            "MagicDust": {
              "InputTokensPerDustUnit": 3072,
              "OutputTokensPerDustUnit": 768,
              "CachedInputWeight": 0.50,
              "CacheCreationWeight": 1.00
            }
          }
        }
      },
      "Ollama": {
        "Endpoint": "_SECURE_OVERRIDE_",
        "Tiers": {
          "Performance": {
            "Options": {
              "ModelId": "_FUNCTIONAL_OVERRIDE_"
            },
            "MagicDust": {
              "InputTokensPerDustUnit": 0,
              "OutputTokensPerDustUnit": 0,
              "CachedInputWeight": 1.00,
              "CacheCreationWeight": 1.00
            }
          }
        }
      }
    }
  }
}
