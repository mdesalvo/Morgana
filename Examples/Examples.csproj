<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The sources of the GardeningMCP server sit inside this directory and must not be compiled into the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);GardeningMCP\**</DefaultItemExcludes>

    <Title>Examples</Title>
    <PackageId>Examples</PackageId>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta2</VersionSuffix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <Authors>Marco De Salvo</Authors>
    <Company>Marco De Salvo</Company>
    <Copyright>Marco De Salvo</Copyright>
    <Product>Morgana</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mdesalvo/Morgana</PackageProjectUrl>

    <Description>
    Examples is a showcase demostrating modeling of domain agents with Morgana.AI framework.
    It models one single organization, the fictional nursery "The Greenhouse &amp; Nursery", through 4 agents
    serving the "inventory", "billing", "contract" and "gardening" intents: the greenhouse ledger, the accounts
    desk, the Green Care Plan and the head gardener's almanac. All four read one SQLite system of record
    (Data/Examples.sqlite): the first three through their own tools, the gardener through the GardeningMCP
    server beside this plugin. Each agent encodes its prompt defining target, personality and the
    available tools (see agents.json).
    </Description>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="agents.json" />
    <EmbeddedResource Include="Data\Examples.sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morgana\Morgana.AI\Morgana.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GardeningMCP server reads the database through the plugin's own helpers. -->
    <InternalsVisibleTo Include="GardeningMCP" />
  </ItemGroup>

  <!-- Copy plugin to Morgana.Web plugins directory after build -->
  <Target Name="CopyPluginToHost" AfterTargets="Build">
    <PropertyGroup>
      <PluginDestDir>$(MSBuildThisFileDirectory)..\Morgana\Morgana.Web\$(OutputPath)plugins\</PluginDestDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Only copy the plugin DLL itself, not all dependencies -->
      <PluginFiles Include="$(TargetPath)" />
    </ItemGroup>
    <Message Text="Copying plugin to: $(PluginDestDir)" Importance="high" />
    <MakeDir Directories="$(PluginDestDir)" Condition="!Exists('$(PluginDestDir)')" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDestDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
